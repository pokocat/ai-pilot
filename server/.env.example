# —— 军师后端环境变量（示例，复制为 .env） ——
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/junshi?schema=public"
PORT=4000

# —— 运营后台鉴权（保护 /api/admin/*）——
# 主密钥 ADMIN_TOKEN：① 首次进入用它初始化管理员账号+密码；② 之后保留为应急/找回通道（登录页「用密钥应急登录」）。
# 日常登录用账号密码（账户表 admin_account，密码 scrypt 哈希）。请求带 x-admin-token / Authorization: Bearer。
# 留空则仅放行后台账户会话 / role='admin' 账号；生产务必设为高强度随机串。请求时读取，可不重启即时轮换。
ADMIN_TOKEN=junshi-admin-dev

# —— 业务敏感字段加密（Agent/Dify/技能库/告警/图片供应商等存库前 AES-256-GCM 加密）——
# 留空：不加密，按历史明文存取（演示/本地零配置仍可跑）。
# 配置高强度随机串后：① 上述新写入密钥自动加密；② 对存量明文跑一次 `npm run secrets:encrypt` 回填。
# AiSetting/AiModel 的对话、Embedding、Rerank 凭证已按产品决策改为明文，不受此变量控制。
# ⚠️ 该密钥一旦用于加密就不可丢失/更改，否则已加密字段无法解密（需重填）。生产建议接 KMS/密管。
APP_ENCRYPTION_KEY=

# —— 用户登录态 JWT（HS256，services/userToken.ts）——
# 留空：登录态沿用历史口径 token=userId（演示/测试免改）。
# 配置后：新登录签发 JWT（带 sub/iat/exp）；历史 userId token 默认仍放行以平滑过渡。
APP_JWT_SECRET=
APP_JWT_TTL_SEC=2592000        # JWT 有效期（秒），默认 30 天
# 置 true 强制只认 JWT（历史 userId token 立即失效，需重新登录）。生产稳定后再开。
APP_JWT_REQUIRED=false

# —— 测试期注册默认套餐 ——
# 留空：新用户按 sort 最小的体验版注册；填精确套餐名：新注册用户自动开通该套餐。
# 测试结束后清空并重启 API 即恢复体验版。存量用户用 npm run db:grant-test-plan 批量升级。
TEST_DEFAULT_PLAN_NAME=

# —— 缓存 / 共享状态（services/redis.ts，被 cache.ts 与全站限流复用）——
# 留空：进程内内存（演示/单实例）。配 redis:// 且 `npm i ioredis` 后切 Redis。
# 多实例必配：否则限流计数与缓存各实例各算各的，全局阈值会按实例数翻倍。
REDIS_URL=

# —— 入口层与过载保护（2026-07 压测；详见 docs/[OPUS5]LOADTEST_OPT_PLAN_2026-07-26.md）——
# 反代信任。留空 = 'loopback'：只信任本机 Nginx 传来的 X-Forwarded-For，这是当前部署形态的安全默认值。
# 不设对的后果：Fastify 的 req.ip 全部变成 127.0.0.1 → 全站限流共用一个桶 ≈ 5 RPS 天花板。
# 上 ALB / 多层反代：填回源网段（逗号分隔 CIDR）或跳数（如 2）。TRUST_PROXY=false 关闭。
TRUST_PROXY=
# 全站限流兜底（按「已登录用户 / 未登录 IP」分桶）。成本型路由另有 route-level 更严的限制。
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute
# 在途非流式请求上限，越过即快速 503（拥塞崩溃保护）。0 = 关闭。
# 口径：450 RPS 稳态在途约 18；越过悬崖后约 3000。200 落在两者之间。
MAX_IN_FLIGHT=200

# —— Prometheus 指标端点 GET /api/metrics（routes/metrics.ts）——
# 留空 = 端点整体关闭（返回 404）。填一个长随机串即开放，抓取方带 Authorization: Bearer <token>。
# 为什么必须用密钥而不是内网 IP 白名单：本部署是 Nginx 反代 + trustProxy，req.ip 取自
# X-Forwarded-For（可伪造），真实 TCP 对端又恒为 Nginx 的 127.0.0.1 —— 公网流量和本机 curl
# 在 IP 层根本无法区分。建议 Nginx 侧同时不把 /api/metrics 放出公网，采集端直连 127.0.0.1:4000。
METRICS_TOKEN=

# —— 飞书告警卡片展示（可选；不影响 Prometheus 采集）——
# 环境名显示在卡片副标题，避免生产/预发告警混淆。
MONITOR_ENV_LABEL=生产环境
# Grafana 的浏览器可访问根地址；配置后卡片底部出现「打开对应监控看板」按钮。留空则不显示按钮。
MONITOR_GRAFANA_URL=https://wxapi.aibuzz.cn/grafana
# 卡片时间展示时区；无效值会安全回退 UTC。
MONITOR_TIME_ZONE=Asia/Shanghai

# —— 上游模型的全局并发闸（services/llmGate.ts）——
# 压测实测：8/12 并发全成功；20 并发 42.4% 的 429；且 429 后是滚动时间窗惩罚（窗口内 12 并发也全挂）。
# 因此这里是「固定并发上限 + 对真实 429 做整窗冷却」，不去猜上游窗口配额的具体数值。
LLM_GATE_ENABLED=true
LLM_MAX_CONCURRENCY=8
LLM_BURST_CONCURRENCY=12
# 排队超过这个时长主动降级为 AI_BUSY(503)，让前端提示稍后重试而不是把用户挂死。
LLM_QUEUE_TIMEOUT_MS=15000
LLM_QUEUE_MAX=200
# 显式速率窗口：0 = 关闭。上游窗口配额本轮没测出来，等线上跑出真实 429 率再校准。
LLM_RATE_MAX_PER_MIN=0

# —— 压测可测性：让 mock 表现得像真实上游（**仅压测环境配，生产一律留空**）——
# 背景：mock 默认立即返回，而且在 gateway 里是被直接调用的、不经过上面这个并发闸（只有真
# provider 才过闸）。两者叠加导致压测里 LLM 队列深度、排队等待、闸门占用**恒为 0**，
# 于是闸门和端点池这两个新建的核心在压测中完全测不到。
# 配了 AI_MOCK_LATENCY_MS(>0) 后，mock 改为「占一个真实闸门槽位 + 模拟上游耗时」，
# 并发上限 / 排队 / 排队超时降级 / 429 整窗冷却全部可复现，且零 Token 成本。
AI_MOCK_LATENCY_MS=0
# 在基准耗时上叠加 [0, jitter) 随机抖动，避免所有请求整齐同步造成假的锯齿波形。
AI_MOCK_LATENCY_JITTER_MS=0
# 按该概率(0..1)注入 429，用于验证整窗冷却与窗口恢复后的爬坡。0 = 不注入。
AI_MOCK_429_RATE=0

# —— 辅助档：后台抽取切小模型（services/aiConfig.resolveAuxConfig）——
# 为什么：一条用户消息实际触发 3–4 次模型调用——主生成 + extractInsights（记忆学习）
# + extractProphecies（预言抽取）+ 首条消息的 summarizeSessionTitle。它们原来和主对话
# 共用同一个模型配置，等于**上游 8 个槽位里有 2–3 个被后台任务占着**，而这些任务既不需要
# 主模型的质量，也没人在等它的延迟。
#
# 只影响抽取类任务；**对话与成果生成永远走主配置，提示词一个字不改**。
# 留空 = 完全维持原状（默认不启用）。
AI_AUX_MODEL=
# 再填下面任意一个（指向独立账号/网关）→ 辅助抽取切到独立并发车道，主配额从此全留给用户可见的生成。
# 只换模型名不填这两个时，车道仍与主对话共用（同账号的配额本来就是共享的，分两个计数器等于自欺欺人）。
AI_AUX_BASE_URL=
AI_AUX_API_KEY=
# 留空则由 AI_AUX_BASE_URL 推断（有 baseUrl → openai 兼容协议；没有 → 沿用主 provider）。
AI_AUX_PROVIDER=
# 抽取应当快失败：拖长了既占车道又没人等结果。留空 = min(主档超时, 20s)。
AI_AUX_TIMEOUT_MS=
# 抽取要的是稳定可解析的结构，不是文采。留空 = 0。
AI_AUX_TEMPERATURE=
# 辅助车道的并发（留空 = 4，刻意低于主车道，后台任务不该和用户可见生成抢）。
LLM_AUX_MAX_CONCURRENCY=
LLM_AUX_QUEUE_TIMEOUT_MS=

# —— 内容审核（services/moderation.ts）——
MODERATION_ENABLED=true
# keyword：演示关键词表（默认）。http：调外部合规审核服务（需补 MODERATION_API_URL/KEY）。
MODERATION_PROVIDER=keyword
MODERATION_API_URL=
MODERATION_API_KEY=
MODERATION_TIMEOUT_MS=3000
# 审核服务不可达时：true=放行（默认，避免抖动阻断），false=拦截（强合规）。
MODERATION_FAIL_OPEN=true

# —— 微信小程序登录 + 本机号一键登录（server 模式小程序联调用）——
# AppID 可与 app/project.config.json 保持一致；AppSecret 只放服务端，不要下发到小程序。
# 本机号一键登录（getPhoneNumber）复用同一对 AppID/Secret，无需额外配置；
# 但小程序须为「企业/组织」主体并已开通「手机号快速验证」能力，个人主体只能走短信验证码。
WECHAT_MINI_APPID=wx810ebe6dfef8e75f
WECHAT_MINI_SECRET=
# 微信后台「消息推送」URL 验签 Token。后台 URL 填：https://你的域名/api/wechat/message
# 必须与微信后台填写的 Token 完全一致；仅服务端保存，不下发前端。
WECHAT_MESSAGE_TOKEN=
# 微信订阅消息模板（小程序「订阅消息」能力）。模板字段需与代码匹配：
# 复盘提醒：thing1=提醒事项、time2=提醒时间、thing3=备注；
# 报告生成：thing1=报告名称、phrase2=状态、time3=完成时间、thing4=备注；
# 支付到账：thing1=商品名称、phrase2=状态、time3=到账时间、thing4=备注（支付入账后自动发送）。
WECHAT_SUBSCRIBE_REVIEW_TEMPLATE_ID=
WECHAT_SUBSCRIBE_REPORT_TEMPLATE_ID=
WECHAT_SUBSCRIBE_PAYMENT_TEMPLATE_ID=
# 订阅消息跳转小程序版本：formal | trial | developer；生产默认 formal。
WECHAT_SUBSCRIBE_STATE=formal
# 服务端本地时间到该小时后，scheduler 才会发送当日复盘提醒。
REVIEW_REMINDER_HOUR=21

# —— 微信支付 v3（小程序 JSAPI 套餐购买，services/wechatPay.ts）——
# 全部配齐才启用真实支付（payConfigured()=true）：此时 /plans/:id/purchase 演示购买被禁用，
# 改走 /plans/:id/order 下单 + /pay/wechat/notify 回调入账；未配齐则继续用演示购买。
WECHAT_PAY_MCHID=
WECHAT_PAY_APIV3_KEY=          # APIv3 密钥（32 位）：回调资源 AEAD 解密用
WECHAT_PAY_CERT_SERIAL=        # 商户证书序列号
WECHAT_PAY_PRIVATE_KEY=        # 商户私钥 PEM（apiclient_key.pem 内容，换行可用字面 \n）
WECHAT_PAY_NOTIFY_URL=         # 支付结果回调地址（公网 https）
# 回调验签 fail-closed：优先自动下载平台证书；静态证书兜底必须同时配置匹配序列号。
WECHAT_PAY_PLATFORM_CERT=
WECHAT_PAY_PLATFORM_CERT_SERIAL=
# 微信支付公钥模式（PUB_KEY_ID_*）：ID 与 PEM 必须成对配置。
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY=
# 微信支付 API 基址（可选，默认 https://api.mch.weixin.qq.com）。本地联调可指向
# mock 微信支付服务器（npm run pay:mock，会打印整套可粘贴的 WECHAT_PAY_* 配置），
# 走完整「下单签名 → 加密回调验签解密 → 幂等入账 → 查单补账」真实代码路径。生产留空。
WECHAT_PAY_BASE=

# —— 微信支付 V2 委托代扣（自动续费，services/wechatPapay.ts）——
# 与上面的 v3 单次支付并存：只有下列配置齐全、且套餐后台开启并填写模板 ID，用户侧才显示「自动续费」。
# APIv2 密钥必须 32 位；权限/模板未开通时保持留空，单次购买不受影响。
WECHAT_PAY_V2_KEY=
WECHAT_PAPAY_PAY_NOTIFY_URL=       # 如 https://wxapi.aibuzz.cn/api/pay/wechat/v2/notify
WECHAT_PAPAY_CONTRACT_NOTIFY_URL=  # 如 https://wxapi.aibuzz.cn/api/pay/wechat/contract/notify
# 可选，默认 https://api.mch.weixin.qq.com；本地 mock/联调才覆盖。
WECHAT_PAPAY_BASE=

# —— 测试期模拟支付成功（PAY_MOCK_SUCCESS，services/wechatPay.ts payMockSuccessEnabled）——
# 目的：**还没有微信支付商户凭据时，也把真实支付管线整条跑通/测到**。开启后 /plans/:id/order 与
# /skus/:key/order 照常建真实 PaymentOrder（条款快照 / 金额 / 归因 / 下单频控 / 关同类旧单全走），
# 只是不调微信 JSAPI；端上拿到 mock:true 就跳过 wx.requestPayment，改调 POST /pay/mock/pay
# 仅 test/development 可用；production 配 true 会在启动期直接拒绝启动。
# （普通用户鉴权 + 校验订单归属），由**真实的** markPaidAndApply 幂等发放权益并发到账订阅消息。
# ⚠️ 开启即等于**任何登录用户都可以自助领取任意付费套餐 / SKU**（下单→点一下→到账），仅测试期使用。
# ⚠️ 配齐上面 WECHAT_PAY_* 六项后本开关**自动失效**（payConfigured() 为真时恒 false），
#    无需改代码、也不必记得来删这一行——这就是「将来零改动替换」的机制。
# 这些单在库里带 provider='mock' + snapshotJson.mock=true + transactionId 以 mock 开头：
# 已从营收金额统计（运营端「期内实收」与 junshi_pay_amount_cny_total）里排除，
# 但在运营端订单列表显式标「mock」；对账 sweep / 查单 / 微信关单 / 微信退款一律跳过，
# 运营退款仍会照常回收权益。留空/删除即关闭（默认关）。
# PAY_MOCK_SUCCESS=true

# —— 隐藏套餐白名单（TEST_PLAN_PHONES，routes/plans.ts canSeeHiddenPlans）——
# 逗号分隔手机号。名单内账号才能在 /plans 列表看到、才能购买 hidden=true 的套餐
# （当前唯一隐藏档：「支付链路测试」¥0.01，生产真实支付全链路验证专用）。
# 非白名单请求对隐藏档一律 404。留空 = 隐藏档对所有人不可见（默认，安全）。
# TEST_PLAN_PHONES=13800000000

# —— 短信验证码登录 ——
# provider=console：开发/演示，不发真短信，验证码打日志并随响应回传（前端自动回填）。
#          aliyun ：阿里云短信，需补全下方 ALIYUN_SMS_*（模板变量名须为 code）。
SMS_PROVIDER=console
# 生产置 true：/auth/login 强制校验验证码（默认 false 以兼容演示/测试免码登录）。
SMS_REQUIRE_CODE=false
# 强制把验证码随响应返回（默认仅 console+非生产时返回；生产+aliyun 切勿开启）。
SMS_RETURN_CODE=false
SMS_CODE_TTL_SEC=300          # 验证码有效期（秒）
SMS_RESEND_COOLDOWN_SEC=60    # 同号两次发送最小间隔（秒）
SMS_MAX_PER_HOUR=5            # 同号每小时发送上限
SMS_MAX_ATTEMPTS=5           # 同一验证码最多校验次数
# 阿里云短信（SMS_PROVIDER=aliyun 时必填）
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=SMS_508120103
ALIYUN_SMS_REGION=cn-hangzhou

# ★ 推荐：大模型在「运营后台 → 模型」里可视化配置并随时切换（存数据库，即时生效）。
#   默认 Agnes 2.0 Flash（apihub.agnes-ai.com/v1，OpenAI 兼容）；填入 Key 即切真实模型。
#   下面这些 env 仅作「数据库无配置/不可达」时的兜底。
#
# AI 提供方（兜底）：
#   mock   —— 模板产出，零配置可离线
#   claude —— Anthropic 官方
#   openai —— OpenAI 通用协议（兼容 Agnes / DeepSeek / Moonshot(Kimi) / 通义千问 等）
# 注：当 key 仍是占位/假值（含 fake、replace、xxxx 等）时，自动降级为 mock。
AI_PROVIDER=openai

# —— Claude（Anthropic）——
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# —— OpenAI 通用协议 ——
# 先 fake 一个 token；换真实 key 时只改这一行即可。
OPENAI_API_KEY=sk-fake-please-replace-0000000000000000000000000000
# 网关地址（务必带 /v1）：
#   OpenAI   https://api.openai.com/v1
#   DeepSeek https://api.deepseek.com/v1
#   Moonshot https://api.moonshot.cn/v1
#   通义千问  https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# 模型名（按所选网关填）：gpt-4o-mini / deepseek-chat / moonshot-v1-8k / qwen-plus ...
OPENAI_MODEL=gpt-4o-mini
# 普通对话 / 流式首包与相邻数据块的空闲上限。结构化成果会自动至少保留 120 秒预算。
OPENAI_TIMEOUT_MS=20000

# —— 知识库 / 语义记忆 的嵌入模型 ——
# 留空 = 用本地确定性嵌入（零依赖、离线，EMBED_DIM=256）；
# 填模型名 + 上面 openai 兼容真实 key，则走 /embeddings 真实向量（生产建议配合 pgvector）。
# 例：text-embedding-3-small（OpenAI）/ text-embedding-v3（通义）/ embedding-2（智谱）...
EMBEDDING_MODEL=

# 知识/记忆向量近邻检索：默认 false 走内存余弦（零依赖）。
# 置 true 前需先执行 `npm run db:pgvector`（建 vector 列 + HNSW 索引），否则检索会回退内存。
PGVECTOR_ENABLED=false

MODERATION_ENABLED=true

# —— 海报成品图（canvas_design 产物型技能）——
# **本功能没有任何环境变量**（2026-07-29 删掉了 CANVAS_DESIGN_ENABLED / _ENGINE /
# _MAX_CONCURRENCY / _TIMEOUT_MS 四个，理由见 server/src/env.ts 同名段落）。
# 开关 / 单价 / 日限额 / 渲染超时 / 模板启停 / 图片供应商，全在后台「创作任务」页改，
# 单一真源 = FeatureFlag 行 `creative-poster`，约 1 分钟内生效、不用重启。
# 放量动作 = 运营在后台打开开关（**行缺失视为关**，所以先发代码天然不会放量）。
# 上线顺序：发代码 → db push 建两张表 → 灌提示词 → 后台打开开关。
#
