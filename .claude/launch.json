{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "h5-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "app/scripts/serve-h5.mjs"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "roadshow-slides",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8927",
        "--directory",
        "docs/roadshow"
      ],
      "port": 8927
    },
    {
      "name": "admin-preprod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "admin",
        "run",
        "dev:preprod"
      ],
      "port": 5174
    },
    {
      "name": "admin-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "admin",
        "run",
        "dev"
      ],
      "port": 5174
    },
    {
      "name": "server-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "server",
        "run",
        "dev"
      ],
      "port": 4000
    }
  ]
}
