<view class="legal {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px"><view class="legal-header"><view class="legal-safe"></view><view class="legal-headrow"><view class="legal-back" bindtap="back"><native-icon name="back" tone="ink" size="24"></native-icon></view><text class="legal-title serif">{{title}}</text><view class="legal-spacer"></view></view></view><scroll-view scroll-y class="legal-scroll"><view class="legal-body"><text class="legal-updated">更新日期：{{updated}}</text><text class="legal-intro">{{intro}}</text><view wx:for="{{sections}}" wx:key="title" class="legal-section"><text class="legal-section-title">{{item.title}}</text><text wx:for="{{item.paragraphs}}" wx:key="index" class="legal-paragraph">{{item}}</text></view><text class="legal-foot">本文本为当前版本，具体以正式公示为准。</text></view></scroll-view></view>
