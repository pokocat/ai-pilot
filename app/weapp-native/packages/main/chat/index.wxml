<import src="/chat-core/message-list.wxml"></import>
<import src="/chat-core/composer.wxml"></import>

<view class="chat-page {{themeClass}} {{viewportClass}}" style="--native-nav-inset:{{navInset}}px;--native-menu-top:{{navTop}}px;--native-menu-height:{{navRowHeight}}px;--native-menu-right:{{navRightInset}}px;--keyboard-height:{{keyboardHeight}}px;--composer-height:{{composerHeight}}px;--window-width:{{windowWidth}}px;--window-height:{{windowHeight}}px">
  <!-- 桌面 ≥960 的 72px 左导航。官方 custom-tab-bar 只在 tabBar 页渲染，二级页天生没有导航；
       这条是我们自己的组件，所以从 tab 进到对话页时左边那条不会突然消失。
       selected 传 0：对话是从问策 tab 落进来的。 -->
  <nav-rail class="nav-rail" show="{{isExpanded}}" selected="{{0}}"></nav-rail>
  <view class="chat-header">
    <view class="chat-safe"></view>
    <view class="chat-headrow">
      <view class="back-hit" bindtap="back"><native-icon name="back" tone="ink" size="24"></native-icon></view>
      <view class="chat-id"><text class="chat-title serif">{{title}}</text><text wx:if="{{alias}}" class="chat-alias">{{alias}}</text><text wx:if="{{quotaRatio}}" class="chat-ratio">额度 {{quotaRatio}} 倍</text></view>
      <view class="chat-head-spacer" bindtap="openChatMenu"><native-icon name="more" tone="ink" size="22"></native-icon></view>
    </view>
  </view>

  <scroll-view scroll-y enhanced show-scrollbar="false" scroll-into-view="{{bottomAnchor}}" class="chat-scroll">
    <template is="chat-message-list" data="{{messages, title, advisorAvatar, colorKey, accepting, reportBusy, posterEnabled, posterPrice, posterActionAt, askAnsweredCount, askTotal, askReady, askRemaining, askComposerOpen, askComposerMessage, askComposerQuestion, showThinking, errorText, canRetryLast, chipsSpent, chapterPending, chapterPendingLabel, historyHasMore, historyLoading}}"></template>
  </scroll-view>

  <template wx:if="{{!showLogin}}" is="chat-composer" data="{{askComposerOpen, colorKey, pasteRefs, pastePendings, pasteDupId, pasteHint, regularRefs, uploading, composerOdd, composerSeed, busy, showCount, inputCount, canStop, canSend, pastePreview, showPicker, pickerLoading, pickGroups, refs}}"></template>

  <login-sheet open="{{showLogin}}" reason="{{loginReason}}" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
