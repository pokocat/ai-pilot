<view class="vd vd-work {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="vd-head">
    <view class="vd-safe"></view>
    <view class="vd-headrow">
      <view class="vd-back" bindtap="back"><native-icon name="back" tone="ink" size="22"></native-icon></view>
      <text class="vd-title">成片</text>
      <text class="vd-headact"> </text>
    </view>
  </view>

  <scroll-view class="vd-scroll" scroll-y enable-flex>
    <view class="wd-body">
      <view wx:if="{{loading}}" class="vd-empty"><text class="s">正在打开…</text></view>

      <!-- 没读到就说没读到。以前这里没有分支，读失败会掉进下面的成功版式，
           页面照样写着「生成完成 · 你的故事，已经成片」——把一次网络失败说成了出片成功。
           同 home 页那条「读失败不能说成你还没有」。 -->
      <view wx:elif="{{loadFailed}}" class="vd-empty wd-failed">
        <text class="s">没能打开这条片子</text>
        <text class="wd-failed-s">{{loadError || '网络没通，或者这条片子不在当前账号里。'}}</text>
        <view wx:if="{{canRetry}}" class="wd-failed-act" bindtap="retryLoad">重试</view>
      </view>

      <block wx:else>
        <!-- 「读到了」不等于「出好了」。这块以前对任何取回来的作品都写「生成完成」，
             深链打开一条 status=generating 的作品，页面照样恭喜你已经成片。 -->
        <view class="wd-ready" wx:if="{{done}}">
          <view class="wdr-icon"><native-icon name="check" tone="white" size="18"></native-icon></view>
          <view><text class="wdr-kicker">生成完成</text><text class="wdr-title">你的故事，已经成片</text></view>
        </view>
        <view class="wd-ready wd-ready-wip" wx:else>
          <view class="wdr-icon wdr-icon-wip"><native-icon name="clock" tone="white" size="18"></native-icon></view>
          <view><text class="wdr-kicker">还在生成</text><text class="wdr-title">这条片子还没出好</text></view>
        </view>
        <!-- 成片固定用真实 9:16 容器；外层控制宽度，内层 padding 比例不能再被固定高度覆盖。 -->
        <view class="wd-player-wrap">
          <view class="vd-portrait wd-player">
            <video
              wx:if="{{work.videoUrl}}"
              class="inner"
              src="{{work.videoUrl}}"
              object-fit="contain"
              show-fullscreen-btn="{{true}}"
              poster="{{work.thumbnailUrl}}"
            ></video>
            <!-- 成片地址可能为空：契约里 videoUrl 本就是可选（shared/contracts.d.ts 的
                 ClipWorkDetail），下载接口对同一状态给的是 CLIP_WORK_NOT_READY「成片还没有
                 准备好」。观看这条路以前只铺一块底纹，等于让用户对着「已经成片」和一个黑框
                 自己猜——和首页「读失败不能说成你还没有」是同一类问题，这里也要说出来。 -->
            <!-- 文案要跟着状态走。这块在两种情形下都会出现，说法不能一样：
                   done 但没地址 —— 片子已经出好了，是这会儿取不到播放地址；
                                    再说「还没有准备好」就和上面的「生成完成」自相矛盾。
                   还在生成      —— 那才是真的还没准备好。
                 不在这里对积分下结论：详情接口只透传作品、不做结算
                 （server/src/routes/video.ts），结算发生在任务轮询那条路径上。 -->
            <view wx:else class="inner vd-grain wd-pending">
              <text class="wd-pending-t">{{done ? '这会儿放不出来' : '还没出好'}}</text>
              <text class="wd-pending-s">{{done ? '片子已经出好了，只是这会儿取不到播放地址。过一会儿再回来看看。' : '这条片子还在生成，过一会儿再回来看看。'}}</text>
            </view>
            <view wx:if="{{work.aiWatermark}}" class="vd-ai-badge wd-badge">AI 生成</view>
          </view>
        </view>

        <text class="wd-title">{{work.title}}</text>
        <text wx:if="{{done}}" class="wd-meta">{{durationText}} · 竖屏 · 字幕已生成 · 出镜 {{work.avatarSec}} 秒</text>
        <text wx:else class="wd-meta">{{durationText}} · 竖屏 · 出镜 {{work.avatarSec}} 秒</text>
        <!-- 只有完成态才敢说「已扣」：没出好的单子扣费可能还没结算。 -->
        <text wx:if="{{done && work.credits}}" class="wd-credits">已扣 {{work.credits}} 积分</text>

        <!-- 封面：单独给出来，并说清它到底管什么。
             不这么做的话，用户设了封面、发到平台却看不到，只会以为封面没生效。 -->
        <view wx:if="{{work.thumbnailUrl}}" class="wd-cover vd-card">
          <image class="wd-cover-img" src="{{work.thumbnailUrl}}" mode="aspectFill"></image>
          <view class="wd-cover-copy">
            <text class="wd-cover-title">这条片子的封面</text>
            <text class="wd-cover-sub">它是视频的第一帧，也是平台缩略图，不占正片时长。有的平台不会自动取，存下来就能在发布时手动设。</text>
            <view class="wd-cover-act" catchtap="saveCover">{{savingCover ? '保存中…' : '保存封面图'}}</view>
          </view>
        </view>

        <!-- 代发。整块只在完成态出现：没出好的片子既存不下来也发不出去，
             摆在那里点下去只会拿到「成片还没有准备好」。 -->
        <view class="wd-section" wx:if="{{done}}">
          <text class="wd-sec-kicker">下一步</text>
          <!-- 标题跟着能力走：代发没接通时不许承诺「直接发布」（上游恒 503，见 index.js 的 PUBLISH_READY）。 -->
          <text class="wd-sec-title">{{publishReady ? '保存，或者直接发布' : '先保存下来，自己发'}}</text>
          <text wx:if="{{!publishReady}}" class="wd-sec-note">一键代发到下面这些平台还在接入，暂时点不了</text>
          <view class="wd-platforms">
            <view
              wx:for="{{platforms}}"
              wx:key="key"
              class="wd-platform {{publishing === item.key ? 'busy' : ''}} {{publishReady ? '' : 'off'}}"
              data-key="{{item.key}}"
              bindtap="publish"
            >{{publishing === item.key ? '提交中…' : item.label}}</view>
          </view>
        </view>

        <!-- 保存同样只在完成态出现。方法里那道 done 防线是兜底，
             但一个点下去必然失败的主按钮本身就不该摆在这儿。 -->
        <view wx:if="{{done}}" class="vd-btn wd-act" bindtap="saveToAlbum">{{saving ? '保存中 ' + saveProgress + '%' : '保存到相册'}}</view>

        <view class="wd-again vd-card" bindtap="again">
          <view class="wa-body">
            <text class="wa-t">再出一条</text>
            <text class="wa-s">换个店名或一两句话，1 分钟复制一条新的</text>
          </view>
          <native-icon class="wa-arrow" name="arrow" tone="neutral" size="15"></native-icon>
        </view>
      </block>

      <view class="vd-footer-space"></view>
    </view>
  </scroll-view>

  <login-sheet open="{{showLogin}}" reason="execute" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
