<view class="vd vd-script {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="vd-head">
    <view class="vd-safe"></view>
    <view class="vd-headrow">
      <view class="vd-back" bindtap="back"><native-icon name="back" tone="ink" size="22"></native-icon></view>
      <text class="vd-title">{{project.templateName || '改文案'}}</text>
      <text class="vd-headact" bindtap="saveDraft">存草稿</text>
    </view>

    <view class="vd-steps">
      <view class="vd-step on"><view class="dot">1</view><text>改文案</text></view>
      <view class="vd-step-line"></view>
      <view class="vd-step"><view class="dot">2</view><text>配画面</text></view>
      <view class="vd-step-line"></view>
      <view class="vd-step"><view class="dot">3</view><text>出片</text></view>
    </view>
  </view>

  <scroll-view class="vd-scroll" scroll-y enable-flex>
    <view class="script-body">
      <view class="script-tools">
        <view class="st-btn {{rewriting ? 'busy' : ''}}" bindtap="rewriteAll">{{rewriting ? '改写中…' : '整稿优化'}}</view>
        <view class="st-btn ghost" bindtap="restoreTemplate">恢复模板</view>
        <text class="st-count">{{rows.length}} 段</text>
      </view>

      <!-- 整段编辑：拿着写好的稿子过来时，一句句抠是折磨；这里可以整篇粘贴。 -->
      <block wx:if="{{editMode === 'bulk'}}">
        <view class="sb-head">
          <view><text class="sb-kicker">整段编辑</text><text class="sb-title">一行一句</text></view>
          <text class="sb-help" bindtap="exitBulk">返回逐句</text>
        </view>

        <textarea
          class="bulk-input"
          value="{{bulkText}}"
          bindinput="inputBulk"
          placeholder="把整篇口播文案粘进来，一行一句。空行会自动忽略。"
          maxlength="-1"
          auto-height
          show-confirm-bar="{{false}}"
          adjust-position="{{true}}"
        />

        <view class="bulk-helper">
          <view class="bh-btn" bindtap="autoSplit"><native-icon name="layers" tone="accent" color-key="{{colorKey}}" size="14"></native-icon><text>自动分段</text></view>
          <text class="bh-tip">整篇粘进来后点它，按句子自动分好段</text>
        </view>

        <view wx:if="{{bulkStats}}" class="bulk-stats {{bulkStats.droppedAssets ? 'warn' : ''}}">
          <text class="bs-line">原来 {{bulkStats.before}} 段，改后 {{bulkStats.after}} 段</text>
          <text wx:if="{{bulkStats.droppedAssets}}" class="bs-warn">有 {{bulkStats.droppedAssets}} 句已配的画面会失效，需要重新配</text>
          <text wx:elif="{{bulkStats.changed}}" class="bs-line dim">已配的画面不受影响</text>
          <text wx:else class="bs-line dim">还没有改动</text>
        </view>

        <view class="bulk-acts">
          <view class="vd-btn ghost" bindtap="exitBulk">取消</view>
          <view class="vd-btn {{bulkSaving ? 'disabled' : ''}}" style="flex:1" bindtap="applyBulk">用这份文案</view>
        </view>
      </block>

      <block wx:else>
      <view class="sb-head">
        <view><text class="sb-kicker">当前成稿</text><text class="sb-title">口播文案</text></view>
        <view class="sb-actions">
          <text class="sb-help">点任一段即可细改</text>
          <text class="sb-bulk" bindtap="enterBulk">整段编辑</text>
        </view>
      </view>

      <view wx:if="{{loading}}" class="vd-empty"><text class="s">正在打开…</text></view>

      <view wx:else class="lines">
        <block wx:for="{{rows}}" wx:key="no">
          <!-- 只读态：整段连读 -->
          <view wx:if="{{!item.editing}}" class="line" data-no="{{item.no}}" bindtap="startEdit">
            <text class="line-text">{{item.text}}</text>
          </view>

          <!-- 编辑态：展开动作区 -->
          <view wx:else class="line-edit vd-card">
            <view class="le-head">
              <text class="le-title">第 {{item.no}} 段 · 正在改</text>
              <text class="le-sec">约 {{editingSeconds}} 秒</text>
            </view>
            <textarea
              class="le-input"
              value="{{editingText}}"
              bindinput="inputText"
              auto-height
              maxlength="-1"
              adjust-position="{{true}}"
              placeholder="写这一段要说的话"
            />
            <view class="le-acts">
              <view class="le-act {{previewing ? 'busy' : ''}}" bindtap="previewVoice">{{previewing ? '合成中…' : '试听这段'}}</view>
              <view class="le-act {{rewriting ? 'busy' : ''}}" bindtap="rewriteOne">{{rewriting ? '改写中…' : 'AI 改这段'}}</view>
              <view class="le-act main" bindtap="commitEdit">改好了</view>
            </view>
          </view>
        </block>
      </view>
      </block>

      <view class="vd-footer-space"></view>
    </view>
  </scroll-view>

  <!-- 整段模式自带提交动作，底部主按钮与 AI 悬浮球都要让位，否则一屏出现三个主按钮 -->
  <view wx:if="{{editMode !== 'bulk'}}" class="vd-footer">
    <view class="foot-stat">
      <text class="fs-num">预计 {{totalText}}</text>
      <text class="fs-sub">读完全文的时长</text>
    </view>
    <view class="vd-btn" style="flex:1" bindtap="next">下一步 · 配画面</view>
  </view>

  <view wx:if="{{!aiOpen && editMode !== 'bulk'}}" class="ai-fab" bindtap="openAi">
    <native-icon name="pen" tone="white" size="22"></native-icon>
    <text>AI 改稿</text>
    <view wx:if="{{chatMessages.length}}" class="ai-fab-dot"></view>
  </view>

  <view wx:if="{{aiOpen}}" class="ai-mask" catchtap="closeAi">
    <view class="ai-sheet" catchtap="swallow">
      <view class="ai-handle"></view>
      <view class="aw-head">
        <view class="aw-identity">
          <view class="aw-orb"><native-icon name="pen" tone="white" size="19"></native-icon></view>
          <view>
            <text class="aw-kicker">AI 文案搭档</text>
            <text class="aw-title">聊着改，成稿会留在原处</text>
          </view>
        </view>
        <view class="aw-close" bindtap="closeAi"><native-icon name="close" tone="white" size="18"></native-icon></view>
      </view>
      <text class="aw-intro">说你想改哪里。它会结合模板和当前稿追问，确认后直接更新文案。</text>

      <scroll-view class="aw-thread" scroll-y scroll-top="{{chatScrollTop}}">
        <view class="aw-thread-inner">
          <view wx:if="{{!chatMessages.length}}" class="aw-message assistant">
            <text>这条视频最想让谁看到？你希望他看完记住什么？</text>
          </view>
          <view wx:for="{{chatMessages}}" wx:key="id" class="aw-message {{item.role}}">
            <text>{{item.content}}</text>
            <text wx:if="{{item.role === 'assistant' && item.applied}}" class="aw-applied">已更新文案</text>
          </view>
          <view wx:if="{{chatting}}" class="aw-message assistant typing"><text>正在结合现有稿整理…</text></view>
        </view>
      </scroll-view>

      <scroll-view class="aw-suggestions" scroll-x>
        <view class="aw-suggestions-inner">
          <view
            wx:for="{{chatSuggestions}}"
            wx:key="*this"
            class="aw-suggestion"
            data-prompt="{{item}}"
            bindtap="useSuggestion"
          >{{item}}</view>
        </view>
      </scroll-view>

      <view class="aw-compose">
        <textarea
          class="aw-input"
          value="{{chatInput}}"
          bindinput="inputChat"
          auto-height
          maxlength="600"
          adjust-position="{{true}}"
          cursor-spacing="18"
          placeholder="例如：朴实一点，突出我做了十几年"
        />
        <view class="aw-send {{chatting ? 'busy' : ''}}" bindtap="sendChat">{{chatting ? '生成中' : '发送'}}</view>
      </view>
    </view>
  </view>

  <login-sheet open="{{showLogin}}" reason="execute" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
