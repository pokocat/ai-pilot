<view class="vd vd-avatar {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="vd-head">
    <view class="vd-safe"></view>
    <view class="vd-headrow">
      <view class="vd-back" bindtap="back"><native-icon name="back" tone="ink" size="22"></native-icon></view>
      <text class="vd-title">我的数字分身</text>
      <text class="vd-headact"> </text>
    </view>
  </view>

  <scroll-view class="vd-scroll" scroll-y enable-flex>
    <view class="av-body">
      <view wx:if="{{loading}}" class="vd-empty"><text class="s">正在加载…</text></view>

      <block wx:elif="{{!avatar}}">
        <view class="vd-empty">
          <text class="t">还没有数字分身</text>
          <text class="s">上传一段正脸视频就能创建，之后每条片子都不用再出镜拍摄。</text>
          <view class="vd-btn av-empty-btn" bindtap="startClone">上传视频创建</view>
        </view>
      </block>

      <block wx:else>
        <!-- 视频创建是主任务；声音是次级增强，不再做成两张同级卡。 -->
        <view class="vd-card av-primary">
          <view class="avp-head">
            <view><text class="avp-kicker">你的出镜形象</text><text class="avp-title">视频数字人</text></view>
            <text class="avc-status {{avatar.imageStatus}}">{{avatar.imageStatusText}}</text>
          </view>
          <view class="avp-body">
            <view class="avc-face">
              <image wx:if="{{avatar.imagePreviewUrl}}" class="avc-photo" src="{{avatar.imagePreviewUrl}}" mode="aspectFill"></image>
              <native-icon wx:else name="user" tone="red" size="28"></native-icon>
            </view>
            <view class="avp-copy">
              <text class="avp-state">{{avatar.imageStatus === 'ready' ? '形象已可用' : (avatar.imageStatus === 'failed' ? '这段视频需要重拍' : (avatar.imageStatus === 'training' ? '正在云端训练' : '还没有创建形象'))}}</text>
              <text class="avp-date">{{avatar.imageStatus === 'none' ? '上传一段视频即可创建' : (avatar.imageTrainedText || '训练完成后可直接出片')}}</text>
            </view>
          </view>
          <text wx:if="{{avatar.imageMessage}}" class="avc-message">{{avatar.imageMessage}}</text>
          <view class="avc-act" data-kind="image" bindtap="recapture">{{avatar.imageStatus === 'none' ? '上传形象视频' : (avatar.imageStatus === 'failed' ? '重拍一段视频' : '更换形象视频')}}</view>
        </view>

        <view class="vd-card av-voice">
          <view class="avv-icon"><view class="avc-wave"><view class="wv" wx:for="{{[6,14,9,18,11,7,15,10]}}" wx:key="*this" style="height:{{item}}px"></view></view></view>
          <view class="avv-copy">
            <view class="avv-title-row"><text class="avv-title">专属声音</text><text class="avv-optional">可选增强</text></view>
            <text class="avv-desc">{{avatar.voiceStatus === 'ready' ? '声音已可用，单独补录可让音色更稳定' : '不影响形象创建；补录后口播会更像你'}}</text>
            <text wx:if="{{avatar.voiceMessage}}" class="avv-message">{{avatar.voiceMessage}}</text>
          </view>
          <view class="avv-act" data-kind="voice" bindtap="recapture">{{avatar.voiceStatus === 'ready' ? '提升' : '去录制'}}</view>
        </view>

        <text class="av-note">请只使用本人或已获合法使用权的素材。你可以随时删除分身，删除后所有新的生成能力立即停用。</text>

        <view class="av-rows">
          <view class="av-row" bindtap="openConsentLog"><text class="ar-t">历史素材声明</text><native-icon class="ar-a" name="arrow" tone="neutral" size="15"></native-icon></view>
          <view class="av-row" bindtap="openUsageLog"><text class="ar-t">使用记录</text><native-icon class="ar-a" name="arrow" tone="neutral" size="15"></native-icon></view>
          <view class="av-row" bindtap="openCredits"><text class="ar-t">我的积分与充值</text><native-icon class="ar-a" name="arrow" tone="neutral" size="15"></native-icon></view>
        </view>

        <view class="av-danger" bindtap="removeAvatar">删除我的分身</view>
      </block>

      <view class="vd-footer-space"></view>
    </view>
  </scroll-view>

  <login-sheet open="{{showLogin}}" reason="execute" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
