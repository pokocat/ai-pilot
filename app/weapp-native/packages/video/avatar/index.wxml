<view class="vd vd-avatar {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="vd-head">
    <view class="vd-safe"></view>
    <view class="vd-headrow">
      <view class="vd-back" bindtap="back"><native-icon name="back" tone="ink" size="22"></native-icon></view>
      <text class="vd-title">我的数字人</text>
      <text class="vd-headact"> </text>
    </view>
  </view>

  <scroll-view class="vd-scroll" scroll-y enable-flex>
    <view class="av-body">
      <view wx:if="{{loading}}" class="vd-empty"><text class="s">正在加载…</text></view>

      <!-- 读失败且手上没有可显示的数据：明说是我们没读到。绝不能落到下面那个空态去，
           那句话会让有数字人的人重新采集一次（要扣钻石）。
           已经读到过数据时不走这里 —— 轮询抖一次不该把用户正在看的列表清空，改用列表上方的轻提示。 -->
      <view wx:elif="{{loadFailed && !avatars.length}}" class="vd-empty">
        <text class="t">没能读到你的数字人</text>
        <text class="s">这是加载失败，不是你没有创建过。已有的形象和训练进度都还在，不用重新采集，重试一下就好。</text>
        <view class="vd-btn av-empty-btn" bindtap="retry">重新加载</view>
        <view class="av-empty-link" bindtap="openVoices"><text>看看我的声音</text><native-icon name="arrow" tone="neutral" size="14"></native-icon></view>
      </view>

      <view wx:elif="{{!loggedIn}}" class="vd-empty">
        <text class="t">登录后查看你的数字人</text>
        <text class="s">创建之后每条片子都不用再出镜拍摄，形象和声音都会留在这里。</text>
        <view class="vd-btn av-empty-btn" bindtap="startClone">上传视频创建</view>
      </view>

      <block wx:elif="{{!avatars.length}}">
        <view class="vd-empty">
          <text class="t">还没有数字人</text>
          <text class="s">上传一段正脸视频就能创建，之后每条片子都不用再出镜拍摄。</text>
          <view class="vd-btn av-empty-btn" bindtap="startClone">上传视频创建</view>
          <!-- 这一屏只管形象。声音是能脱离形象独立存在的，别让「只训了声音」的人以为自己什么都没有。 -->
          <view class="av-empty-link" bindtap="openVoices"><text>已经录过声音？看看我的声音</text><native-icon name="arrow" tone="neutral" size="14"></native-icon></view>
        </view>
      </block>

      <block wx:else>
        <!-- 有数据但这次刷新没成功：列表照常显示，只解释一句「数字可能不是最新的」。 -->
        <view wx:if="{{loadFailed}}" class="av-stale" bindtap="retry"><text class="av-stale-t">刚才没刷新成功，下面是上一次读到的状态</text><text class="av-stale-a">重试</text></view>
        <view class="av-list-head"><view><text class="av-list-kicker">你的数字人库</text><text class="av-list-title">{{avatars.length}} 个出镜形象</text></view><view class="av-add" bindtap="startClone">+ 新建</view></view>
        <view wx:for="{{avatars}}" wx:key="id" class="vd-card av-primary av-item">
          <view class="avp-head">
            <view><text class="avp-kicker">出镜形象</text><text class="avp-title">{{item.name}}</text></view>
            <text class="avc-status {{item.imageStatus}}">{{item.imageStatusText}}</text>
          </view>
          <view class="avp-body">
            <view class="avc-face">
              <image wx:if="{{item.imagePreviewUrl}}" class="avc-photo" src="{{item.imagePreviewUrl}}" mode="aspectFill"></image>
              <native-icon wx:else name="user" tone="red" size="28"></native-icon>
            </view>
            <view class="avp-copy">
              <text class="avp-state">{{item.imageStatus === 'ready' ? '形象已可用' : (item.imageStatus === 'failed' ? '这段视频需要重拍' : (item.imageStatus === 'training' ? '正在云端训练' : '还没有创建形象'))}}</text>
              <text class="avp-date">{{item.imageStatus === 'none' ? '上传一段视频即可创建' : (item.imageTrainedText || '训练完成后可直接出片')}}</text>
              <text class="avp-voice">{{item.linkedVoiceName ? '关联声音 · ' + item.linkedVoiceName : '未关联声音'}}</text>
              <view class="avp-voice-state"><text class="avv-status {{item.voiceStatus}}">{{item.voiceBadgeText}}</text><text class="avp-voice-desc">{{item.voiceDesc}}</text></view>
              <text wx:if="{{item.voiceCompletedText}}" class="avp-voice-completed">{{item.voiceCompletedText}}</text>
            </view>
          </view>
          <text wx:if="{{item.imageMessage}}" class="avc-message">{{item.imageMessage}}</text>
          <view class="av-item-actions"><view wx:if="{{item.demoVideoUrl}}" class="avc-act primary" data-id="{{item.id}}" bindtap="openDemoVideo">看出镜效果</view><view wx:if="{{item.linkedVoiceId && item.voiceStatus === 'ready'}}" class="avc-act {{item.demoVideoUrl ? '' : 'primary'}}" data-id="{{item.id}}" bindtap="openVoicePreview">试听声音</view><view class="avc-act" data-id="{{item.id}}" data-kind="image" bindtap="recapture">更换形象</view><view class="avc-act voice" data-id="{{item.id}}" data-kind="voice" bindtap="recapture">{{item.voiceActionText}}</view><view class="av-delete-one" data-id="{{item.id}}" bindtap="removeAvatar">删除</view></view>
          <view wx:if="{{item.voiceStatus === 'training'}}" class="avv-progress"><view class="avv-progress-fill" style="width:{{item.voiceProgress}}%"></view></view>
          <view wx:if="{{item.voiceMessage}}" class="avv-message">{{item.voiceMessage}}</view>
        </view>

        <view class="vd-card av-voice av-shared-voice">
          <view class="avv-icon"><view class="avc-wave"><view class="wv" wx:for="{{[6,14,9,18,11,7,15,10]}}" wx:key="*this" style="height:{{item}}px"></view></view></view>
          <view class="avv-copy">
            <view class="avv-title-row"><text class="avv-title">声音可以重复使用</text><text class="avv-status ready">自动带入</text></view>
            <text class="avv-desc">新建形象时可以直接关联已有的声音，换场景、换装扮都不用重新录音。</text>
          </view>
        </view>

        <text class="av-note">请只使用本人或已获合法使用权的素材。你可以随时删除数字人，删除后立即停用，不能再用它出新的片子。</text>

        <view class="av-rows">
          <view class="av-row" bindtap="openVoices"><text class="ar-t">我的声音</text><native-icon class="ar-a" name="arrow" tone="neutral" size="15"></native-icon></view>
          <view class="av-row" bindtap="openConsentLog"><text class="ar-t">授权记录</text><native-icon class="ar-a" name="arrow" tone="neutral" size="15"></native-icon></view>
          <view class="av-row" bindtap="openUsageLog"><text class="ar-t">使用记录</text><native-icon class="ar-a" name="arrow" tone="neutral" size="15"></native-icon></view>
          <view class="av-row" bindtap="openCredits"><text class="ar-t">我的积分与充值</text><native-icon class="ar-a" name="arrow" tone="neutral" size="15"></native-icon></view>
        </view>

      </block>

      <view class="vd-footer-space"></view>
    </view>
  </scroll-view>

  <!-- 数字人样例短片：静帧看不出口型和构图，这条能。训练完成时固化，看多少次都不再打供应商。 -->
  <view wx:if="{{demoVideoOpen}}" class="dv-mask" catchtap="closeDemoVideo">
    <view class="dv-sheet" catchtap="swallow">
      <view class="dv-head">
        <view>
          <text class="dv-title">出镜效果 · {{demoVideoName}}</text>
          <text class="dv-sub">训练完成时给你留的样例，出片时就是这个人在说话。</text>
        </view>
        <view class="dv-close" bindtap="closeDemoVideo"><native-icon name="close" tone="neutral" size="18"></native-icon></view>
      </view>
      <view class="vd-portrait dv-player">
        <video class="inner" src="{{demoVideoUrl}}" object-fit="contain" autoplay
          show-fullscreen-btn="{{false}}" enable-progress-gesture="{{false}}"></video>
      </view>
      <text class="dv-note">成片里的画面、字幕和封面另外配，这条只用来确认人和声音对不对。</text>
      <view class="vd-btn ghost" bindtap="closeDemoVideo">看完了</view>
    </view>
  </view>

  <voice-preview
    open="{{voicePreviewOpen}}"
    voice-id="{{voicePreviewId}}"
    voice-name="{{voicePreviewName}}"
    demo-audio-url="{{voicePreviewDemoUrl}}"
    bindclose="closeVoicePreview"
  ></voice-preview>

  <login-sheet open="{{showLogin}}" reason="video" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
