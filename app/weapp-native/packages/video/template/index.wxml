<view class="vd vd-template {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="vd-head">
    <view class="vd-safe"></view>
    <view class="vd-headrow">
      <view class="vd-back" bindtap="back"><native-icon name="back" tone="ink" size="22"></native-icon></view>
      <text class="vd-title">模板</text>
      <text class="vd-headact"> </text>
    </view>
  </view>

  <scroll-view class="vd-scroll" scroll-y enable-flex>
    <view class="tp-body">
      <view wx:if="{{loading}}" class="vd-empty"><text class="s">正在打开…</text></view>

      <block wx:else>
        <view class="tp-hero-card">
          <view class="vd-portrait tp-hero">
            <view class="inner vd-grain {{template.coverTone}}"><view class="tp-glow"></view><text class="tp-poster-word">STORY</text></view>
            <view class="vd-ai-badge tp-badge">智能模板</view>
            <text class="tp-dur">{{durationText}}</text>
          </view>
          <view class="tp-intro">
            <text class="tp-industry">{{template.industry}} · 竖屏故事</text>
            <text class="tp-name">{{template.name}}</text>
            <text class="tp-desc">{{template.description}}</text>
            <view class="tp-chips"><text>带字幕</text><text>可改文案</text><text>可换画面</text></view>
          </view>
        </view>

        <!-- 结构拆解 -->
        <view class="tp-struct vd-card">
          <text class="ts-kicker">成片结构</text>
          <text class="ts-title">三种画面，已经替你排好</text>
          <text class="ts-sub">你只需要决定哪些段由数字人出镜，哪些段放店铺画面。</text>

          <view class="ts-row">
            <text class="ts-no">01</text>
            <text class="vd-tag avatar"><text class="sq"></text>数字人出镜</text>
            <text class="ts-text">约 {{template.avatarSecHint}} 秒 · 开头一段，中段再穿插一次</text>
          </view>
          <view class="ts-row">
            <text class="ts-no">02</text>
            <text class="vd-tag broll"><text class="sq"></text>配画面</text>
            <text class="ts-text">其余句子用你自己拍的店铺画面，数字人的声音继续念</text>
          </view>
          <view class="ts-row">
            <text class="ts-no">03</text>
            <text class="vd-tag tail"><text class="sq"></text>固定片段</text>
            <text class="ts-text">{{template.tailLabel}} · {{template.tailDurationSec}} 秒，可整段替换</text>
          </view>
          <view class="ts-tail-preview {{template.tailCoverUrl ? '' : 'vd-grain'}}" bindtap="openTailPreview">
            <image wx:if="{{template.tailCoverUrl}}" class="ts-tail-image" src="{{template.tailCoverUrl}}" mode="aspectFill"></image>
            <view class="ts-tail-copy"><text class="ts-tail-name">{{template.tailLabel}}</text><text class="ts-tail-meta">固定片段 · {{template.tailDurationSec}} 秒</text></view>
            <view class="ts-tail-play"><native-icon name="play" tone="white" size="14"></native-icon><text>预览</text></view>
          </view>

          <text class="ts-note">模板是一版可以直接用的起点。下一步可以让 AI 和你聊几句，再改成属于你自己的文案。</text>
        </view>

        <view class="tp-price vd-card">
          <view><text class="tpp-label">本模板预估</text><view class="tpp-main"><text class="num">{{template.creditHint}}</text><text class="unit">积分起</text></view></view>
          <view class="tpp-side"><text class="tpp-value">{{durationText}}</text><text class="tpp-sub">预计成片 · {{template.segmentCount}} 个片段</text></view>
        </view>
      </block>

      <view class="vd-footer-space"></view>
    </view>
  </scroll-view>

  <view class="vd-footer">
    <view class="vd-btn" style="flex:1" bindtap="start">{{creating ? '正在创建…' : '开始制作'}}</view>
  </view>

  <view wx:if="{{tailPreviewOpen && template}}" class="tail-preview-mask" catchtap="closeTailPreview">
    <view class="tail-preview-sheet" catchtap="swallow">
      <view class="tail-preview-head"><view><text class="tail-preview-title">{{template.tailLabel}}</text><text class="tail-preview-sub">固定片段 · {{template.tailDurationSec}} 秒</text></view><view class="tail-preview-close" bindtap="closeTailPreview"><native-icon name="close" tone="neutral" size="18"></native-icon></view></view>
      <video class="tail-preview-video" src="{{template.tailMediaUrl}}" poster="{{template.tailCoverUrl}}" controls autoplay show-center-play-btn enable-progress-gesture object-fit="contain"></video>
    </view>
  </view>

  <login-sheet open="{{showLogin}}" reason="video" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
