<view class="vd vd-confirm {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="vd-head">
    <view class="vd-safe"></view>
    <view class="vd-headrow">
      <view class="vd-back" bindtap="back"><native-icon name="back" tone="ink" size="22"></native-icon></view>
      <text class="vd-title">确认出片</text>
      <text class="vd-headact"> </text>
    </view>
    <view class="vd-steps">
      <view class="vd-step done"><view class="dot"><native-icon name="check" tone="white" size="11"></native-icon></view><text>改文案</text></view>
      <view class="vd-step-line"></view>
      <view class="vd-step done"><view class="dot"><native-icon name="check" tone="white" size="11"></native-icon></view><text>配画面</text></view>
      <view class="vd-step-line"></view>
      <view class="vd-step on"><view class="dot">3</view><text>出片</text></view>
    </view>
  </view>

  <scroll-view class="vd-scroll" scroll-y enable-flex>
    <view class="cf-body">

      <view wx:if="{{loading}}" class="vd-empty"><text class="s">正在核算…</text></view>

      <block wx:else>
        <view class="cf-ready">
          <view class="cfr-icon"><native-icon name="check" tone="white" size="18"></native-icon></view>
          <view><text class="cfr-kicker">最后确认</text><text class="cfr-title">画面和文案都准备好了</text><text class="cfr-sub">确认价格后开始生成，关掉小程序也不会中断。</text></view>
        </view>

        <!-- 首帧预览 -->
        <view class="cf-preview vd-card">
          <view class="vd-portrait cf-thumb">
            <image wx:if="{{avatar && avatar.imagePreviewUrl}}" class="inner" src="{{avatar.imagePreviewUrl}}" mode="aspectFill"></image>
            <view wx:else class="inner vd-grain"></view>
            <view wx:if="{{aiWatermark}}" class="vd-ai-badge cf-badge">AI 生成</view>
          </view>
          <view class="cf-pv-body">
            <text class="cf-pv-title">{{project.templateName}}</text>
            <text class="cf-pv-sub">竖屏 · 带字幕</text>
            <view class="cf-stats">
              <view class="cf-stat"><text class="k">成片时长</text><text class="v">{{totalText}}</text></view>
              <view class="cf-stat"><text class="k">数字人出镜</text><text class="v">{{summary.avatarSec}} 秒 · {{summary.avatarCount}} 段</text></view>
              <view class="cf-stat"><text class="k">配画面</text><text class="v">{{summary.brollCount}} 段</text></view>
              <view class="cf-stat"><text class="k">结尾固定段</text><text class="v">{{summary.tailSec}} 秒</text></view>
            </view>
          </view>
        </view>

        <!-- 成片封面：排在水印前面 —— 封面决定别人在信息流里点不点开，比水印重要得多。 -->
        <view class="cf-cover vd-card {{coverSummary.state === 'drafted' ? 'is-drafted' : ''}}" bindtap="goCover">
          <view class="cf-cover-copy">
            <text class="cf-cover-title">成片封面</text>
            <text class="cf-cover-sub cf-cover-{{coverSummary.state}}">{{coverSummary.text}}</text>
          </view>
          <view class="cf-cover-go">
            <text class="cf-cover-action">{{coverSummary.state === 'on' ? '修改' : (coverSummary.state === 'drafted' ? '去开启' : '去设置')}}</text>
            <native-icon name="arrow" tone="ink" size="16"></native-icon>
          </view>
        </view>

        <view class="cf-watermark vd-card">
          <view class="cf-watermark-copy">
            <text class="cf-watermark-title">AI 生成水印</text>
            <text class="cf-watermark-sub">默认关闭；需要时可加到成片右上角</text>
          </view>
          <view class="cf-watermark-control">
            <text class="cf-watermark-state">{{watermarkSaving ? '保存中' : (aiWatermark ? '已开启' : '已关闭')}}</text>
            <switch checked="{{aiWatermark}}" disabled="{{watermarkSaving}}" color="#C65232" bindchange="toggleAiWatermark"></switch>
          </view>
        </view>

        <!-- preflight 问题 -->
        <view wx:if="{{problems.length}}" class="cf-problems">
          <text class="cp-title">还差这些才能出片</text>
          <view wx:for="{{problems}}" wx:key="code" class="cp-row">
            <text class="cp-dot">·</text><text class="cp-text">{{item.message}}</text>
          </view>
        </view>

        <!-- 积分明细 -->
        <view wx:if="{{estimate}}" class="cf-bill vd-card">
          <text class="cb-kicker">费用明细</text>
          <text class="cb-title">只按实际生成的内容计费</text>
          <view wx:for="{{estimate.items}}" wx:key="key" class="cb-row">
            <text class="cb-k">{{item.label}}</text>
            <text class="cb-v {{item.freeText ? 'free' : ''}}">{{item.freeText || item.credits}}</text>
          </view>
          <view class="cb-total">
            <text class="cb-k">合计</text>
            <view class="cb-total-v"><text class="num">{{estimate.total}}</text><text class="unit">积分</text></view>
          </view>
          <view wx:if="{{balance !== null}}" class="cb-balance">
            <text>当前余额 {{balance}}</text>
            <text class="dim">出完还剩 {{afterBalance}}</text>
          </view>
        </view>
        <view wx:else class="cf-quote-error vd-card">
          <text class="cp-title">价格核算失败</text>
          <text class="cp-text">{{quoteError || '正在核算价格，稍等一下。'}}</text>
          <view class="cf-retry" bindtap="load">重新核算</view>
        </view>

        <text class="cf-note">
          AI 生成水印默认关闭，只有你主动开启时才会写入成片。声音和形象来自你本人授权的数字人；出片后不满意可以改文案重出，只按新的数字人出镜时长收费。
        </text>
      </block>

      <view class="vd-footer-space"></view>
    </view>
  </scroll-view>

  <view class="vd-footer">
    <view class="vd-btn ghost" bindtap="prev">上一步</view>
    <view
      class="vd-btn {{(loading || !quoteReady || problems.length || submitting || watermarkSaving) ? 'disabled' : ''}}"
      style="flex:1"
      bindtap="submit"
    >{{loading || !quoteReady ? '正在核算价格…' : (watermarkSaving ? '正在保存设置…' : (submitting ? '正在提交…' : '确认出片 · ' + estimate.total + ' 积分'))}}</view>
  </view>

  <login-sheet open="{{showLogin}}" reason="video" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
