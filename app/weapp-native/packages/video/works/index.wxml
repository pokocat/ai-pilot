<view class="vd vd-works {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="vd-head">
    <view class="vd-safe"></view>
    <view class="vd-headrow">
      <view wx:if="{{!asTab}}" class="vd-back" bindtap="back"><native-icon name="back" tone="ink" size="22"></native-icon></view>
      <text class="vd-title">我的作品</text>
      <text class="vd-headact"> </text>
    </view>
    <view class="wk-tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="wk-tab {{active === item.key ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="selectTab"
      >{{item.label}} {{counts[item.key]}}</view>
    </view>
  </view>

  <scroll-view class="vd-scroll" scroll-y enable-flex>
    <view class="wk-body">
      <view wx:if="{{loading}}" class="vd-empty"><text class="s">正在加载…</text></view>

      <view wx:elif="{{!visible.length}}" class="vd-empty">
        <text class="t">还没有作品</text>
        <text class="s">挑一个模板，改几句文案，第一条片子大概 3 分钟就好。</text>
        <view class="vd-btn wk-empty-btn" bindtap="pickTemplate">去挑模板</view>
      </view>

      <view wx:else class="wk-list">
        <view
          wx:for="{{visible}}"
          wx:key="id"
          class="vd-card wk-card"
          data-id="{{item.id}}"
          bindtap="openWork"
        >
          <view class="vd-portrait wk-thumb">
            <image wx:if="{{item.thumbnailUrl}}" class="inner wk-thumb-image" src="{{item.thumbnailUrl}}" mode="aspectFill"></image>
            <view wx:else class="inner vd-grain"></view>
            <view wx:if="{{item.status !== 'generating'}}" class="wk-play"><native-icon name="play" tone="white" size="18"></native-icon></view>
            <text wx:if="{{item.status !== 'generating'}}" class="wk-dur">{{item.durationText}}</text>
          </view>

          <view class="wk-body-col">
            <view class="wk-title-row">
              <text class="wk-title">{{item.title}}</text>
              <view class="wk-delete" data-id="{{item.id}}" catchtap="removeWork">删除</view>
            </view>
            <text wx:if="{{item.createdText}}" class="wk-meta">{{item.createdText}}</text>

            <block wx:if="{{item.status === 'generating'}}">
              <text class="wk-progress">正在出片 {{item.progress}}% · {{item.etaText}}</text>
              <view class="wk-bar"><view class="fill" style="width:{{item.progress}}%"></view></view>
              <text class="wk-note">出好后会发消息通知你</text>
            </block>

            <block wx:elif="{{item.status === 'published'}}">
              <view wx:for="{{item.publishStats}}" wx:for-item="stat" wx:key="platform" class="wk-stat">
                <text class="ws-p">{{stat.platform}}</text><text class="ws-t">{{stat.text}}</text>
              </view>
            </block>

            <block wx:else>
              <text class="wk-note">数字人出镜 {{item.avatarSec}} 秒</text>
              <text class="wk-note">已扣 {{item.credits}} 积分</text>
            </block>
          </view>
        </view>
      </view>

      <view class="vd-footer-space"></view>
    </view>
  </scroll-view>

  <vd-tabbar wx:if="{{asTab}}" current="works" bindneedlogin="needLogin"></vd-tabbar>
  <login-sheet open="{{showLogin}}" reason="video" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
