<view class="vd vd-clone {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="vd-head">
    <view class="vd-safe"></view>
    <view class="vd-headrow">
      <view class="vd-back" bindtap="back"><native-icon name="back" tone="ink" size="22"></native-icon></view>
      <text class="vd-title">创建我的数字分身</text>
      <text class="vd-headact"> </text>
    </view>

    <view class="cl-steps">
      <view wx:for="{{steps}}" wx:key="no" class="cl-step {{step === item.no ? 'on' : (step > item.no ? 'done' : '')}}">
        <view class="cs-dot"><native-icon wx:if="{{step > item.no}}" name="check" tone="white" size="12"></native-icon><text wx:else>{{item.no}}</text></view>
        <text class="cs-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <scroll-view class="vd-scroll" scroll-y enable-flex>
    <view class="cl-body">

      <!-- ① 声音克隆：页面内录音，朗读稿始终可见；也支持上传现有音频。 -->
      <block wx:if="{{step === 1}}">
        <view class="cl-type"><text class="cl-type-k">视频数字人</text><text class="cl-type-v">先让分身学会你的声音</text></view>
        <text class="cl-h">第 1 步 · 克隆你的声音</text>
        <text class="cl-s">在线录制时朗读稿会一直留在屏幕上；也可以直接上传一段干净的单人音频。</text>

        <view class="cl-source-tabs">
          <view class="cl-source on" bindtap="toggleRecord"><text>{{recording ? '结束录制' : '在线录制'}}</text></view>
          <view class="cl-source" bindtap="pickVoice"><text>上传音频</text></view>
        </view>

        <view class="cl-reading vd-card">
          <text class="cr-label">自然读一遍 · {{requirements.voice.minDurationSec}} 秒可提交，建议 {{requirements.voice.recommendedMinDurationSec}}–{{requirements.voice.recommendedMaxDurationSec}} 秒</text>
          <text class="cr-script">{{readingScript}}</text>
        </view>

        <view class="cl-recorder">
          <text class="cl-timer">{{recordSeconds}}s</text>
          <text class="cl-timer-hint">安静环境 · 一个人说话 · 正常语速</text>
        </view>

        <view class="cl-mic {{recording ? 'on' : ''}}" bindtap="toggleRecord">
          <text>{{recording ? '正在录，点一下结束' : (voiceFile ? '重新录一段' : '开始录制')}}</text>
        </view>

        <view wx:if="{{voiceFile}}" class="cl-file-ready">
          <view class="cfr-check"><native-icon name="check" tone="white" size="12"></native-icon></view>
          <view class="cfr-copy"><text class="cfr-title">{{voiceFile.source === 'file' ? (voiceFile.name || '音频已选择') : '录音已完成'}}</text><text class="cfr-meta">{{voiceFile.duration ? voiceFile.duration + ' 秒' : '提交后会检查真实时长与音质'}}</text></view>
        </view>

        <view wx:if="{{voiceFile}}" class="cl-acts">
          <view class="vd-btn ghost cl-act" bindtap="retakeVoice">重新选择</view>
          <view class="vd-btn cl-act" bindtap="submitVoice">{{submitting ? '提交中…' : (recaptureKind === 'voice' ? '提交训练' : '下一步 · 上传形象')}}</view>
        </view>
      </block>

      <!-- ② 形象视频：直接上传训练，不再要求另录授权口播。 -->
      <block wx:elif="{{step === 2}}">
        <text class="cl-h">第 2 步 · 上传形象视频</text>
        <text class="cl-s">录满 {{requirements.avatar.minDurationSec}} 秒即可提交，建议 {{requirements.avatar.recommendedMinDurationSec}}–{{requirements.avatar.recommendedMaxDurationSec}} 秒。录制时不需要念固定文案，正脸自然说话或做轻微动作即可。</text>

        <view wx:if="{{!faceFile}}" class="cl-upload" bindtap="pickFace">
          <view class="cl-upload-plus"><native-icon name="plus" tone="neutral" size="24"></native-icon></view>
          <text class="cl-upload-title">选择形象视频</text>
          <text class="cl-upload-meta">支持竖屏 · MP4/MOV · H.264 · 360p–4K</text>
        </view>

        <view wx:else class="cl-video-card">
          <video class="cl-video" src="{{faceFile.path}}" object-fit="contain" controls show-center-play-btn enable-progress-gesture></video>
          <view class="cl-video-meta"><text>形象视频已选择</text><text>{{faceFile.duration ? faceFile.duration + ' 秒' : '等待提交检查'}}</text></view>
        </view>

        <view class="cl-guide vd-card">
          <text class="ci-title">拍摄指南</text>
          <view class="cl-guide-grid">
            <view class="cl-guide-item"><view class="cgi-dot"><native-icon name="check" tone="white" size="10"></native-icon></view><text>光线照在脸上</text></view>
            <view class="cl-guide-item"><view class="cgi-dot"><native-icon name="check" tone="white" size="10"></native-icon></view><text>只拍一位人物</text></view>
            <view class="cl-guide-item"><view class="cgi-dot"><native-icon name="check" tone="white" size="10"></native-icon></view><text>正脸看向镜头</text></view>
            <view class="cl-guide-item"><view class="cgi-dot"><native-icon name="check" tone="white" size="10"></native-icon></view><text>手机固定不晃动</text></view>
          </view>
          <text class="cl-guide-note">相机录制会进入微信原生全屏界面；因为无需念稿，按上面四点自然拍摄即可。</text>
        </view>

        <view wx:if="{{!faceFile}}" class="cl-acts">
          <view class="vd-btn cl-act" bindtap="pickFace">从相册选视频</view>
          <view class="vd-btn ghost cl-act" bindtap="recordFace">现在录制</view>
        </view>
        <view wx:else class="cl-acts">
          <view class="vd-btn ghost cl-act" bindtap="retakeFace">更换视频</view>
          <view class="vd-btn cl-act {{agreed ? '' : 'disabled'}}" bindtap="submitAvatar">{{submitting ? '提交中…' : '创建视频数字人'}}</view>
        </view>

        <view class="cl-agree" bindtap="toggleAgree">
          <view class="ca-box {{agreed ? 'on' : ''}}"><native-icon wx:if="{{agreed}}" name="check" tone="white" size="12"></native-icon></view>
          <text class="ca-text">我确认对上传的声音和视频有合法使用权，并同意<text class="ca-link" catchtap="openUsageDoc">《数字分身素材使用说明》</text>。</text>
        </view>
      </block>

      <!-- ③ 训练中 -->
      <block wx:else>
        <view class="cl-progress">
          <text class="cp-num">{{training.percent}}%</text>
          <text class="cp-label">正在学习</text>
        </view>

        <text class="cl-h center">分身正在训练</text>
        <text class="cl-s center">{{training.etaText}}。可以先退出，回来会继续显示真实进度。</text>

        <view class="cl-track vd-card">
          <view class="ct-row {{training.voiceDone ? 'done' : 'busy'}}">
            <view class="ct-dot"><native-icon wx:if="{{training.voiceDone}}" name="check" tone="white" size="12"></native-icon></view>
            <text class="ct-label">声音克隆</text>
            <text class="ct-state {{training.voiceFailed ? 'failed' : ''}}">{{training.voiceStateText}}</text>
          </view>
          <view class="ct-row {{training.imageDone ? 'done' : 'busy'}}">
            <view class="ct-dot"><native-icon wx:if="{{training.imageDone}}" name="check" tone="white" size="12"></native-icon></view>
            <text class="ct-label">形象训练</text>
            <text class="ct-state {{training.imageFailed ? 'failed' : ''}}">{{training.imageStateText}}</text>
          </view>
        </view>

        <view wx:if="{{training.hasFailure}}" class="cl-retry vd-card">
          <text class="ci-title">有一项需要重新采集</text>
          <text class="ci-row">按上面的提示重录即可，已经完成的另一项不用重做。</text>
          <view class="cl-acts retry">
            <view wx:if="{{training.imageFailed}}" class="vd-btn ghost" bindtap="retryImage">重拍形象</view>
            <view wx:if="{{training.voiceFailed}}" class="vd-btn ghost" bindtap="retryVoice">重录声音</view>
          </view>
        </view>

        <view wx:if="{{presetAvailable}}" class="cl-preset vd-card">
          <text class="ci-title">不想等？先做第一条</text>
          <text class="ci-row">用平台提供的形象和声音先出一条片子，你的分身训练好之后，一键换成你自己。</text>
          <view class="vd-btn cl-preset-btn" bindtap="usePreset">先用预置形象出片</view>
        </view>

        <view class="vd-btn ghost" bindtap="leaveTraining">训练好通知我 · 返回</view>
      </block>

      <view class="vd-footer-space"></view>
    </view>
  </scroll-view>

  <login-sheet open="{{showLogin}}" reason="execute" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
