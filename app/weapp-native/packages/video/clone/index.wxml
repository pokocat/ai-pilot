<view class="vd vd-clone {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="vd-head">
    <view class="vd-safe"></view>
    <view class="vd-headrow">
      <view class="vd-back" bindtap="back"><native-icon name="back" tone="ink" size="22"></native-icon></view>
      <text class="vd-title">{{mode === 'voice' ? (retrainVoiceId ? '重新训练声音' : '提升专属声音') : '创建我的数字分身'}}</text>
      <text class="vd-headact"> </text>
    </view>

    <view wx:if="{{mode === 'avatar'}}" class="cl-steps">
      <view wx:for="{{steps}}" wx:key="no" class="cl-step {{step === item.no ? 'on' : (step > item.no ? 'done' : '')}}">
        <view class="cs-dot"><native-icon wx:if="{{step > item.no}}" name="check" tone="white" size="12"></native-icon><text wx:else>{{item.no}}</text></view>
        <text class="cs-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <scroll-view class="vd-scroll" scroll-y enable-flex>
    <view class="cl-body">

      <!-- 可选声音增强：它是管理页的独立任务，不在数字人创建主链上。 -->
      <block wx:if="{{mode === 'voice' && step === 1}}">
        <view class="cl-enhance-intro">
          <text class="cl-enhance-kicker">{{retrainVoiceId ? '重新训练' : '可选增强'}}</text>
          <text class="cl-h">{{retrainVoiceId ? '用新录音换掉现有声音' : '让分身更像你的声音'}}</text>
          <!-- 重训是就地覆盖那条声音（供应商 recreate 改的是同一个对象），不是新增一条。
               不说清楚的话，用户会以为自己在攒声音库，结果原来的音色没了。 -->
          <text class="cl-s">{{retrainVoiceId ? '这段新录音会替换掉这条声音现在的音色，之后的口播都用新的；已经生成好的成片不受影响。' : '数字人已经可以由一段视频创建。单独录一段干净人声，只是让后续口播的音色更稳定、更像你。'}}</text>
        </view>

        <!-- 训练声音是全流程最贵的单次动作，必须在录之前就把价摆出来。价格读不到时整块不渲染。 -->
        <view wx:if="{{costRows.length}}" class="cl-cost vd-card">
          <view class="cc-head">
            <native-icon name="diamond" tone="gold" size="15"></native-icon>
            <text class="cc-title">这次要扣多少</text>
          </view>
          <view wx:for="{{costRows}}" wx:key="key" class="cc-row">
            <text class="cc-label">{{item.label}}</text>
            <text class="cc-value {{item.free ? 'free' : ''}}">{{item.costText}}</text>
          </view>
          <text wx:if="{{retrainQuotaText}}" class="cc-note {{retrainBlocked ? 'warn' : ''}}">{{retrainQuotaText}}</text>
          <!-- 重训走不通时给一个显式改道入口。不自动切：重训与新建差三倍多的价，替用户切等于替他花钱。 -->
          <view wx:if="{{retrainBlocked}}" class="cc-switch" bindtap="switchToNewVoice">改为新建一条声音</view>
          <text class="cc-note">{{retrainVoiceId ? '重新训练比新建一条便宜，也不会多占一份克隆权益。' : '已经有可用声音的话，直接在创建数字人时复用它，不额外扣费。'}}</text>
        </view>

        <view class="cl-source-tabs">
          <view class="cl-source on" bindtap="toggleRecord"><text>{{recording ? '结束录制' : (startingRecord ? '正在开启…' : '在线录制')}}</text></view>
          <view class="cl-source" bindtap="pickVoice"><text>上传音频</text></view>
        </view>

        <view class="cl-reading vd-card">
          <text class="cr-label">自然读一遍 · {{requirements.voice.minDurationSec}} 秒可提交，建议 {{requirements.voice.recommendedMinDurationSec}}–{{requirements.voice.recommendedMaxDurationSec}} 秒</text>
          <text class="cr-script">{{readingScript}}</text>
        </view>

        <view class="cl-recorder">
          <text class="cl-timer">{{recordSeconds}}s</text>
          <text class="cl-timer-hint">安静环境 · 一个人说话 · 正常语速</text>
        </view>

        <view class="cl-mic {{recording ? 'on' : ''}}" bindtap="toggleRecord">
          <text>{{recording ? '正在录，点一下结束' : (startingRecord ? '正在开启麦克风…' : (voiceFile ? '重新录一段' : '开始录制'))}}</text>
        </view>

        <view wx:if="{{voiceFile}}" class="cl-file-ready">
          <view class="cfr-check"><native-icon name="check" tone="white" size="12"></native-icon></view>
          <view class="cfr-copy"><text class="cfr-title">{{voiceFile.source === 'file' ? (voiceFile.name || '音频已选择') : '录音已完成'}}</text><text class="cfr-meta">{{voiceFile.duration ? voiceFile.duration + ' 秒' : '提交后会检查真实时长与音质'}}</text></view>
        </view>

        <view wx:if="{{voiceFile}}" class="cl-acts">
          <view class="vd-btn ghost cl-act" bindtap="retakeVoice">重新选择</view>
          <view class="vd-btn cl-act {{retrainBlocked ? 'disabled' : ''}}" bindtap="submitVoice">{{submitting ? submitPhaseText : (retrainBlocked ? '这条声音训不了' : '提交声音增强')}}</view>
        </view>
        <view wx:if="{{submitting}}" class="cl-upload-progress"><view class="cup-track"><view class="cup-fill" style="width:{{uploadProgress}}%"></view></view><text>{{submitPhaseText}}{{uploadProgress > 0 && uploadProgress < 100 ? ' · ' + uploadProgress + '%' : ''}}</text><text class="cup-note">上传后会自动受理，请不要重复提交</text></view>
      </block>

      <!-- ① 只需一段视频就创建 Avatar；speakerId / authId 都不再做前置。 -->
      <block wx:elif="{{mode === 'avatar' && step === 1}}">
        <text class="cl-kicker">{{faceSource === 'image' ? '一张照片即可创建' : '一段视频即可创建'}}</text>
        <text class="cl-h">{{faceSource === 'image' ? '上传你的正脸照片' : '上传你的出镜视频'}}</text>
        <text class="cl-s">{{faceSource === 'image' ? '一张清晰正脸照就能建分身。照片里没有声音，成片说话用的是你另外训练或已有的那条声音。' : '录满 ' + requirements.avatar.minDurationSec + ' 秒即可提交，建议 ' + requirements.avatar.recommendedMinDurationSec + '–' + requirements.avatar.recommendedMaxDurationSec + ' 秒。直接创建形象；视频里有清楚人声时，还会同步生成基础声音。'}}</text>

        <!-- 素材来源二选一。两者是不同的计价档，切换会当场重算下面的账单。 -->
        <view class="cl-source-tabs">
          <view class="cl-source {{faceSource === 'video' ? 'on' : ''}}" data-source="video" bindtap="switchFaceSource"><text>用视频</text></view>
          <view class="cl-source {{faceSource === 'image' ? 'on' : ''}}" data-source="image" bindtap="switchFaceSource"><text>用照片</text></view>
        </view>

        <view class="cl-profile vd-card">
          <text class="cl-profile-label">给这个形象起个名字</text>
          <input class="cl-name-input" value="{{avatarName}}" maxlength="20" placeholder="例如：门店日常、工作室正装" bindinput="changeAvatarName" />
          <text class="cl-profile-label voice">关联声音</text>
          <!-- 候选项与扣费文案都由 model.voiceChoices 预算好：默认复用（不额外扣费）排在最前，
               「视频原声」= 新训练一条，带价展示，绝不写成「自动提取」让人以为白送。 -->
          <scroll-view class="cl-voice-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
            <view class="cl-voice-options">
              <view
                wx:for="{{voiceOptions}}"
                wx:key="key"
                class="cl-voice-option {{selectedVoiceId === item.id ? 'on' : ''}} {{item.free ? '' : 'paid'}}"
                data-id="{{item.id}}"
                bindtap="chooseExistingVoice"
              >
                <text class="name">{{item.name}}</text>
                <text class="meta">{{item.meta}}</text>
                <text class="cost {{item.free ? 'free' : ''}}">{{item.costText}}</text>
              </view>
            </view>
          </scroll-view>
          <text class="cl-profile-note">{{voiceNoteText}}</text>
          <!-- 照片没有声音，且一条可复用的都没有：这时不给「视频原声」那种假选项，
               直接把唯一可行的路给出来 —— 去录一段，训好回来自动出现在上面。 -->
          <view wx:if="{{faceSource === 'image' && !hasReusableVoice}}" class="cc-switch" bindtap="goRecordVoice">去录一段声音</view>
        </view>

        <!-- 成本明示：价格来自服务端（运营后台可配），costRows 为空 = 还没读到价格，整块不渲染。 -->
        <view wx:if="{{costRows.length}}" class="cl-cost vd-card">
          <view class="cc-head">
            <native-icon name="diamond" tone="gold" size="15"></native-icon>
            <text class="cc-title">这次要扣多少</text>
          </view>
          <view wx:for="{{costRows}}" wx:key="key" class="cc-row">
            <text class="cc-label">{{item.label}}</text>
            <text class="cc-value {{item.free ? 'free' : ''}}">{{item.costText}}</text>
          </view>
          <text class="cc-note">训练一条新声音在供应商侧成本很高，内测期请优先复用已有声音。</text>
        </view>

        <view wx:if="{{!faceFile}}" class="cl-upload" bindtap="{{faceSource === 'image' ? 'pickPhoto' : 'pickFace'}}">
          <view class="cl-upload-plus"><native-icon name="plus" tone="neutral" size="24"></native-icon></view>
          <text class="cl-upload-title">{{faceSource === 'image' ? '选择或拍一张照片' : '选择或录制视频'}}</text>
          <text class="cl-upload-meta">{{faceSource === 'image' ? 'JPG/PNG · 360p–4K · 不超过 10MB' : '支持竖屏 · MP4/MOV · H.264 · 360p–4K'}}</text>
        </view>

        <view wx:else class="cl-video-card">
          <image wx:if="{{faceFile.image}}" class="cl-video" src="{{faceFile.path}}" mode="aspectFit"></image>
          <video wx:else class="cl-video" src="{{faceFile.path}}" object-fit="contain" controls show-center-play-btn enable-progress-gesture></video>
          <view class="cl-video-meta"><text>{{faceFile.image ? '形象照片已选择' : '形象视频已选择'}}</text><text>{{faceFile.image ? '提交后会检查清晰度与分辨率' : (faceFile.duration ? faceFile.duration + ' 秒' : '等待提交检查')}}</text></view>
        </view>

        <view class="cl-guide vd-card">
          <text class="ci-title">拍摄指南</text>
          <view class="cl-guide-grid">
            <view class="cl-guide-item"><view class="cgi-dot"><native-icon name="check" tone="white" size="10"></native-icon></view><text>光线照在脸上</text></view>
            <view class="cl-guide-item"><view class="cgi-dot"><native-icon name="check" tone="white" size="10"></native-icon></view><text>只拍一位人物</text></view>
            <view class="cl-guide-item"><view class="cgi-dot"><native-icon name="check" tone="white" size="10"></native-icon></view><text>正脸看向镜头</text></view>
            <view class="cl-guide-item"><view class="cgi-dot"><native-icon name="check" tone="white" size="10"></native-icon></view><text>自然说几句话</text></view>
          </view>
          <text class="cl-guide-note">不用念固定文案。正脸看镜头，用平时的语速自然说几句就好。</text>
        </view>

        <view wx:if="{{!faceFile}}" class="cl-acts">
          <view class="vd-btn cl-act" bindtap="recordFace">现在录制</view>
          <view class="vd-btn ghost cl-act" bindtap="pickFace">从相册选择</view>
        </view>
        <view wx:else class="cl-acts">
          <view class="vd-btn ghost cl-act" bindtap="retakeFace">更换视频</view>
          <view class="vd-btn cl-act {{agreed ? '' : 'disabled'}}" bindtap="submitAvatar">{{submitting ? submitPhaseText : '创建视频数字人'}}</view>
        </view>
        <view wx:if="{{submitting}}" class="cl-upload-progress"><view class="cup-track"><view class="cup-fill" style="width:{{uploadProgress}}%"></view></view><text>{{submitPhaseText}}{{uploadProgress > 0 && uploadProgress < 100 ? ' · ' + uploadProgress + '%' : ''}}</text><text class="cup-note">上传后会自动受理，请不要重复提交</text></view>

        <view class="cl-agree" bindtap="toggleAgree">
          <view class="ca-box {{agreed ? 'on' : ''}}"><native-icon wx:if="{{agreed}}" name="check" tone="white" size="12"></native-icon></view>
          <text class="ca-text">我确认对上传的视频有合法使用权；若视频含人声，同意用于生成基础声音。并同意<text class="ca-link" catchtap="openUsageDoc">《数字分身素材使用说明》</text>。</text>
        </view>
      </block>

      <!-- ③ 训练中 -->
      <block wx:else>
        <view class="cl-progress">
          <text class="cp-num">{{training.percent}}%</text>
          <text class="cp-label">正在学习</text>
        </view>

        <text class="cl-h center">{{mode === 'voice' ? '专属声音正在训练' : '数字分身正在训练'}}</text>
        <text class="cl-s center">{{training.etaText}}。可以先退出，回来会继续显示真实进度。</text>

        <view class="cl-track vd-card">
          <view wx:if="{{mode === 'voice'}}" class="ct-row {{training.voiceDone ? 'done' : 'busy'}}">
            <view class="ct-dot"><native-icon wx:if="{{training.voiceDone}}" name="check" tone="white" size="12"></native-icon></view>
            <text class="ct-label">声音克隆</text>
            <text class="ct-state {{training.voiceFailed ? 'failed' : ''}}">{{training.voiceStateText}}</text>
          </view>
          <view wx:if="{{mode === 'avatar'}}" class="ct-row {{training.imageDone ? 'done' : 'busy'}}">
            <view class="ct-dot"><native-icon wx:if="{{training.imageDone}}" name="check" tone="white" size="12"></native-icon></view>
            <text class="ct-label">形象训练</text>
            <text class="ct-state {{training.imageFailed ? 'failed' : ''}}">{{training.imageStateText}}</text>
          </view>
          <view wx:if="{{mode === 'avatar'}}" class="ct-row optional {{training.voiceDone ? 'done' : 'busy'}}">
            <view class="ct-dot"><native-icon wx:if="{{training.voiceDone}}" name="check" tone="white" size="12"></native-icon></view>
            <view class="ct-copy"><text class="ct-label">视频原声</text><text class="ct-optional">后台增强，不影响形象创建</text></view>
            <text class="ct-state {{training.voiceFailed ? 'failed' : ''}}">{{training.voiceDone ? '已生成' : (training.voiceFailed ? '可稍后补录' : training.voiceStateText)}}</text>
          </view>
        </view>

        <!-- 声音训练好的第一时间就给试听。放在失败提示之前：这是好消息，不该被埋在下面。 -->
        <view wx:if="{{training.voiceDone && voiceId}}" class="cl-hear vd-card">
          <view class="ch-copy">
            <text class="ci-title">你的声音已经好了</text>
            <text class="ci-row">先听一句，确认像不像你本人。听着不对可以重录，不用等做完片子才发现。</text>
          </view>
          <view class="vd-btn ghost cl-hear-btn" bindtap="openVoicePreview">听听看</view>
        </view>

        <view wx:if="{{training.hasFailure}}" class="cl-retry vd-card">
          <text class="ci-title">有一项需要重新采集</text>
          <text class="ci-row">按上面的提示重录即可，已经完成的另一项不用重做。</text>
          <view class="cl-acts retry">
            <view wx:if="{{training.imageFailed}}" class="vd-btn ghost" bindtap="retryImage">重拍形象</view>
            <view wx:if="{{mode === 'voice' && training.voiceFailed}}" class="vd-btn ghost" bindtap="retryVoice">重录声音</view>
          </view>
        </view>

        <view wx:if="{{presetAvailable}}" class="cl-preset vd-card">
          <text class="ci-title">不想等？先做第一条</text>
          <text class="ci-row">用平台提供的形象和声音先出一条片子，你的分身训练好之后，一键换成你自己。</text>
          <view class="vd-btn cl-preset-btn" bindtap="usePreset">先用预置形象出片</view>
        </view>

        <view class="vd-btn ghost {{notificationRequesting ? 'disabled' : ''}}" bindtap="leaveTraining">{{notificationRequesting ? '正在开启通知…' : '训练好通知我 · 返回'}}</view>
      </block>

      <view class="vd-footer-space"></view>
    </view>
  </scroll-view>

  <voice-preview
    open="{{voicePreviewOpen}}"
    voice-id="{{voiceId}}"
    voice-name="{{avatarName}}"
    demo-audio-url="{{voiceDemoUrl}}"
    bindclose="closeVoicePreview"
  ></voice-preview>

  <login-sheet open="{{showLogin}}" reason="execute" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
