<view class="vd vd-home {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="vd-head">
    <view class="vd-safe"></view>
    <view class="vd-headrow">
      <view class="vd-back" bindtap="back"><native-icon name="back" tone="ink" size="22"></native-icon></view>
      <text class="vd-title">快出片</text>
      <text class="vd-headact"> </text>
    </view>
  </view>

  <scroll-view class="vd-scroll" scroll-y enable-flex>
    <view class="vd-body">

      <!-- ① 宣传横幅：落地页的门面。图讲氛围，字讲价值，按钮给出口。 -->
      <view class="banner">
        <!-- 图挂了也不能让门面开天窗：binderror 时落到同色系的 CSS 底纹。 -->
        <image
          wx:if="{{!bannerFailed}}"
          class="banner-art"
          src="/assets/video/promo-banner.png"
          mode="aspectFill"
          lazy-load="{{false}}"
          binderror="onBannerError"
        ></image>
        <view wx:else class="banner-art banner-fallback vd-grain"></view>
        <view class="banner-copy">
          <text class="banner-kicker">数字分身口播视频</text>
          <text class="banner-title">你的店，值得被看见</text>
          <text class="banner-sub">克隆一次形象和声音，之后每条片子三步出完，不用再出镜拍摄。</text>
        </view>
      </view>

      <view class="primary-cta" bindtap="openTemplates">
        <text>挑个模板开拍</text>
        <native-icon name="arrow" tone="white" size="16"></native-icon>
      </view>

      <!-- ② 继续上次：有草稿时意图最强，紧凑一行，不抢横幅的位。 -->
      <view wx:if="{{ongoing}}" class="resume" bindtap="resume">
        <view class="resume-bar"><view class="fill" style="width:{{ongoing.percent}}%"></view></view>
        <view class="resume-row">
          <view class="resume-left">
            <text class="resume-kicker">继续上次</text>
            <text class="resume-title">{{ongoing.templateName}}</text>
          </view>
          <view class="resume-right">
            <text class="resume-step">{{ongoing.stepText}}</text>
            <native-icon name="arrow" tone="red" size="14"></native-icon>
          </view>
        </view>
      </view>

      <!-- ③ 三步流程：一行三格，只讲流程不占高度。 -->
      <view class="steps">
        <view wx:for="{{steps}}" wx:key="key" class="step">
          <text class="step-no">{{index + 1}}</text>
          <text class="step-name">{{item.name}}</text>
          <text class="step-desc">{{item.desc}}</text>
        </view>
      </view>

      <!-- ④ 开拍前置条件：紧凑一行，未就绪才用强调色。 -->
      <view class="gate gate-{{avatarState}}" bindtap="tapAvatarCard">
        <view class="gate-visual">
          <image wx:if="{{avatar && avatar.imagePreviewUrl}}" class="gate-photo" src="{{avatar.imagePreviewUrl}}" mode="aspectFill"></image>
          <native-icon wx:else name="{{avatarState === 'failed' ? 'alert' : 'user'}}" tone="{{avatarState === 'ready' ? 'green' : 'red'}}" size="18"></native-icon>
        </view>
        <view class="gate-body">
          <block wx:if="{{avatarState === 'ready'}}">
            <text class="gate-title">{{avatar.name || '数字分身'}}已就绪</text>
            <text class="gate-sub">{{avatarCount > 1 ? '共 ' + avatarCount + ' 个形象' : '出片会用你自己的形象和声音'}}</text>
          </block>
          <block wx:elif="{{avatarState === 'training'}}">
            <text class="gate-title">数字分身训练中</text>
            <text class="gate-sub">完成会通知你，这期间可以先改文案</text>
          </block>
          <!-- 读失败必须与"确实没有"分开说：说错了会让已有分身的用户去重复创建。 -->
          <block wx:elif="{{avatarState === 'failed'}}">
            <text class="gate-title">分身状态没读到</text>
            <text class="gate-sub">网络没通，点一下重读；这不代表你没有分身</text>
          </block>
          <block wx:else>
            <text class="gate-title">还没有数字分身</text>
            <text class="gate-sub">{{guest ? '登录后上传一段正脸视频即可创建' : '上传一段 5 秒以上正脸视频即可创建'}}</text>
          </block>
        </view>
        <text class="gate-action">{{avatarState === 'ready' ? '管理' : (avatarState === 'training' ? '看进度' : (avatarState === 'failed' ? '重试' : '去创建'))}}</text>
      </view>

      <!-- ⑤ 次级入口 -->
      <view class="entries">
        <view class="entry" bindtap="openTemplates">
          <native-icon name="layers" tone="accent" color-key="{{colorKey}}" size="18"></native-icon>
          <text class="entry-title">模板专区</text>
        </view>
        <view class="entry" bindtap="openWorks">
          <native-icon name="video" tone="red" size="18"></native-icon>
          <text class="entry-title">我的作品</text>
        </view>
        <view class="entry" bindtap="openAssets">
          <native-icon name="image" tone="blue" size="18"></native-icon>
          <text class="entry-title">素材库</text>
        </view>
      </view>

      <view class="vd-footer-space"></view>
    </view>
  </scroll-view>

  <login-sheet open="{{showLogin}}" reason="{{loginReason}}" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
