<view class="vd vd-home {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="vd-head">
    <view class="vd-safe"></view>
    <view class="vd-headrow">
      <view class="hm-brand"><text class="hm-bt">快出片</text><text class="hm-bs">{{shelfText}}</text></view>
    </view>
  </view>

  <!-- 分类条 + 待办铃铛。铃铛不占首屏位置，未读数在角标上 -->
  <view class="hm-catrow">
    <scroll-view class="hm-cats" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="hm-catsin">
        <view wx:for="{{cats}}" wx:key="key" class="hm-cat {{item.on ? 'on' : ''}}" data-key="{{item.key}}" bindtap="pickCat">{{item.label}}</view>
      </view>
    </scroll-view>
    <view class="hm-bell" bindtap="openTodo">
      <view class="hm-bellic"></view>
      <view wx:if="{{todoCount > 0}}" class="hm-badge">{{todoCount}}</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="hm-note">正在读取模板…</view>
  <view wx:elif="{{loadFailed}}" class="hm-note">模板没读出来。<text class="hm-link" bindtap="retry">再试一次</text></view>

  <view wx:else class="hm-feed">
    <view wx:for="{{list}}" wx:key="id" class="hm-card" data-id="{{item.id}}" bindtap="openTemplate">
      <view class="hm-cov {{item.ready ? '' : 'soon'}}">
        <view class="hm-shot {{item.cover}}"></view>
        <text class="hm-ktag">{{item.industry}}</text>
        <text wx:if="{{item.ready}}" class="hm-dur">{{item.durText}}</text>
        <text wx:else class="hm-soon">即将上线</text>
      </view>
      <view class="hm-cb">
        <text class="hm-cbt">{{item.title}}</text>
        <view wx:if="{{item.ready}}" class="hm-meta"><text>数字人出镜 {{item.avatarSec}} 秒</text><text class="b">{{item.credits}} 钻石</text></view>
        <text wx:else class="hm-blocked">{{item.blocked}}</text>
      </view>
    </view>
    <view wx:if="{{!list.length}}" class="hm-empty">这个分类下还没有模板。模板由内容生产线逐套产出，不是配置项。</view>
    <view class="hm-space"></view>
  </view>

  <!-- 待办面板 -->
  <view wx:if="{{todoOpen}}" class="hm-scrim" catchtap="closeTodo">
    <view class="hm-sheet" catchtap="swallow">
      <view class="hm-grab"></view>
      <view class="hm-sh"><text class="hm-sht">待办</text><text class="hm-sha">{{todos.length ? todos.length + ' 件' : '暂时没有'}}</text></view>
      <view wx:for="{{todos}}" wx:key="key" class="hm-ti" data-go="{{item.go}}" bindtap="goTodo">
        <view class="hm-tic {{item.tone}}"></view>
        <view class="hm-tb"><text class="hm-tit">{{item.title}}</text><text class="hm-tis">{{item.sub}}</text></view>
        <text class="hm-tig">{{item.action}}</text>
      </view>
      <view wx:if="{{!todos.length}}" class="hm-tnone">没有要处理的事。挑一套模板开拍吧。</view>
    </view>
  </view>

  <vd-tabbar current="home" bindneedlogin="needLogin"></vd-tabbar>
  <login-sheet open="{{showLogin}}" reason="{{loginReason}}" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
