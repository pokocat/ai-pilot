<view class="vd vd-assets {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="vd-head">
    <view class="vd-safe"></view>
    <view class="vd-headrow">
      <view class="vd-back" bindtap="back"><native-icon name="back" tone="ink" size="22"></native-icon></view>
      <text class="vd-title">{{picking ? '选一张画面' : '我的素材'}}</text>
      <text class="vd-headact" bindtap="upload">上传</text>
    </view>

    <text class="as-note">{{picking ? '点一下，就会配到刚才选中的画面段。' : '你拍过的店铺画面都存在这里，任何模板都能直接用。'}}</text>

    <!-- 容量条：读不到时整块不渲染（storage=null），而不是显示 0 —— 读失败不等于没占用 -->
    <view wx:if="{{storage && !picking}}" class="as-storage {{storage.nearFull ? 'warn' : ''}}">
      <view class="ast-line"><text class="ast-text">已用 {{storage.usedText}} / {{storage.limitText}}</text><text class="ast-count">{{storage.count}} 条</text></view>
      <view class="ast-bar"><view class="fill" style="width:{{storage.percent}}%"></view></view>
      <text wx:if="{{storage.nearFull}}" class="ast-warn">空间快满了，删掉用不上的素材或成片，也可以扩容</text>
      <!-- 扩容价来自服务端（运营后台可配）；价没读到或已买到上限时整块不渲染，不显示编出来的价。 -->
      <view wx:if="{{storage.canExpand}}" class="ast-expand" bindtap="expandStorage">{{expanding ? '处理中…' : storage.expandText}}</view>
    </view>

    <scroll-view class="as-tags" scroll-x enable-flex>
      <view class="as-tagrow">
        <view class="as-tag {{!activeTag ? 'on' : ''}}" data-tag="" bindtap="selectTag">全部 {{assets.length}}</view>
        <view
          wx:for="{{tags}}"
          wx:key="*this"
          class="as-tag {{activeTag === item ? 'on' : ''}}"
          data-tag="{{item}}"
          bindtap="selectTag"
        >{{item}}</view>
      </view>
    </scroll-view>
  </view>

  <scroll-view class="vd-scroll" scroll-y enable-flex>
    <view class="as-body">
      <view wx:if="{{loading}}" class="vd-empty"><text class="s">正在加载…</text></view>

      <view wx:elif="{{!visible.length}}" class="vd-empty">
        <text class="t">还没有素材</text>
        <text class="s">拍一段店里的画面，或者传几张照片 —— 视频和图片都能用来配画面。</text>
        <view class="vd-btn as-empty-btn" bindtap="upload">上传视频或图片</view>
      </view>

      <view wx:else class="as-grid">
        <view class="as-cell as-add" bindtap="upload">
          <native-icon class="ac-plus" name="plus" tone="neutral" size="24"></native-icon>
          <text class="ac-text">拍/上传</text>
        </view>

        <view
          wx:for="{{visible}}"
          wx:key="id"
          class="as-cell"
          data-id="{{item.id}}"
          bindtap="tapAsset"
          bindlongpress="longPressAsset"
        >
          <view class="ac-thumb {{item.previewUrl ? '' : 'vd-grain'}} {{item.tone}}">
            <image wx:if="{{item.previewUrl}}" class="ac-thumb-image" src="{{item.previewUrl}}" mode="aspectFill"></image>
            <!-- 分辨率角标：resolutionText 为空 = 这条素材没有宽高记录（老素材/微信没给），整块不渲染。
                 决不渲染「零乘零」—— 那是把「没测到」说成「0 像素」。宽高与乘号在
                 model.formatResolution 里拼好，wxml 不碰字符串算术（乘号本身也是本目录的违禁字形）。 -->
            <text wx:if="{{item.resolutionText}}" class="ac-res">{{item.resolutionText}}</text>
            <text wx:if="{{item.durationText}}" class="ac-dur">{{item.durationText}}</text>
            <!-- 内置素材属于平台、不属于用户，删不掉也改不了名：不给按钮，比给了再报错好。 -->
            <view wx:if="{{!picking && !item.preset}}" class="ac-del" data-id="{{item.id}}" catchtap="deleteFromCard"><native-icon name="trash" tone="white" size="13"></native-icon></view>
            <view class="ac-preview" data-id="{{item.id}}" catchtap="previewAsset">{{item.kind === 'video' ? '播放' : '预览'}}</view>
          </view>
          <text class="ac-label">{{item.label}}</text>
          <text class="ac-used">{{item.sizeText ? item.sizeText + ' · ' : ''}}{{item.usedCount ? '用过 ' + item.usedCount + ' 次' : '没用过'}}</text>
        </view>
      </view>

      <text wx:if="{{visible.length && !picking}}" class="as-tip">长按可以给素材改标签。配画面那一步会优先推荐标签对得上的素材。</text>

      <view class="vd-footer-space"></view>
    </view>
  </scroll-view>

  <view wx:if="{{previewOpen && previewAsset}}" class="amp-mask" catchtap="closePreview">
    <view class="amp-sheet" catchtap="swallow">
      <view class="amp-head"><view><text class="amp-title">{{previewAsset.label}}</text><text class="amp-sub">{{previewAsset.kind === 'video' ? '视频素材' : '图片素材'}}</text></view><view class="amp-close" bindtap="closePreview"><native-icon name="close" tone="neutral" size="18"></native-icon></view></view>
      <view class="amp-stage">
        <video wx:if="{{previewAsset.kind === 'video'}}" class="amp-video" src="{{previewAsset.contentUrl}}" poster="{{previewAsset.previewUrl}}" controls autoplay show-center-play-btn enable-progress-gesture object-fit="contain"></video>
        <image wx:else class="amp-image" src="{{previewAsset.contentUrl}}" mode="aspectFit" show-menu-by-longpress></image>
      </view>
      <view class="amp-foot"><text>{{previewAsset.kind === 'video' && previewAsset.durationSec ? previewAsset.durationSec + ' 秒' : '双指缩放或长按可保存图片'}}</text><view class="vd-btn ghost" bindtap="closePreview">看完了</view></view>
    </view>
  </view>

  <login-sheet open="{{showLogin}}" reason="video" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
