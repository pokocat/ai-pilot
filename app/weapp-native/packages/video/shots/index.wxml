<view class="vd vd-shots {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="vd-head">
    <view class="vd-safe"></view>
    <view class="vd-headrow">
      <view class="vd-back" bindtap="back"><native-icon name="back" tone="ink" size="22"></native-icon></view>
      <text class="vd-title">给每句话配画面</text>
      <text class="vd-headact" bindtap="preview">预览</text>
    </view>

    <view class="vd-steps">
      <view class="vd-step done"><view class="dot"><native-icon name="check" tone="white" size="11"></native-icon></view><text>改文案</text></view>
      <view class="vd-step-line"></view>
      <view class="vd-step on"><view class="dot">2</view><text>配画面</text></view>
      <view class="vd-step-line"></view>
      <view class="vd-step"><view class="dot">3</view><text>出片</text></view>
    </view>

    <!-- 常驻价格条：切一句就跳一次数字 -->
    <view class="price-bar">
      <view class="pb-main">
        <text class="pb-num">{{credits}}</text>
        <text class="pb-unit">积分</text>
        <view wx:if="{{flash}}" class="pb-flash">
          <text class="pb-delta">{{flash.delta}}</text>
          <text class="pb-flash-text">{{flash.text}}</text>
        </view>
        <view wx:else class="pb-stat">
          <text>成片 {{totalText}}</text>
          <text class="dim">出镜 {{avatarSec}} 秒</text>
        </view>
      </view>
      <text class="pb-hint">分身出镜的时间越长，积分越多；切回配画面就降回来。</text>
    </view>
  </view>

  <scroll-view class="vd-scroll" scroll-y enable-flex>
    <view class="rows">

      <view wx:if="{{loading}}" class="vd-empty"><text class="s">正在打开…</text></view>

      <view
        wx:for="{{rows}}"
        wx:key="no"
        class="row {{item.roleClass}}"
      >
        <text class="row-no">{{item.noText}}</text>

        <view class="row-body">
          <text class="row-text">{{item.text}}</text>

          <view class="row-ctl">
            <!-- 角色标签：点击即切换（固定片段不可切） -->
            <view
              class="vd-tag {{item.roleClass}} {{item.switchable ? 'tappable' : ''}}"
              data-no="{{item.no}}"
              data-switchable="{{item.switchable}}"
              bindtap="toggleRole"
            >
              <text class="sq"></text>
              <text>{{item.roleLabel}}</text>
              <text wx:if="{{item.switchable}}" class="swap">⇄</text>
            </view>

            <text class="row-meta">{{item.metaText}}</text>
          </view>

          <!-- 配画面行：未选素材时给三个入口 -->
          <view
            wx:if="{{item.roleClass === 'broll' && !item.hasAsset}}"
            class="row-pick"
            data-no="{{item.no}}"
            bindtap="pickAsset"
          >
            <native-icon class="rp-plus" name="plus" tone="neutral" size="23"></native-icon>
            <text class="rp-text">拍一张 · 相册 · 我的素材</text>
          </view>

          <!-- 已选素材：显示缩略 + 可换 -->
          <view
            wx:elif="{{item.roleClass === 'broll' && item.hasAsset}}"
            class="row-asset"
            data-no="{{item.no}}"
            bindtap="pickAsset"
          >
            <view class="ra-thumb vd-grain"></view>
            <text class="ra-label">{{item.assetLabel}}</text>
            <text class="ra-change">换一个</text>
          </view>

          <!-- 出镜行：说明这段会用你的形象 -->
          <view wx:elif="{{item.roleClass === 'avatar'}}" class="row-avatar">
            <view class="ra-face"></view>
            <text class="ra-label">分身</text>
          </view>
        </view>
      </view>

      <view class="vd-footer-space"></view>
    </view>
  </scroll-view>

  <view class="vd-footer">
    <view class="vd-btn ghost" bindtap="prev">上一步</view>
    <view class="vd-btn" style="flex:1" bindtap="next">下一步 · 出片</view>
  </view>

  <view wx:if="{{previewOpen}}" class="pv-mask" catchtap="closePreview">
    <view class="pv-sheet" catchtap="swallow">
      <view class="pv-head">
        <view>
          <text class="pv-title">出片前预览</text>
          <text class="pv-sub">按最终顺序核对每句话和画面角色</text>
        </view>
        <view class="pv-close" bindtap="closePreview"><native-icon name="close" tone="white" size="16"></native-icon></view>
      </view>
      <scroll-view class="pv-scroll" scroll-y enable-flex>
        <view wx:for="{{rows}}" wx:key="no" class="pv-row {{item.roleClass}}">
          <view class="pv-frame vd-grain">
            <text class="pv-kind">{{item.roleLabel}}</text>
            <text class="pv-no">{{item.noText}}</text>
          </view>
          <view class="pv-copy">
            <text class="pv-text">{{item.text}}</text>
            <text class="pv-meta">{{item.seconds}} 秒 · {{item.metaText}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="pv-total">预计 {{totalText}} · 分身出镜 {{avatarSec}} 秒 · {{credits}} 积分</view>
      <view class="vd-btn" bindtap="closePreview">核对好了</view>
    </view>
  </view>

  <login-sheet open="{{showLogin}}" reason="execute" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
