<view class="vd vd-shots {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="vd-head">
    <view class="vd-safe"></view>
    <view class="vd-headrow">
      <view class="vd-back" bindtap="back"><native-icon name="back" tone="ink" size="22"></native-icon></view>
      <text class="vd-title">按段落配画面</text>
      <text class="vd-headact" bindtap="preview">预览</text>
    </view>
    <view class="vd-steps">
      <view class="vd-step done"><view class="dot"><native-icon name="check" tone="white" size="11"></native-icon></view><text>改文案</text></view>
      <view class="vd-step-line"></view>
      <view class="vd-step on"><view class="dot">2</view><text>配画面</text></view>
      <view class="vd-step-line"></view>
      <view class="vd-step"><view class="dot">3</view><text>出片</text></view>
    </view>
  </view>

  <scroll-view class="vd-scroll" scroll-y enable-flex>
    <view class="rows">
      <view class="price-bar">
        <view class="pb-copy">
          <text class="pb-kicker">当前方案</text>
          <view class="pb-main"><text class="pb-num">{{credits}}</text><text class="pb-unit">积分</text></view>
        </view>
        <view wx:if="{{flash}}" class="pb-flash"><text class="pb-delta">{{flash.delta}}</text><text class="pb-flash-text">{{flash.text}}</text></view>
        <view wx:else class="pb-stat"><text class="strong">{{totalText}}</text><text>预计成片</text><text class="strong">{{avatarSec}} 秒</text><text>分身出镜</text></view>
      </view>
      <view class="group-tool">
        <view class="gt-icon"><native-icon name="layers" tone="blue" size="21"></native-icon></view>
        <view class="gt-copy"><text class="gt-title">已自动整理成 {{groupCount}} 个画面段</text><text class="gt-sub">在每段右上角调整组合，原文不会被删改</text></view>
      </view>
      <view class="rows-head"><view><text class="rh-kicker">画面清单</text><text class="rh-title">逐段检查</text></view><text class="rh-help">点标签可切换出镜方式</text></view>
      <view wx:if="{{loading}}" class="vd-empty"><text class="s">正在打开…</text></view>
      <view wx:for="{{rows}}" wx:key="id" class="row {{item.roleClass}}">
        <view class="row-body">
          <view class="row-copy-head">
            <view class="row-range"><text class="row-no">{{item.rangeText}}</text><text wx:if="{{item.multi}}" class="row-count">{{item.sentenceCount}} 句共用</text></view>
            <view wx:if="{{item.roleClass !== 'tail'}}" class="row-actions">
              <text wx:if="{{item.multi}}" class="row-action" data-id="{{item.id}}" catchtap="openRange">调整组合</text>
              <text wx:if="{{item.canMergeNext}}" class="row-action muted" data-id="{{item.id}}" catchtap="mergeNext">与下一段合并</text>
            </view>
          </view>
          <text class="row-text">{{item.text}}</text>
          <view class="row-ctl">
            <view class="vd-tag {{item.roleClass}} {{item.switchable ? 'tappable' : ''}}" data-id="{{item.id}}" data-switchable="{{item.switchable}}" bindtap="toggleRole">
              <text class="sq"></text><text>{{item.roleLabel}}</text>
            </view>
            <text class="row-meta">{{item.metaText}}</text>
          </view>
          <view wx:if="{{item.roleClass === 'broll' && !item.hasAsset}}" class="row-pick" data-id="{{item.id}}" bindtap="pickAsset">
            <native-icon class="rp-plus" name="plus" tone="neutral" size="23"></native-icon><text class="rp-text">为这 {{item.sentenceCount}} 句选一个画面</text>
          </view>
          <view wx:elif="{{item.roleClass === 'broll' && item.hasAsset}}" class="row-asset" data-id="{{item.id}}" bindtap="pickAsset">
            <view class="ra-thumb {{item.assetPreviewUrl ? '' : 'vd-grain'}}"><image wx:if="{{item.assetPreviewUrl}}" class="ra-thumb-image" src="{{item.assetPreviewUrl}}" mode="aspectFill"></image></view>
            <view class="ra-copy"><text class="ra-label">{{item.assetDisplayLabel}}</text><text class="ra-sub">{{item.assetTypeText}} · 已用于{{item.rangeText}}</text></view>
            <text class="ra-change">更换</text>
          </view>
          <view wx:elif="{{item.roleClass === 'avatar'}}" class="row-avatar"><view class="ra-face"></view><text class="ra-label">这 {{item.sentenceCount}} 句连续由分身出镜</text></view>
        </view>
      </view>
      <view class="vd-footer-space"></view>
    </view>
  </scroll-view>

  <view class="vd-footer"><view class="vd-btn ghost" bindtap="prev">上一步</view><view class="vd-btn" style="flex:1" bindtap="next">下一步 · 出片</view></view>

  <view wx:if="{{rangeOpen}}" class="range-mask" catchtap="closeRange">
    <view class="range-sheet" catchtap="swallow">
      <view class="range-head"><view><text class="range-title">调整 {{rangeTitle}} 的组合</text><text class="range-sub">{{rangeText}}</text></view><view class="range-close" bindtap="closeRange"><native-icon name="close" tone="neutral" size="18"></native-icon></view></view>
      <scroll-view class="range-list" scroll-y enable-flex>
        <view wx:for="{{rangeRows}}" wx:key="no" class="range-row {{item.selected ? 'selected' : ''}}" data-no="{{item.no}}" bindtap="tapRangeSentence">
          <view class="range-check"><native-icon wx:if="{{item.selected}}" name="check" tone="white" size="12"></native-icon><text wx:else>{{item.no}}</text></view>
          <view class="range-copy-wrap"><text class="range-copy">{{item.text}}</text><text class="range-note">{{item.selected ? '留在这个画面段' : '取消组合 · 将单独成段'}}</text></view>
        </view>
      </scroll-view>
      <view class="range-actions"><view class="vd-btn ghost" bindtap="splitRange">全部拆开</view><view class="vd-btn {{rangeInvalid ? 'disabled' : ''}}" style="flex:1" bindtap="applyRange">保存组合</view></view>
    </view>
  </view>

  <view wx:if="{{previewOpen}}" class="pv-mask" catchtap="closePreview">
    <view class="pv-sheet" catchtap="swallow">
      <view class="pv-head"><view><text class="pv-title">出片前预览</text><text class="pv-sub">按画面段核对，不再逐句切镜头</text></view><view class="pv-close" bindtap="closePreview"><native-icon name="close" tone="neutral" size="18"></native-icon></view></view>
      <scroll-view class="pv-scroll" scroll-y enable-flex>
        <view class="pv-list">
          <view wx:for="{{rows}}" wx:key="id" class="pv-row {{item.roleClass}}">
            <view class="pv-frame {{item.framePreviewUrl ? '' : 'vd-grain'}}"><image wx:if="{{item.framePreviewUrl}}" class="pv-frame-image" src="{{item.framePreviewUrl}}" mode="aspectFill"></image><text class="pv-kind">{{item.roleLabel}}</text><text class="pv-no">{{item.rangeText}}</text></view>
            <view class="pv-copy"><text class="pv-text">{{item.text}}</text><text class="pv-meta">{{item.seconds}} 秒 · {{item.previewMeta}}</text></view>
          </view>
        </view>
      </scroll-view>
      <view class="pv-actions"><view class="pv-total"><text>预计 {{totalText}}</text><text>分身 {{avatarSec}} 秒</text><text>{{credits}} 积分</text></view><view class="vd-btn" bindtap="closePreview">确认画面安排</view></view>
    </view>
  </view>
  <login-sheet open="{{showLogin}}" reason="execute" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
