<view class="vd vd-shots {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="vd-head">
    <view class="vd-safe"></view>
    <view class="vd-headrow">
      <view class="vd-back" bindtap="back"><native-icon name="back" tone="ink" size="22"></native-icon></view>
      <text class="vd-title">按段落配画面</text>
      <text class="vd-headact" bindtap="openStoryboard">分镜清单</text>
    </view>
    <view class="vd-steps">
      <view class="vd-step done"><view class="dot"><native-icon name="check" tone="white" size="11"></native-icon></view><text>改文案</text></view>
      <view class="vd-step-line"></view>
      <view class="vd-step on"><view class="dot">2</view><text>配画面</text></view>
      <view class="vd-step-line"></view>
      <view class="vd-step"><view class="dot">3</view><text>出片</text></view>
    </view>
  </view>

  <scroll-view class="vd-scroll" scroll-y enable-flex>
    <view class="rows">
      <view class="price-bar">
        <view class="pb-copy">
          <text class="pb-kicker">当前方案</text>
          <view class="pb-main"><text class="pb-num">{{credits}}</text><text class="pb-unit">积分</text></view>
        </view>
        <view wx:if="{{flash}}" class="pb-flash"><text class="pb-delta">{{flash.delta}}</text><text class="pb-flash-text">{{flash.text}}</text></view>
        <view wx:else class="pb-stat"><text class="strong">{{totalText}}</text><text>预计成片</text><text class="strong">{{avatarSec}} 秒</text><text>分身出镜</text></view>
      </view>
      <view class="group-tool">
        <view class="gt-icon"><native-icon name="layers" tone="blue" size="21"></native-icon></view>
        <view class="gt-copy"><text class="gt-title">已自动整理成 {{groupCount}} 个画面段</text><text class="gt-sub">在每段右上角调整组合，原文不会被删改</text></view>
      </view>
      <view class="avatar-choice" bindtap="openAvatarPicker">
        <view class="ac-face {{selectedAvatar && selectedAvatar.imagePreviewUrl ? '' : 'vd-grain'}}"><image wx:if="{{selectedAvatar && selectedAvatar.imagePreviewUrl}}" src="{{selectedAvatar.imagePreviewUrl}}" mode="aspectFill"></image></view>
        <view class="ac-copy"><text class="ac-kicker">本片数字人</text><text class="ac-name">{{selectedAvatar ? selectedAvatar.name : '还没有可用数字人'}}</text><text class="ac-voice">{{selectedAvatar && selectedAvatar.linkedVoiceName ? '声音 · ' + selectedAvatar.linkedVoiceName : '未关联声音'}}</text></view>
        <view class="ac-action">{{selectedAvatar ? '更换' : '去创建'}}</view>
      </view>
      <view class="rows-head"><view><text class="rh-kicker">画面清单</text><text class="rh-title">逐段检查</text></view><text class="rh-help">点标签可切换出镜方式</text></view>
      <view wx:if="{{loading}}" class="vd-empty"><text class="s">正在打开…</text></view>
      <view wx:for="{{rows}}" wx:key="id" class="row {{item.roleClass}}">
        <view class="row-body">
          <view class="row-copy-head">
            <view class="row-range"><text class="row-no">{{item.rangeText}}</text><text wx:if="{{item.multi}}" class="row-count">{{item.sentenceCount}} 句共用</text></view>
            <view wx:if="{{item.roleClass !== 'tail'}}" class="row-actions">
              <text wx:if="{{item.multi}}" class="row-action" data-id="{{item.id}}" catchtap="openRange">调整组合</text>
              <text wx:if="{{item.canMergeNext}}" class="row-action muted" data-id="{{item.id}}" catchtap="mergeNext">与下一段合并</text>
            </view>
          </view>
          <text class="row-text">{{item.text}}</text>
          <view class="row-ctl">
            <view class="vd-tag {{item.roleClass}} {{item.switchable ? 'tappable' : ''}}" data-id="{{item.id}}" data-switchable="{{item.switchable}}" bindtap="toggleRole">
              <text class="sq"></text><text>{{item.roleLabel}}</text>
              <native-icon wx:if="{{item.switchable}}" class="tag-swap" name="swap" tone="{{item.roleClass === 'avatar' ? 'accent' : 'blue'}}" color-key="{{colorKey}}" size="12"></native-icon>
            </view>
            <text class="row-meta">{{item.metaText}}</text>
          </view>
          <view wx:if="{{item.roleClass === 'broll' && !item.hasAsset}}" class="row-pick" data-id="{{item.id}}" bindtap="pickAsset">
            <native-icon class="rp-plus" name="plus" tone="neutral" size="23"></native-icon>
            <view class="rp-copy"><text class="rp-text">为这 {{item.sentenceCount}} 句选一个画面</text><text class="rp-need">{{item.needText}} · {{item.pickHint}}</text></view>
          </view>
          <view wx:elif="{{item.roleClass === 'broll' && item.hasAsset}}" class="row-asset">
            <view class="ra-open" data-asset-id="{{item.assetId}}" bindtap="previewSelectedAsset">
              <view class="ra-thumb {{item.assetPreviewUrl ? '' : 'vd-grain'}}"><image wx:if="{{item.assetPreviewUrl}}" class="ra-thumb-image" src="{{item.assetPreviewUrl}}" mode="aspectFill"></image><text class="ra-play">{{item.assetTypeText === '视频素材' ? '播放' : '预览'}}</text></view>
              <view class="ra-copy"><text class="ra-label">{{item.assetDisplayLabel}}</text><text class="ra-sub">{{item.assetTypeText}} · {{item.needText}} · 点开预览</text><text wx:if="{{item.assetTooShort}}" class="ra-short">素材只有 {{item.assetSeconds}} 秒，短于本段 {{item.seconds}} 秒，画面会重复播放</text><text wx:elif="{{item.assetTooLong}}" class="ra-note">素材 {{item.assetSeconds}} 秒，成片只会用前 {{item.seconds}} 秒</text></view>
            </view>
            <text class="ra-change" data-id="{{item.id}}" bindtap="pickAsset">更换</text>
          </view>
          <view wx:elif="{{item.roleClass === 'tail' && item.hasAsset}}" class="row-asset tail-asset" data-asset-id="{{item.assetId}}" bindtap="previewSelectedAsset">
            <view class="ra-thumb {{item.assetPreviewUrl ? '' : 'vd-grain'}}"><image wx:if="{{item.assetPreviewUrl}}" class="ra-thumb-image" src="{{item.assetPreviewUrl}}" mode="aspectFill"></image><text class="ra-play">播放</text></view>
            <view class="ra-copy"><text class="ra-label">{{item.assetDisplayLabel}}</text><text class="ra-sub">固定视频 · {{item.seconds}} 秒 · 点开预览</text></view>
          </view>
          <view wx:elif="{{item.roleClass === 'avatar'}}" class="row-avatar" bindtap="openAvatarPicker"><view class="ra-face"><image wx:if="{{avatarPreviewUrl}}" src="{{avatarPreviewUrl}}" mode="aspectFill"></image></view><view class="ra-avatar-copy"><text class="ra-label">{{selectedAvatar ? selectedAvatar.name : '选择数字人'}}</text><text wx:if="{{item.avatarSpanText}}" class="ra-sub">{{item.avatarSpanText}}</text></view><view class="ra-avatar-swap"><native-icon name="swap" tone="accent" color-key="{{colorKey}}" size="14"></native-icon><text>换数字人</text></view></view>
        </view>
      </view>
      <view class="vd-footer-space"></view>
    </view>
  </scroll-view>

  <view class="vd-footer"><view class="vd-btn ghost" bindtap="prev">上一步</view><view class="vd-btn" style="flex:1" bindtap="next">下一步 · 出片</view></view>

  <view wx:if="{{rangeOpen}}" class="range-mask" catchtap="closeRange">
    <view class="range-sheet" catchtap="swallow">
      <view class="range-head"><view><text class="range-title">调整 {{rangeTitle}} 的组合</text><text class="range-sub">{{rangeText}}</text></view><view class="range-close" bindtap="closeRange"><native-icon name="close" tone="neutral" size="18"></native-icon></view></view>
      <scroll-view class="range-list" scroll-y enable-flex>
        <view wx:for="{{rangeRows}}" wx:key="no" class="range-row {{item.selected ? 'selected' : ''}}" data-no="{{item.no}}" bindtap="tapRangeSentence">
          <view class="range-check"><native-icon wx:if="{{item.selected}}" name="check" tone="white" size="12"></native-icon><text wx:else>{{item.no}}</text></view>
          <view class="range-copy-wrap"><text class="range-copy">{{item.text}}</text><text class="range-note">{{item.selected ? '留在这个画面段' : '取消组合 · 将单独成段'}}</text></view>
        </view>
      </scroll-view>
      <view class="range-actions"><view class="vd-btn ghost" bindtap="splitRange">全部拆开</view><view class="vd-btn {{rangeInvalid ? 'disabled' : ''}}" style="flex:1" bindtap="applyRange">保存组合</view></view>
    </view>
  </view>

  <view wx:if="{{storyboardOpen}}" class="pv-mask" catchtap="closeStoryboard">
    <view class="pv-sheet" catchtap="swallow">
      <view class="pv-head"><view><text class="pv-title">分镜清单</text><text class="pv-sub">这里只核对顺序和画面，成片效果以出片为准</text></view><view class="pv-close" bindtap="closeStoryboard"><native-icon name="close" tone="neutral" size="18"></native-icon></view></view>
      <scroll-view class="pv-scroll" scroll-y enable-flex>
        <view class="pv-list">
          <view wx:for="{{rows}}" wx:key="id" class="pv-row {{item.roleClass}}">
            <view class="pv-frame {{item.framePreviewUrl ? '' : 'vd-grain'}}" data-asset-id="{{item.roleClass === 'broll' ? item.assetId : ''}}" bindtap="previewSelectedAsset"><image wx:if="{{item.framePreviewUrl}}" class="pv-frame-image" src="{{item.framePreviewUrl}}" mode="aspectFill"></image><text class="pv-kind">{{item.roleLabel}}</text><text class="pv-no">{{item.rangeText}}</text><text wx:if="{{item.roleClass === 'broll' && item.hasAsset}}" class="pv-open">点开</text></view>
            <view class="pv-copy"><text class="pv-text">{{item.text}}</text><text class="pv-meta">{{item.seconds}} 秒 · {{item.previewMeta}}</text></view>
          </view>
        </view>
      </scroll-view>
      <view class="pv-actions">
        <view class="pv-total"><text>预计 {{totalText}}</text><text>分身 {{avatarSec}} 秒</text><text>{{credits}} 积分</text></view>
        <view class="pv-btns">
          <view class="vd-btn ghost" bindtap="startPlayback">连着看一遍</view>
          <view class="vd-btn" style="flex:1" bindtap="closeStoryboard">确认画面安排</view>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{playOpen}}" class="pb-mask">
    <view class="pb-sheet">
      <view class="pb-head">
        <view class="pb-headcopy">
          <text class="pb-title">连着看一遍 · 第 {{playIndex + 1}}/{{playTotal}} 段</text>
          <text class="pb-sub">只看画面顺序，没有配音和字幕</text>
        </view>
        <view class="pb-close" bindtap="stopPlayback"><native-icon name="close" tone="white" size="18"></native-icon></view>
      </view>
      <view class="pb-stage">
        <!-- muted 是必需的：成片里 b-roll 的原声会被口播音频顶掉（合成端 -map 1:a:0），
             这里放原声等于给用户一个成片里根本不存在的声音。 -->
        <video wx:if="{{playItem.kind === 'video'}}" id="shots-playback" class="pb-media"
          src="{{playItem.videoUrl}}" object-fit="cover" muted loop autoplay
          controls="{{false}}" show-center-play-btn="{{false}}" show-play-btn="{{false}}"
          show-fullscreen-btn="{{false}}" enable-progress-gesture="{{false}}"></video>
        <image wx:elif="{{playItem.kind === 'image'}}" class="pb-media" src="{{playItem.imageUrl}}" mode="aspectFill"></image>
        <view wx:else class="pb-media pb-blank vd-grain"><text>这一段还没配画面</text></view>
      </view>
      <view class="pb-meta">
        <view class="pb-metarow"><text class="pb-role {{playItem.kind === 'blank' ? 'warn' : ''}}">{{playItem.roleLabel}}</text><text class="pb-range">{{playItem.rangeText}} · {{playItem.seconds}} 秒</text></view>
        <text class="pb-text">{{playItem.text}}</text>
        <text wx:if="{{playItem.note}}" class="pb-note">{{playItem.note}}</text>
      </view>
      <view class="pb-dots"><view wx:for="{{playList}}" wx:key="key" class="pb-dot {{index === playIndex ? 'on' : (index < playIndex ? 'done' : '')}}"></view></view>
      <view class="pb-actions">
        <view class="vd-btn ghost {{playIndex === 0 ? 'disabled' : ''}}" bindtap="playPrev">上一段</view>
        <view class="vd-btn ghost" style="flex:1" bindtap="playSkip">下一段</view>
        <view class="vd-btn ghost" bindtap="stopPlayback">退出</view>
      </view>
    </view>
  </view>

  <view wx:if="{{assetPreviewOpen && previewAsset}}" class="amp-mask" catchtap="closeAssetPreview">
    <view class="amp-sheet" catchtap="swallow">
      <view class="amp-head"><view><text class="amp-title">{{previewAsset.label}}</text><text class="amp-sub">{{previewAsset.kind === 'video' ? '视频素材' : '图片素材'}}</text></view><view class="amp-close" bindtap="closeAssetPreview"><native-icon name="close" tone="neutral" size="18"></native-icon></view></view>
      <view class="amp-stage"><video wx:if="{{previewAsset.kind === 'video'}}" class="amp-video" src="{{previewAsset.contentUrl}}" poster="{{previewAsset.previewUrl}}" controls autoplay show-center-play-btn enable-progress-gesture object-fit="contain"></video><image wx:else class="amp-image" src="{{previewAsset.contentUrl}}" mode="aspectFit" show-menu-by-longpress></image></view>
      <view class="amp-foot"><text>{{previewAsset.kind === 'video' && previewAsset.durationSec ? previewAsset.durationSec + ' 秒' : '素材预览'}}</text><view class="vd-btn ghost" bindtap="closeAssetPreview">看完了</view></view>
    </view>
  </view>
  <view wx:if="{{avatarPickerOpen}}" class="avatar-picker-mask" catchtap="closeAvatarPicker">
    <view class="avatar-picker-sheet" catchtap="swallow">
      <view class="ap-head"><view><text class="ap-title">选择本片数字人</text><text class="ap-sub">形象、场景和装扮可以不同；关联声音会自动带入</text></view><view class="ap-close" bindtap="closeAvatarPicker"><native-icon name="close" tone="neutral" size="18"></native-icon></view></view>
      <scroll-view class="ap-list" scroll-y enable-flex>
        <view wx:for="{{avatars}}" wx:key="id" class="ap-row {{project.avatarId === item.id ? 'selected' : ''}} {{item.imageStatus !== 'ready' ? 'disabled' : ''}}" data-id="{{item.id}}" bindtap="chooseAvatar">
          <view class="ap-photo {{item.imagePreviewUrl ? '' : 'vd-grain'}}"><image wx:if="{{item.imagePreviewUrl}}" src="{{item.imagePreviewUrl}}" mode="aspectFill"></image></view>
          <view class="ap-copy"><text class="ap-name">{{item.name}}</text><text class="ap-meta">{{item.imageStatus === 'ready' ? (item.linkedVoiceName ? '声音 · ' + item.linkedVoiceName : '可用 · 尚未关联声音') : (item.imageStatus === 'training' ? '正在训练' : '暂不可用')}}</text></view>
          <view class="ap-check"><native-icon wx:if="{{project.avatarId === item.id}}" name="check" tone="white" size="12"></native-icon></view>
        </view>
      </scroll-view>
      <view class="ap-new" bindtap="openNewAvatar">+ 新建数字人</view>
    </view>
  </view>
  <login-sheet open="{{showLogin}}" reason="execute" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
