<view class="native-subpage page mp {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="safe-head"><view class="safe-hbtn" bindtap="back"><native-icon name="back" tone="ink" size="24"></native-icon></view><view class="safe-body"><view class="safe-title-wrap"><text class="safe-title serif">命盘报告</text></view></view><view class="safe-spacer"></view></view>
  <scroll-view scroll-y class="generic-scroll" scroll-into-view="{{scrollIntoView}}"><view class="pad route-body">
    <view wx:if="{{disabled}}" class="mp-hero"><text class="mp-hero-t serif">命盘报告暂不可用</text><text class="mp-hero-s">命理视角的推演已暂停。你的战略判断、军令与复盘不受影响，可继续在参谋室与军师对话。</text></view>
    <block wx:elif="{{!authed}}"><view class="mp-hero"><text class="mp-hero-t serif">立你的命盘 · 八字紫微互参</text><text class="mp-hero-s">军师按生辰以算法立盘：四柱旺衰格局、紫微十二宫全盘，再两盘互证。登录后一息可成。</text></view><view class="mp-btn mp-login" bindtap="login"><text>登录 · 立我的命盘</text></view></block>
    <block wx:else>
      <view wx:if="{{report}}" class="mp-head"><view class="mp-seal serif"><text>{{seal}}</text></view><text class="mp-kicker">命盘报告 · 八字紫微印证</text><text class="mp-head-title serif">{{report.bazi.pattern.name}} · {{report.base.gender}}命</text><view class="mp-head-meta"><view class="mp-hm-row"><text class="mp-hm-k">公历</text><text class="mp-hm-v serif">{{report.base.solarDate}}</text></view><view class="mp-hm-row"><text class="mp-hm-k">农历</text><text class="mp-hm-v serif">{{report.base.lunarDate}}</text></view><view wx:if="{{report.base.birthPlace}}" class="mp-hm-row"><text class="mp-hm-k">出生地</text><text class="mp-hm-v serif">{{report.base.birthPlace}}</text></view><view class="mp-hm-row"><text class="mp-hm-k">时辰</text><text class="mp-hm-v serif">{{report.base.hourLabel||'待定 · 三柱推演'}}</text></view></view><view class="mp-badges"><text wx:if="{{report.base.trueSolarApplied}}" class="mp-badge">真太阳时已校正</text><text class="mp-badge">晚子时口径</text><text wx:if="{{!report.base.hourKnown}}" class="mp-badge warn">时辰未定 · 三柱推演</text></view><view wx:if="{{!report.base.trueSolarApplied&&report.base.hourKnown}}" class="mp-truesolar-hint" bindtap="openEditBirth"><text class="mp-tsh-t">按北京时间排盘 · 未做真太阳时校正</text><view class="mp-tsh-s"><text>补出生城市可提升时柱准确度</text><native-icon name="arrow" tone="accent" color-key="{{colorKey}}" size="12"></native-icon></view></view><view class="mp-edit-birth" bindtap="openEditBirth"><view class="mp-eb-t"><text>生辰录错了？修改并重新立盘</text><native-icon name="arrow" tone="neutral" size="12"></native-icon></view></view></view>
      <view wx:elif="{{needBazi||showForm}}" class="mp-hero"><text class="mp-hero-t serif">{{editing?'修改生辰 · 重新立盘':'先录生辰，再为你立盘'}}</text><text class="mp-hero-s">立盘在服务端算法引擎完成，只算一次长期使用；命理内容仅作文化视角参考。</text></view>
      <view wx:elif="{{loaded}}" class="mp-hero"><text class="mp-hero-s">暂未取到命盘，请稍后重试。</text></view>

      <view wx:if="{{showForm}}" id="mingpan-birth-form" class="mp-form"><view class="mp-opts"><view class="mp-opt {{calendar==='solar'?'on':''}}" data-field="calendar" data-value="solar" bindtap="select"><text>阳历</text></view><view class="mp-opt {{calendar==='lunar'?'on':''}}" data-field="calendar" data-value="lunar" bindtap="select"><text>阴历</text></view></view><view class="mp-date"><input class="mp-input mp-y" type="number" value="{{year}}" maxlength="4" placeholder="年" data-field="year" bindinput="input"/><input class="mp-input mp-md" type="number" value="{{month}}" maxlength="2" placeholder="月" data-field="month" bindinput="input"/><input class="mp-input mp-md" type="number" value="{{day}}" maxlength="2" placeholder="日" data-field="day" bindinput="input"/></view><view class="mp-opts mp-option-row"><view wx:for="{{shichen}}" wx:key="index" class="mp-opt {{hourIdx===item.index?'on':''}}" data-field="hourIdx" data-value="{{item.index}}" bindtap="select"><text>{{item.label}}</text></view></view><view class="mp-opts mp-option-row"><view class="mp-opt {{gender==='male'?'on':''}}" data-field="gender" data-value="male" bindtap="select"><text>男</text></view><view class="mp-opt {{gender==='female'?'on':''}}" data-field="gender" data-value="female" bindtap="select"><text>女</text></view></view><input class="mp-input mp-place" value="{{place}}" maxlength="20" placeholder="出生城市（选填，用于真太阳时校正）" data-field="place" bindinput="input"/><view class="mp-btn {{valid&&!busy?'':'off'}}" bindtap="saveBirth"><text>{{busy?'立盘中…':editing?'更新生辰 · 重新立盘':'录入生辰 · 立盘'}}</text></view><view wx:if="{{editing}}" class="mp-form-cancel" bindtap="closeEditBirth"><text>取消</text></view><text class="mp-form-tip">时辰不确定可选「不确定」——八字按三柱推演，紫微须时辰方可立盘。</text><text class="mp-form-tip">出生地越偏离东经 120 度，真太阳时差得越多：成都约差 1 小时，乌鲁木齐超过 2 小时，足以改时柱。</text></view>

      <block wx:if="{{report}}">
        <view class="mp-sec"><view class="mp-sec-h"><text class="mp-kicker">八 字 案 卷</text><text class="mp-sec-title serif">四柱 · 旺衰 · 格局</text></view><view class="mp-card mp-pillars"><view class="mp-pl-row mp-pl-head"><text wx:for="{{report.columns}}" wx:key="label" wx:for-item="column" class="mp-pl-c {{column.day?'day':''}}">{{column.label}}</text></view><view class="mp-pl-row"><text wx:for="{{report.columns}}" wx:key="label" wx:for-item="column" class="mp-pl-c small">{{column.pillar?column.pillar.shiShenGan:'—'}}</text></view><view class="mp-pl-row"><view wx:for="{{report.columns}}" wx:key="label" wx:for-item="column" class="mp-pl-c gz {{column.day?'day':''}}"><text wx:if="{{column.pillar}}" class="serif">{{column.pillar.ganZhi}}</text><text wx:else class="mp-pl-none">时辰待补</text></view></view><view class="mp-pl-row"><view wx:for="{{report.columns}}" wx:key="label" wx:for-item="column" class="mp-pl-c hide"><block wx:if="{{column.pillar}}"><text wx:for="{{column.hides}}" wx:key="key" wx:for-item="hidden" class="mp-hide-item">{{hidden.gan}}<text class="mp-hide-ss">{{hidden.shi}}</text></text></block><text wx:else class="mp-pl-none">—</text></view></view><view class="mp-pl-row"><text wx:for="{{report.columns}}" wx:key="label" wx:for-item="column" class="mp-pl-c tiny">{{column.pillar?column.pillar.naYin:'—'}}</text></view></view>
        <view class="mp-card mp-dm"><view class="mp-dm-top"><text class="mp-dm-gan serif">日主 {{report.bazi.dayMaster.gan}}{{report.bazi.dayMaster.element}}</text><text class="mp-dm-level">{{report.bazi.dayMaster.strength}}{{report.dmMeta?' · '+report.dmMeta:''}}</text></view><text wx:if="{{report.bazi.dayMaster.basis}}" class="mp-dm-basis">据：{{report.bazi.dayMaster.basis}}</text></view>
        <view class="mp-card mp-wuxing"><view class="mp-wx-head"><text class="mp-wx-t">五行分布</text></view><view wx:for="{{report.wuxing}}" wx:key="key" class="mp-wx-row"><text class="mp-wx-k serif">{{item.key}}</text><view class="mp-wx-track"><view class="mp-wx-fill {{item.count===0?'zero':''}}" style="width:{{item.width}}"></view></view><text class="mp-wx-n serif">{{item.count}}</text></view><text class="mp-wx-basis">据：{{report.bazi.wuxingCount.basis}}</text></view>
        <view class="mp-card mp-pattern"><view class="mp-pt-top"><text class="mp-pt-name serif">{{report.bazi.pattern.name}}</text><text wx:if="{{report.bazi.pattern.monthShiShen}}" class="mp-pt-month">月令 {{report.bazi.pattern.monthShiShen}}</text></view><text wx:if="{{report.bazi.pattern.traits}}" class="mp-pt-traits">{{report.bazi.pattern.traits}}</text><view wx:if="{{report.bazi.pattern.suits.length}}" class="mp-chip-row"><text class="mp-chip-lead">宜</text><text wx:for="{{report.bazi.pattern.suits}}" wx:key="*this" class="mp-chip">{{item}}</text></view><view wx:if="{{report.bazi.pattern.avoid.length}}" class="mp-chip-row"><text class="mp-chip-lead avoid">忌</text><text wx:for="{{report.bazi.pattern.avoid}}" wx:key="*this" class="mp-chip avoid">{{item}}</text></view><text wx:if="{{report.bazi.pattern.basis}}" class="mp-pt-basis">据：{{report.bazi.pattern.basis}}</text></view>
        <view class="mp-card mp-favor"><view class="mp-fv-row"><text class="mp-fv-k">喜用</text><view class="mp-chip-row inline"><text wx:for="{{report.bazi.favorableElements}}" wx:key="*this" class="mp-chip accent">{{item}}</text><text wx:if="{{!report.bazi.favorableElements.length}}" class="mp-fv-none">—</text></view></view><view wx:if="{{report.tiaoHouText}}" class="mp-fv-row"><text class="mp-fv-k">调候</text><text class="mp-fv-v">{{report.tiaoHouText}}</text></view></view></view>

        <view class="mp-sec"><view class="mp-sec-h"><text class="mp-kicker">紫 微 斗 数</text><text class="mp-sec-title serif">十二宫全盘</text></view><view wx:if="{{!report.ziwei}}" class="mp-card mp-ziwei-empty"><text class="mp-zw-empty-t serif">紫微须时辰方可立盘</text><text class="mp-zw-empty-s">当前生辰缺时辰，八字已按三柱推演；补录时辰后即可展开十二宫。</text><view class="mp-btn ghost" bindtap="openEditBirth"><text>补录时辰 · 立紫微盘</text></view></view><block wx:else><view class="mp-ziwei-grid"><view wx:for="{{report.ziwei.palaces}}" wx:key="branch" class="mp-pal {{item.className}}" data-index="{{index}}" bindtap="openPalace"><view class="mp-pal-top"><text class="mp-pal-name serif">{{item.name}}</text><text wx:if="{{item.isSoul}}" class="mp-tag soul">命</text><text wx:if="{{item.isBody}}" class="mp-tag body">身</text><text class="mp-pal-gz">{{item.stem}}{{item.branch}}</text></view><view class="mp-pal-majors"><view wx:for="{{item.majors}}" wx:key="name" wx:for-item="star" class="mp-star"><text class="mp-star-n serif">{{star.name}}</text><text wx:if="{{star.brightness}}" class="mp-star-b">{{star.brightness}}</text><text wx:if="{{star.mutagen}}" class="mp-hua {{star.huaClass}}">{{star.mutagen}}</text></view><text wx:if="{{!item.majors.length}}" class="mp-star-empty">空宫</text></view><text wx:if="{{item.minorPreview}}" class="mp-pal-minors">{{item.minorPreview}}</text><text wx:if="{{item.decadalText}}" class="mp-pal-decadal">{{item.decadalText}}</text></view><view class="mp-pal-center"><text class="mp-ct-kicker">中 宫</text><view class="mp-ct-rows"><view class="mp-ct-row"><text class="mp-ct-k">五行局</text><text class="mp-ct-v serif">{{report.ziwei.fiveElementsClass}}</text></view><view class="mp-ct-row"><text class="mp-ct-k">命主</text><text class="mp-ct-v serif">{{report.ziwei.soulStar}}</text></view><view class="mp-ct-row"><text class="mp-ct-k">身主</text><text class="mp-ct-v serif">{{report.ziwei.bodyStar}}</text></view><view class="mp-ct-row"><text class="mp-ct-k">阴阳</text><text class="mp-ct-v serif">{{report.ziwei.yinYang}}</text></view></view></view></view><view class="mp-ziwei-legend"><text class="mp-zl">点按宫格看全量星曜</text><view class="mp-zl-huas"><text class="mp-hua lu">禄</text><text class="mp-hua quan">权</text><text class="mp-hua ke">科</text><text class="mp-hua ji">忌</text></view></view></block></view>

        <view wx:if="{{report.yinzheng}}" class="mp-sec"><view class="mp-sec-h"><text class="mp-kicker">两 盘 印 证</text><text class="mp-sec-title serif">八字与紫微互参</text></view><view class="mp-card mp-axis"><view class="mp-ax-item"><text class="mp-ax-tag">八字轴</text><text class="mp-ax-text">{{report.yinzheng.baziAxis.text}}</text><view wx:if="{{report.yinzheng.baziAxis.basis}}" class="mp-basis" data-key="baziAxis" bindtap="toggleBasis"><text class="mp-basis-k">{{report.yinzheng.baziAxis.open?'收起依据':'查看依据'}}</text><text wx:if="{{report.yinzheng.baziAxis.open}}" class="mp-basis-t">{{report.yinzheng.baziAxis.basis}}</text></view></view><view class="mp-ax-item"><text class="mp-ax-tag">紫微轴</text><text class="mp-ax-text">{{report.yinzheng.ziweiAxis.text}}</text><view wx:if="{{report.yinzheng.ziweiAxis.basis}}" class="mp-basis" data-key="ziweiAxis" bindtap="toggleBasis"><text class="mp-basis-k">{{report.yinzheng.ziweiAxis.open?'收起依据':'查看依据'}}</text><text wx:if="{{report.yinzheng.ziweiAxis.open}}" class="mp-basis-t">{{report.yinzheng.ziweiAxis.basis}}</text></view></view></view><view class="mp-card mp-elemcheck"><view class="mp-ec-top"><text class="mp-ec-t">五行对照</text><text class="mp-ec-badge {{report.yinzheng.elementCheck.aligned?'ok':'off'}}">{{report.yinzheng.elementCheck.aligned?'同气相求':'局用异路'}}</text></view><view class="mp-ec-body"><view class="mp-ec-col"><text class="mp-ec-k">喜用</text><text class="mp-ec-v serif">{{report.yinzheng.favorableText}}</text></view><text class="mp-ec-vs">对</text><view class="mp-ec-col"><text class="mp-ec-k">{{report.yinzheng.elementCheck.ju}}</text><text class="mp-ec-v serif">{{report.yinzheng.elementCheck.juElement}}</text></view></view><text class="mp-ec-note">{{report.yinzheng.elementCheck.note}}</text></view><view wx:if="{{report.yinzheng.sihua.length}}" class="mp-card mp-sihua"><text class="mp-sh-t">生年四化落宫</text><view wx:for="{{report.yinzheng.sihua}}" wx:key="star" class="mp-sh-row"><text class="mp-hua {{item.huaClass}}">{{item.hua}}</text><text class="mp-sh-star serif">{{item.star}}</text><text class="mp-sh-arrow">入</text><text class="mp-sh-palace">{{item.palace}}</text></view></view></view>

        <view wx:if="{{report.yinzheng&&report.yinzheng.timeline.length}}" class="mp-sec"><view class="mp-sec-h"><text class="mp-kicker">大 运 大 限</text><text class="mp-sec-title serif">时间轴对照</text></view><view class="mp-card mp-tl"><view class="mp-tl-row mp-tl-head"><text class="mp-tl-c years">年段</text><text class="mp-tl-c dayun">八字大运</text><text class="mp-tl-c daxian">紫微大限</text></view><view wx:for="{{report.yinzheng.timeline}}" wx:key="years" class="mp-tl-row {{item.isCurrent?'now':''}}"><text class="mp-tl-c years serif">{{item.years}}</text><view class="mp-tl-c dayun"><block wx:if="{{item.daYun}}"><text class="serif mp-tl-gz">{{item.daYun.ganZhi}}</text><text class="mp-tl-sub">{{item.daYun.startAge}}起</text></block><text wx:else class="mp-tl-sub">—</text></view><view class="mp-tl-c daxian"><block wx:if="{{item.daXian}}"><text class="serif mp-tl-gz">{{item.daXian.palace}}</text><text class="mp-tl-sub">{{item.daXian.start}}-{{item.daXian.end}} 岁</text></block><text wx:else class="mp-tl-sub">—</text></view></view></view><view wx:if="{{report.yinzheng.keyYears.length}}" class="mp-card mp-keyyears"><text class="mp-ky-t">关键转折年</text><view wx:for="{{report.yinzheng.keyYears}}" wx:key="year" class="mp-ky-row {{item.overlap?'overlap':''}}"><text class="mp-ky-year serif">{{item.year}}</text><text class="mp-ky-age">{{item.age}} 虚岁</text><text class="mp-ky-reason">{{item.reason}}</text></view><text class="mp-ky-note">重合之年（换运换限同至）宜提前布局、少押重注。</text></view></view>
        <view class="mp-foot"><text class="mp-foot-ver">引擎 {{report.engineVersion}}</text><text class="mp-foot-disc">{{report.disclaimer}}</text></view><button class="mp-share" open-type="share" hover-class="none"><text>转发我的命盘报告</text></button>
      </block>
      <view class="mp-gift" bindtap="openGift"><view class="mp-gift-b"><text class="mp-gift-t serif">送你一卦</text><text class="mp-gift-s">给朋友出一张速写卡，不用对方录生辰</text></view><view class="mp-gift-go"><text>去出卦</text><native-icon name="arrow" tone="accent" color-key="{{colorKey}}" size="13"></native-icon></view></view>
      <text wx:if="{{!report}}" class="mp-copyright">命理内容为文化视角的研究与参考，不构成决策依据；「人谋可以改命」。</text>
    </block><view class="route-bottom-space"></view>
  </view></scroll-view>

  <view wx:if="{{activePalace}}" class="sheet-mask" bindtap="closePalace" catchtouchmove="stop"><view class="sheet-panel mp-sheet" catchtap="stop"><view class="sheet-grip"></view><view class="mp-sheet-head"><text class="mp-kicker">{{activePalace.stem}}{{activePalace.branch}} 宫</text><view class="mp-sheet-title serif"><text>{{activePalace.name}}</text><text wx:if="{{activePalace.isSoul}}" class="mp-tag soul">命</text><text wx:if="{{activePalace.isBody}}" class="mp-tag body">身</text></view><text wx:if="{{activePalace.decadal}}" class="mp-sheet-sub">大限 {{activePalace.decadal.start}}-{{activePalace.decadal.end}} 虚岁</text></view><view class="mp-sheet-body"><view class="mp-sg"><text class="mp-sg-k">主 星</text><view class="mp-sg-body"><text wx:for="{{activePalace.majorStars}}" wx:key="name" class="mp-sg-item serif">{{item.name}}{{item.brightness?'·'+item.brightness:''}}{{item.mutagen?'（'+item.mutagen+'）':''}}</text><text wx:if="{{!activePalace.majorStars.length}}" class="mp-sg-none">无</text></view></view><view class="mp-sg"><text class="mp-sg-k">辅 星</text><view class="mp-sg-body"><text wx:for="{{activePalace.minorStars}}" wx:key="*this" class="mp-sg-item serif">{{item}}</text><text wx:if="{{!activePalace.minorStars.length}}" class="mp-sg-none">无</text></view></view><view class="mp-sg"><text class="mp-sg-k">杂 曜</text><view class="mp-sg-body"><text wx:for="{{activePalace.adjectiveStars}}" wx:key="*this" class="mp-sg-item serif">{{item}}</text><text wx:if="{{!activePalace.adjectiveStars.length}}" class="mp-sg-none">无</text></view></view></view></view></view>
  <login-sheet open="{{showLogin}}" reason="profile" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
