<view class="page command-page {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="native-safe-head"><view class="native-safe-space"></view><view class="native-safe-row"><view class="safe-hbtn" bindtap="back"><native-icon name="back" tone="ink" size="22"></native-icon></view><view class="safe-body"><text class="safe-title serif">{{order ? '第 '+no+' 号军令' : '军令详情'}}</text></view><view class="safe-spacer"></view></view></view>
  <view wx:if="{{loading || failed}}" class="cmd-loading"><text>{{failed ? '军令加载失败，请返回重试' : '加载中…'}}</text><button wx:if="{{failed}}" bindtap="retry">重新读取</button></view>
  <view wx:elif="{{order}}" class="pad command-body"><view class="command-detail"><view class="command-detail-head"><text class="cd-kicker">{{order.headerLabel}}</text><text class="cd-title serif">{{order.text}}</text><text wx:if="{{order.headMeta}}" class="cd-desc">{{order.headMeta}}</text></view><text wx:if="{{order.sourceQuote}}" class="command-source">{{order.sourceQuote}}</text><view wx:if="{{steps.length}}" class="command-step-list"><view wx:for="{{steps}}" wx:key="no" class="command-step"><view class="cs-no"><text>{{item.no}}</text></view><view class="cs-body"><text class="cs-role">{{item.role}}</text><text class="cs-text">{{item.text}}</text></view></view></view><view wx:if="{{metrics.length}}" class="command-metrics"><view wx:for="{{metrics}}" wx:key="index" class="cm-cell"><text class="cm-v serif">{{item.value}}</text><text class="cm-l">{{item.label}}</text></view></view><view class="command-action-card" bindtap="runAction"><text class="ca-tag">下一步</text><text class="ca-label">{{actionLabel}}</text><text class="ca-hint">{{actionHint}}</text></view><view class="command-cta" bindtap="runAction"><native-icon name="check" tone="white" size="16"></native-icon><text>去执行此军令</text></view></view></view>
  <login-sheet open="{{showLogin}}" reason="execute" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
