<view class="native-subpage dossier-page {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="safe-head"><view class="safe-hbtn" bindtap="back"><native-icon name="back" tone="ink" size="24"></native-icon></view><view class="safe-body"><view class="safe-title-wrap"><text class="safe-title serif ds-navtitle">完整履历</text></view></view><view class="safe-spacer"></view></view>
  <view wx:if="{{!report}}" class="generic-scroll ds-empty"><text class="ds-empty-t serif">创始人战略档案</text><text class="ds-empty-d">{{loadError?'完整履历暂时没有加载成功，请检查网络后重试。':'军师把你的资料——档案、对话、案卷、战略——蒸馏成一份完整履历。资料够了会自动为你立档，越全写得越透；也可以现在就手动生成。'}}</text><view class="ds-gen {{loading||!ready?'busy':''}}" bindtap="primaryAction"><text>{{loading?'军师执笔中…':(!ready?'加载中…':loadError?'重新加载':'生成完整履历')}}</text></view></view>
  <scroll-view wx:else scroll-y class="generic-scroll ds-scroll"><view class="ds-cover"><text class="ds-cover-badge">军师参谋部 · 战略档案</text><text class="ds-cover-name serif">{{report.name}}</text><text class="ds-cover-head">{{report.headline}}</text><text wx:if="{{report.verse}}" class="ds-cover-verse serif">「{{report.verse}}」</text></view><view wx:for="{{report.sections}}" wx:key="key" class="ds-sec"><view class="ds-sec-head"><text class="ds-sec-no serif">{{item.no}}</text><view class="ds-sec-tt"><text class="ds-sec-label">{{item.label}}</text><text wx:if="{{item.eyebrow}}" class="ds-sec-eye">{{item.eyebrow}}</text></view></view><block wx:for="{{item.blocks}}" wx:key="key" wx:for-item="block"><text wx:if="{{block.type==='para'}}" class="ds-para">{{block.text}}</text><text wx:elif="{{block.type==='quote'}}" class="ds-quote serif">「{{block.text}}」</text><view wx:elif="{{block.type==='highlight'}}" class="ds-hl {{block.toneClass}}"><text wx:if="{{block.title}}" class="ds-hl-t">{{block.title}}</text><text class="ds-hl-x">{{block.text}}</text></view><view wx:elif="{{block.type==='stats'}}" class="ds-stats"><view wx:for="{{block.items}}" wx:key="key" wx:for-item="stat" class="ds-stat"><text class="ds-stat-v serif">{{stat.value}}</text><text class="ds-stat-l">{{stat.label}}</text></view></view><view wx:elif="{{block.type==='timeline'}}" class="ds-tl"><view wx:for="{{block.items}}" wx:key="key" wx:for-item="entry" class="ds-ti"><text class="ds-ti-time">{{entry.time}}</text><text class="ds-ti-title">{{entry.title}}</text><text wx:if="{{entry.desc}}" class="ds-ti-desc">{{entry.desc}}</text></view></view></block></view><view class="ds-foot"><text class="ds-foot-brand serif">军师参谋部</text><text class="ds-regen" bindtap="regenerate">{{loading?'刷新中…':'刷新履历'}}</text></view></scroll-view>
  <login-sheet open="{{showLogin}}" reason="profile" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
