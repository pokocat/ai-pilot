<view class="page daily-page {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="native-safe-head"><view class="native-safe-space"></view><view class="native-safe-row"><view class="safe-hbtn" bindtap="back"><native-icon name="back" tone="ink" size="22"></native-icon></view><view class="safe-body"><text class="safe-title serif">每日战报</text></view><view class="safe-spacer"></view></view></view>
  <scroll-view scroll-y class="daily-scroll">
    <view wx:if="{{loading}}" class="native-loading"><view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="native-skeleton"></view></view>
    <view wx:elif="{{errorText}}" class="native-state"><text>{{errorText}}</text><button bindtap="retry">重新读取</button></view>
    <block wx:elif="{{report}}"><view class="daily-hero"><text class="daily-kicker">军师参谋部 · 当日经营账本</text><text class="daily-title serif">每日战报</text><text class="daily-date">{{report.dateText}}{{report.casefileTitle ? ' · 案卷《'+report.casefileTitle+'》' : ''}}</text><text class="daily-rank">{{report.rank}} · 连续复盘第 {{report.streak}} 天</text></view>
      <view class="daily-private"><view class="daily-private-dot"></view><text>仅当前登录账号可见，经营数据不会生成公开链接</text></view>
      <view class="daily-scores"><view class="daily-score card"><text class="daily-score-v serif">{{report.done}}/{{report.total}}</text><text class="daily-score-k">军令完成</text></view><view class="daily-score card"><text class="daily-score-v gold serif">{{report.alignText}}</text><text class="daily-score-k">主线对齐</text></view><view class="daily-score card"><text class="daily-score-v small serif">{{report.backfillText}}</text><text class="daily-score-k">今日数据</text></view></view>
      <view class="daily-section card"><text class="daily-section-k">今 日 军 令</text><view wx:for="{{report.orders}}" wx:key="id" class="daily-order"><view class="daily-order-state {{item.done?'done':''}}"><native-icon name="{{item.done?'check':'square'}}" tone="{{item.done?'accent':'neutral'}}" color-key="{{colorKey}}" size="15"></native-icon></view><view class="daily-order-copy"><text class="daily-order-text {{item.done?'done':''}}">{{item.text}}</text><text wx:if="{{item.showAligned}}" class="daily-order-align">{{item.aligned ? '对齐主要矛盾' : '需复盘校准'}}</text></view></view><text wx:if="{{!report.orders.length}}" class="daily-empty">今天还没有军令，先让军师帮你定下最重要的事。</text></view>
      <view wx:if="{{report.backfill}}" class="daily-section card"><text class="daily-section-k">经 营 回 填</text><view class="daily-metrics"><view><text class="daily-metric-v serif">{{report.backfill.leads}}</text><text class="daily-metric-k">线索</text></view><view><text class="daily-metric-v serif">{{report.backfill.consults}}</text><text class="daily-metric-k">咨询</text></view><view><text class="daily-metric-v serif">{{report.backfill.deals}}</text><text class="daily-metric-k">成交</text></view></view></view>
      <view class="daily-quote"><text>「{{report.quote}}」</text></view><view class="daily-foot"><text class="serif">军师参谋部</text><text>今日账本随数据实时更新</text></view>
    </block><view class="daily-bottom"></view>
  </scroll-view>
  <login-sheet open="{{showLogin}}" reason="history" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
