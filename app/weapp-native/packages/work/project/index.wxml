<view class="page project {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="native-safe-head"><view class="native-safe-space"></view><view class="native-safe-row"><view class="safe-hbtn" bindtap="back"><native-icon name="back" tone="ink" size="22"></native-icon></view><view class="safe-body"><text class="safe-title pd-title serif">{{detail ? detail.name : '案卷'}}</text></view><view class="safe-spacer"></view></view></view>
  <view wx:if="{{loading || failed}}" class="pd-loading"><text>{{failed ? '案卷加载失败' : '加载中…'}}</text><view wx:if="{{failed}}" class="pd-retry" bindtap="retry"><text>重试</text></view></view>
  <view wx:elif="{{detail}}" class="pad project-body">
    <view wx:if="{{detail.summary}}" class="pd-summary card"><native-icon name="insight" tone="accent" color-key="{{colorKey}}" size="15"></native-icon><text class="pd-sum-t">{{detail.summary}}</text></view>
    <view class="pd-cta" bindtap="startChat"><native-icon name="spark" tone="white" size="16"></native-icon><text>在本案卷里开新对话</text></view>
    <view class="pd-seg"><view class="seg {{tab==='situation'?'on':''}}" data-tab="situation" bindtap="setTab"><text>战况</text><text class="seg-n">{{detail.counts.sessions}}</text></view><view class="seg {{tab==='plans'?'on':''}}" data-tab="plans" bindtap="setTab"><text>方案</text><text class="seg-n">{{detail.counts.reports}}</text></view><view class="seg {{tab==='materials'?'on':''}}" data-tab="materials" bindtap="setTab"><text>资料</text><text class="seg-n">{{detail.counts.knowledge}}</text></view></view>
    <view wx:if="{{tab==='situation'}}" class="pd-list"><view class="pd-item card" bindtap="goStudio"><view class="pd-ic"><native-icon name="check" tone="accent" color-key="{{colorKey}}" size="16"></native-icon></view><view class="pd-ib"><text class="pd-it">在「执行」承接军令与复盘</text><text class="pd-im">方案定了拆成军令，打卡、回填、复盘都在执行页</text></view><native-icon name="arrow" tone="neutral" size="17"></native-icon></view><text wx:if="{{!detail.sessions.length}}" class="pd-empty">还没有归属本案卷的对话。</text><view wx:for="{{detail.sessions}}" wx:key="id" class="pd-item card" data-id="{{item.id}}" bindtap="openSession"><view class="pd-ic"><native-icon name="{{item.icon}}" tone="accent" color-key="{{colorKey}}" size="16"></native-icon></view><view class="pd-ib"><text class="pd-it">{{item.title}}</text><text class="pd-im">{{item.agentName}} · {{item.snippet}}</text></view><native-icon name="arrow" tone="neutral" size="17"></native-icon></view></view>
    <view wx:elif="{{tab==='plans'}}" class="pd-list"><text wx:if="{{!detail.reports.length}}" class="pd-empty">还没有方案。在对话里产出方案并「存入方案库」，即在此版本化。</text><view wx:for="{{detail.reports}}" wx:key="id" class="pd-item card" data-id="{{item.id}}" bindtap="openReport"><view class="pd-ic"><native-icon name="doc" tone="accent" color-key="{{colorKey}}" size="16"></native-icon></view><view class="pd-ib"><text class="pd-it">{{item.title}}</text><text class="pd-im">{{item.type}} · 更新于 {{item.updatedText}}</text></view><view class="pd-ver"><text>v{{item.currentVersion}}</text></view></view></view>
    <view wx:else class="pd-list"><view class="pd-kadd"><input class="pd-kinput" value="{{knowledgeText}}" placeholder="记一条资料或决策，回车入库" confirm-type="done" bindinput="inputKnowledge" bindconfirm="addKnowledge" /><view class="pd-kbtn {{knowledgeBusy?'busy':''}}" bindtap="addKnowledge"><native-icon name="check" tone="white" size="15"></native-icon></view></view><text wx:if="{{!detail.knowledge.length}}" class="pd-empty">资料库为空。对话里出一份纪要，或在这里手动记录，都会留在这里。</text><view wx:for="{{detail.knowledge}}" wx:key="id" class="pd-kitem card" data-id="{{item.id}}" bindtap="openKnowledge"><view class="pd-ktag"><text>{{item.kindText}}</text></view><view class="pd-kb"><text wx:if="{{item.title}}" class="pd-kt">{{item.title}}</text><text class="pd-kx">{{item.text}}</text></view></view></view>
  </view>
  <login-sheet open="{{showLogin}}" reason="history" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
