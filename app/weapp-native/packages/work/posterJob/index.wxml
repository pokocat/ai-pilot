<view class="poster-job {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="form-header"><view class="form-safe"></view><view class="form-headrow"><view class="form-back" bindtap="back"><native-icon name="back" tone="ink" size="24"></native-icon></view><text class="form-title serif">成品图</text><view class="form-spacer"></view></view></view>
  <view class="pj-pad">
    <view wx:if="{{loading}}" class="pj-loading"><text>正在取出图进度</text></view>
    <view wx:elif="{{loadErr}}" class="pj-empty"><text class="pj-empty-t serif">{{loadErr}}</text><button class="pj-btn ghost" bindtap="reload">重试</button></view>
    <block wx:elif="{{job}}">
      <view wx:if="{{inFlight}}" class="pj-making"><view class="pj-spin"></view><text class="pj-making-t serif">{{progressLabel}}</text><text class="pj-making-d">出图约一分钟，可以先去做别的，回来还在这。</text><view class="pj-stages"><view wx:for="{{stageItems}}" wx:key="stage" class="pj-stage"><view class="pj-dot {{item.active?'on':''}}"></view><text class="pj-stage-t {{item.active?'on':''}}">{{item.label}}</text></view></view><text wx:if="{{timedOut}}" class="pj-note">这次出图时间有点久，结果完成后仍会保存在这里，稍后回来查看。</text><button wx:if="{{canCancel}}" class="pj-btn ghost" bindtap="cancel">{{busy==='cancel'?'取消中':'取消出图'}}</button></view>

      <block wx:if="{{succeeded}}"><view class="pj-canvas"><image wx:if="{{assetUrl}}" class="pj-img" src="{{assetUrl}}" mode="aspectFit" show-menu-by-longpress binderror="imageError"></image><text wx:else class="pj-note">{{assetMissingText}}</text></view><button wx:if="{{!assetUrl}}" class="pj-btn ghost" bindtap="reload">重新获取</button><view class="pj-acts"><button class="pj-act primary" bindtap="saveAlbum"><native-icon class="pj-download-icon" name="upload" tone="white" size="15"></native-icon><text class="pj-act-t on">{{busy==='save'?'保存中':'保存相册'}}</text></button><button class="pj-act ghost" bindtap="shareFriend"><native-icon name="up" tone="iron" size="15"></native-icon><text class="pj-act-t">{{busy==='share'?'准备中':'分享好友'}}</text></button></view><view class="pj-acts"><button wx:if="{{canRevise}}" class="pj-act ghost" bindtap="openRevise"><text class="pj-act-t">改文字</text><text class="pj-act-c">不再扣</text></button><button wx:if="{{canRegenerate}}" class="pj-act ghost" bindtap="openStyle"><text class="pj-act-t">换风格</text><view wx:if="{{price!==null}}" class="pj-cost"><native-icon name="diamond" tone="neutral" size="13"></native-icon><text class="pj-act-c">x{{price}}</text></view></button></view></block>

      <view wx:if="{{failed}}" class="pj-state"><text class="pj-state-t serif">这次没出成</text><text class="pj-state-d">{{job.errorMessage||'出图失败。'}}</text><view wx:if="{{job.refunded}}" class="pj-refund"><text>已退回</text><native-icon name="diamond" tone="neutral" size="13"></native-icon><text>x{{job.creditCost}}</text></view><button class="pj-btn primary" bindtap="submitRegenerate"><text class="pj-btn-t">{{busy==='regen'?'正在发起':'重新生成'}}</text><view wx:if="{{price!==null}}" class="pj-cost light"><native-icon name="diamond" tone="white" size="13"></native-icon><text>x{{price}}</text></view></button></view>
      <view wx:if="{{cancelled}}" class="pj-state"><text class="pj-state-t serif">已取消</text><text class="pj-state-d">这次出图没有继续。</text><view wx:if="{{job.refunded}}" class="pj-refund"><text>已退回</text><native-icon name="diamond" tone="neutral" size="13"></native-icon><text>x{{job.creditCost}}</text></view><button class="pj-btn primary" bindtap="submitRegenerate"><text class="pj-btn-t">{{busy==='regen'?'正在发起':'重新发起'}}</text><view wx:if="{{price!==null}}" class="pj-cost light"><native-icon name="diamond" tone="white" size="13"></native-icon><text>x{{price}}</text></view></button></view>

      <view wx:if="{{panel==='revise'}}" class="pj-panel"><view class="pj-panel-h"><text class="pj-panel-t">改文字</text><view class="pj-panel-x" bindtap="closePanel"><native-icon name="close" tone="neutral" size="18"></native-icon></view></view><text class="pj-panel-d">只重排文案、不重出主视觉，所以不再扣钻石。留空的字段沿用上一版。</text><view class="pj-field"><view class="pj-flabel"><text class="pj-fl">主标题</text><text class="pj-count {{headlineOver?'over':''}}">{{headlineCount}}</text></view><input class="pj-input" value="{{headline}}" placeholder="留空 = 沿用上一版" data-field="headline" bindinput="fieldInput"/><text wx:if="{{errors.headline}}" class="pj-ferr">{{errors.headline}}</text></view><view wx:for="{{proofs}}" wx:key="index" class="pj-field"><view class="pj-flabel"><text class="pj-fl">{{item.label}}</text><text class="pj-count {{item.over?'over':''}}">{{item.count}}</text></view><input class="pj-input" value="{{item.value}}" placeholder="留空 = 沿用上一版" data-index="{{index}}" bindinput="proofInput"/><text wx:if="{{item.err}}" class="pj-ferr">{{item.err}}</text></view><view class="pj-field"><view class="pj-flabel"><text class="pj-fl">行动号召</text><text class="pj-count {{ctaOver?'over':''}}">{{ctaCount}}</text></view><input class="pj-input" value="{{cta}}" placeholder="留空 = 沿用上一版" data-field="cta" bindinput="fieldInput"/><text wx:if="{{errors.cta}}" class="pj-ferr">{{errors.cta}}</text></view><text wx:if="{{errors.form}}" class="pj-ferr">{{errors.form}}</text><button class="pj-btn primary" bindtap="submitRevise"><text class="pj-btn-t">{{busy==='revise'?'正在重排':'重排这一版'}}</text></button></view>

      <view wx:if="{{panel==='style'}}" class="pj-panel"><view class="pj-panel-h"><text class="pj-panel-t">换风格</text><view class="pj-panel-x" bindtap="closePanel"><native-icon name="close" tone="neutral" size="18"></native-icon></view></view><text class="pj-panel-d">重出主视觉，会再扣一次钻石。旧版本不会被覆盖，随时能回看。</text><view wx:if="{{templates.length}}" class="pj-field"><view class="pj-flabel"><text class="pj-fl">版式</text></view><view class="pj-tpls"><view wx:for="{{templates}}" wx:key="key" class="pj-tpl {{templateKey===item.key?'on':''}}" data-key="{{item.key}}" bindtap="chooseTemplate"><view class="pj-tpl-h"><text class="pj-tpl-n">{{item.name}}</text><native-icon wx:if="{{templateKey===item.key}}" name="check" tone="green" size="14"></native-icon></view><text class="pj-tpl-d">{{item.desc}}</text></view></view></view><view class="pj-field"><view class="pj-flabel"><text class="pj-fl">视觉方向</text><text class="pj-count {{visualOver?'over':''}}">{{visualCount}}</text></view><textarea class="pj-area" value="{{visual}}" placeholder="留空 = 沿用上一版；只写画面属性" data-field="visual" bindinput="fieldInput"></textarea><text wx:if="{{errors.visual}}" class="pj-ferr">{{errors.visual}}</text></view><text wx:if="{{errors.form}}" class="pj-ferr">{{errors.form}}</text><button class="pj-btn primary" data-panel="1" bindtap="submitRegenerate"><text class="pj-btn-t">{{busy==='regen'?'正在发起':'重出主视觉'}}</text><view wx:if="{{price!==null}}" class="pj-cost light"><native-icon name="diamond" tone="white" size="13"></native-icon><text>x{{price}}</text></view></button></view>

      <button wx:if="{{job.parentJobId}}" class="pj-prev" bindtap="openParent"><native-icon name="back" tone="green" size="14"></native-icon><text>查看上一版</text></button>
    </block>
  </view>
  <login-sheet open="{{showLogin}}" reason="view-history" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
