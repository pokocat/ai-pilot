<view class="page projects {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="native-safe-head"><view class="native-safe-space"></view><view class="native-safe-row"><view class="safe-hbtn" bindtap="back"><native-icon name="back" tone="ink" size="22"></native-icon></view><view class="safe-body"><text class="safe-title pj-title serif">我的案卷</text></view><view class="safe-hbtn" bindtap="toggleCreate"><native-icon name="plus" tone="accent" color-key="{{colorKey}}" size="21"></native-icon></view></view></view>
  <view wx:if="{{creating}}" class="pj-new"><input class="pj-new-input" value="{{newName}}" placeholder="新建案卷名，如「2026 融资冲刺」" confirm-type="done" bindinput="inputName" bindconfirm="create" focus /><view class="pj-new-btn {{busy?'busy':''}}" bindtap="create"><text>{{busy ? '创建中…' : '创建'}}</text></view></view>
  <view class="pad projects-body">
    <view wx:if="{{loading && !items.length}}" class="native-loading"><view wx:for="{{[1,2,3]}}" wx:key="*this" class="native-skeleton"></view></view>
    <view wx:elif="{{errorText}}" class="native-state"><text>{{errorText}}</text><button bindtap="retry">重新读取</button></view>
    <view wx:elif="{{!items.length}}" class="pj-empty"><view class="e-ic"><native-icon name="layers" tone="accent" color-key="{{colorKey}}" size="22"></native-icon></view><text class="et">还没有案卷</text><text class="es">把一次融资、一个新品上市、一次组织调整建成「案卷」，对话、方案、资料都会有序归拢到这里。</text><view class="es-btn" bindtap="toggleCreate"><text>新建第一份案卷</text></view></view>
    <view wx:else class="pj-list"><view wx:for="{{items}}" wx:key="id" class="pj-item card" data-id="{{item.id}}" bindtap="open"><view class="pj-ic"><native-icon name="{{item.icon || 'layers'}}" tone="accent" color-key="{{colorKey}}" size="20"></native-icon></view><view class="pj-b"><text class="pj-n">{{item.name}}</text><text wx:if="{{item.summary}}" class="pj-s">{{item.summary}}</text><view class="pj-counts"><text class="pj-c"><text class="num">{{item.counts.sessions}}</text> 对话</text><text class="pj-c"><text class="num">{{item.counts.reports}}</text> 方案</text><text class="pj-c"><text class="num">{{item.counts.knowledge}}</text> 资料</text></view></view><native-icon name="arrow" tone="neutral" size="17"></native-icon></view></view>
  </view>
  <login-sheet open="{{showLogin}}" reason="history" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
