<view class="page market-page {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="native-safe-head"><view class="native-safe-space"></view><view class="native-safe-row"><view class="safe-hbtn" bindtap="back"><native-icon name="back" tone="ink" size="22"></native-icon></view><view class="safe-body"><text class="safe-title serif">能力市场</text></view><view class="safe-spacer"></view></view></view>
  <view class="pad market-body">
    <view wx:if="{{prescription}}" class="rx-card card"><text class="rx-k">军师为「{{prescription.problem}}」开出</text><text class="rx-title">{{prescription.playbook}}</text><view class="rx-action" bindtap="activatePrescription"><text>{{busy ? '启用中…' : '开通完成 · 回执行'}}</text></view></view>
    <view class="mm-hero card"><text class="kicker">Junshi OS</text><text class="h1">能力市场</text><text class="mm-p">能力不是商品货架，而是军师方案的长期承接：基础能力直接用，深度能力按算力额度或方案权益启用。</text><view class="mm-legend"><text class="mm-tag">基础可用</text><view class="mm-tag"><native-icon name="diamond" tone="accent" color-key="{{colorKey}}" size="12"></native-icon><text>按次产出</text></view><text class="mm-tag">方案权益</text><text class="mm-tag">已启用</text></view></view>
    <scroll-view scroll-x class="cat-scroll" enhanced show-scrollbar="false"><view wx:for="{{categories}}" wx:key="*this" class="cat {{category===item?'on':''}}" data-category="{{item}}" bindtap="chooseCategory"><text>{{item}}</text></view></scroll-view>
    <view class="sec-head"><text class="sec-title">方案能力</text><text class="sec-more">启用后由对应军师承接</text></view>
    <view wx:for="{{modules}}" wx:key="id" class="module-card card" data-id="{{item.id}}" bindtap="tapModule"><view class="module-ic"><native-icon name="{{item.icon}}" tone="accent" color-key="{{colorKey}}" size="18"></native-icon></view><view class="module-b"><view class="module-top"><text class="module-cat">{{item.category}}</text><view class="module-tier tier-{{item.tier}}"><native-icon wx:if="{{item.priceIcon}}" name="diamond" tone="gold" size="11"></native-icon><text>{{item.price}}</text></view></view><text class="module-t">{{item.title}}</text><text class="module-d">{{item.desc}}</text><view class="module-foot"><text>{{item.placement}}</text><text>{{item.depth}}</text></view></view><view class="module-btn"><text>{{item.actionText}}</text></view></view>
    <view class="sec-head"><text class="sec-title">锦囊市场</text><text class="sec-more">军师用得上的方法能力包</text></view>
    <view class="skill-grid"><view wx:for="{{skills}}" wx:key="id" class="skill-card card" data-id="{{item.id}}" bindtap="tapSkill"><view class="skill-head"><view class="skill-ic"><native-icon name="{{item.icon}}" tone="accent" color-key="{{colorKey}}" size="16"></native-icon></view><view class="module-tier tier-{{item.tier}}"><native-icon wx:if="{{item.costIcon}}" name="diamond" tone="gold" size="11"></native-icon><text>{{item.cost}}</text></view></view><text class="skill-t">{{item.title}}</text><text class="skill-d">{{item.desc}}</text><text class="skill-s">{{item.status}}</text></view></view>
    <view class="mm-action" bindtap="askArrange"><native-icon name="spark" tone="white" size="16"></native-icon><text>让总军师帮我编排能力</text></view>
  </view>
  <login-sheet open="{{showLogin}}" reason="execute" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
