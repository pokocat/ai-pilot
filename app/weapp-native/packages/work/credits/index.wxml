<view class="page credits-page {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="native-safe-head"><view class="native-safe-space"></view><view class="native-safe-row"><view class="safe-hbtn" bindtap="back"><native-icon name="back" tone="ink" size="22"></native-icon></view><view class="safe-body"><text class="safe-title serif">算力明细</text></view><view class="safe-spacer"></view></view></view>
  <view class="pad credits-body">
    <view class="cd-hero"><text class="cd-k">算力 · 启用专项顾问</text><view class="cd-vrow"><native-icon name="diamond" tone="accent" color-key="{{colorKey}}" size="20"></native-icon><text class="cd-v serif">{{creditBalance}}</text></view><view class="cd-quota"><view class="cd-qhead"><text class="cd-ql">本月算力</text><text class="cd-qv serif">{{usageText}}</text></view><view class="cd-track"><view class="cd-fill" style="width:{{usagePercent}}%"></view></view></view></view>
    <view wx:if="{{loading}}" class="native-loading"><view wx:for="{{[1,2,3]}}" wx:key="*this" class="native-skeleton"></view></view>
    <view wx:elif="{{errorText}}" class="native-state"><text>{{errorText}}</text><button bindtap="retry">重新读取</button></view>
    <block wx:else><text class="cd-sech serif">算力消耗明细</text><text class="cd-secs">启用顾问 / 出图 / 充值赠送</text><text wx:if="{{!items.length}}" class="cd-empty">还没有算力记录。启用顾问或充值后就有了。</text><view wx:else class="cd-list"><view wx:for="{{items}}" wx:key="index" class="cd-row"><view class="cd-rl"><text class="cd-rt">{{item.reason}}</text><text class="cd-rat">{{item.atText}}</text></view><text class="cd-rd serif {{item.positive?'pos':'neg'}}">{{item.deltaText}}</text></view></view>
      <block wx:if="{{orders.length}}"><text class="cd-sech serif">支付订单</text><text class="cd-secs">微信支付记录 · 待支付订单可在时限内继续支付</text><view class="cd-list"><view wx:for="{{orders}}" wx:key="outTradeNo" class="cd-row"><view class="cd-rl"><text class="cd-rt">{{item.itemName}}</text><text class="cd-rat">{{item.statusText}}</text></view><view class="cd-ord-r"><text class="cd-rd serif {{item.bad?'neg':'pos'}}">{{item.amountText}}</text><view wx:if="{{item.payable}}" class="cd-repay" data-id="{{item.outTradeNo}}" bindtap="repay"><text>{{repaying===item.outTradeNo ? '拉起中…' : item.actionText}}</text></view></view></view></view></block>
      <view class="credits-plan" bindtap="goPlans"><native-icon name="crown" tone="accent" color-key="{{colorKey}}" size="18"></native-icon><text>查看方案与权益</text><native-icon name="arrow" tone="neutral" size="17"></native-icon></view>
    </block>
  </view>
  <login-sheet open="{{showLogin}}" reason="purchase" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
