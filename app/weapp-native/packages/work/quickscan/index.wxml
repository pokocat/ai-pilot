<view class="native-subpage qs-page {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view class="safe-head"><view class="safe-hbtn" bindtap="back"><native-icon name="back" tone="ink" size="24"></native-icon></view><view class="safe-body"><view class="safe-title-wrap"><text class="safe-title serif">速诊</text></view></view><view class="safe-spacer"></view></view>
  <scroll-view scroll-y class="generic-scroll qs-scroll"><view wx:if="{{!result}}" class="qs-form"><view class="qs-hero"><text class="qs-hero-t">{{prefilled&&!editBasics?'补一句最痛的事，拿你的初诊':'3 个问题，拿到你的初诊'}}</text><text class="qs-hero-d">主要矛盾 · 军师判断 · 今天就能做的一件事</text></view><view wx:if="{{prefilled&&!editBasics}}" class="qs-q"><view class="qs-basics"><view class="qs-basics-main"><text class="qs-basics-t">行业：{{industry}} · 阶段：{{revenueBand}}</text><text class="qs-basics-note">来自你的档案</text></view><text class="qs-basics-edit" bindtap="editBasics">重新选</text></view></view><block wx:else><view class="qs-q"><text class="qs-qt">1. 你的行业</text><view class="qs-chips"><view wx:for="{{industryOpts}}" wx:key="*this" class="qs-chip {{industry===item?'on':''}}" data-value="{{item}}" bindtap="selectIndustry"><text>{{item}}</text></view></view></view><view class="qs-q"><text class="qs-qt">2. 当前阶段 / 年营收段</text><view class="qs-chips"><view wx:for="{{bandOpts}}" wx:key="*this" class="qs-chip {{revenueBand===item?'on':''}}" data-value="{{item}}" bindtap="selectStage"><text>{{item}}</text></view></view></view></block><view class="qs-q"><text class="qs-qt">3. 当前最痛的一件事</text><textarea class="qs-pain" maxlength="200" placeholder="一句话说清眼下最卡你的那件事" bindinput="inputPain"></textarea></view><view class="qs-submit {{industry&&revenueBand&&painReady&&!busy?'':'off'}}" bindtap="submit"><text>{{busy?'军师研判中…':'出初诊卡'}}</text></view></view><view wx:else class="qs-result"><view class="qs-card"><view class="qs-block"><text class="qs-label">主要矛盾</text><text class="qs-main">{{result.contradiction}}</text></view><view class="qs-block"><text class="qs-label">军师判断</text><text class="qs-body">{{result.judgement}}</text></view><view class="qs-block"><text class="qs-label">今天就做这一件</text><text class="qs-body">{{result.firstMove}}</text></view><view class="qs-brand"><text>军师参谋部 · 初诊</text></view></view><view class="qs-cta" bindtap="enterWarRoom"><text>继续问策，完善这份判断</text><native-icon name="arrow" tone="accent" color-key="{{colorKey}}" size="14"></native-icon></view><button class="qs-share" open-type="share" hover-class="none"><text>分享给同行</text></button><view class="qs-again" bindtap="again"><text>换个问题再诊一次</text></view></view></scroll-view>
  <login-sheet open="{{showLogin}}" reason="execute" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
