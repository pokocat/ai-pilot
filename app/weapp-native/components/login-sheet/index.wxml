<view wx:if="{{open}}" class="login" catchtap="close">
  <view class="lg-bg">
    <view class="lg-blob lg-b1"></view><view class="lg-blob lg-b2"></view><view class="lg-blob lg-b3"></view>
    <text class="lg-wm serif">謀</text>
  </view>
  <view class="lg-content" style="--lg-close-top:{{closeTop}}px;--lg-close-right:{{closeRight}}px" catchtap="stop">
    <view wx:if="{{stage !== 'complete'}}" class="lg-close" bindtap="close"><native-icon name="close" tone="white" size="21"></native-icon></view>

    <block wx:if="{{stage === 'wechat'}}">
      <view class="lg-hero">
        <image class="lg-mk" src="/assets/logo.png" mode="aspectFit"></image>
        <view class="lg-name"><text class="lg-name-ai">AI</text><text class="lg-name-cn serif"> 军师</text></view>
        <view class="lg-rule"></view>
        <text class="lg-slogan serif">谋定而后动，决胜千里之外</text>
        <text class="lg-tag">你的随身 AI 商业军师</text>
      </view>
      <view class="lg-actions">
        <text class="lg-reason">{{reasonText}}</text>
        <button wx:if="{{agreed}}" class="lg-wechat {{busy ? 'off' : ''}}" open-type="getPhoneNumber" bindgetphonenumber="submitWechatPhone">
          <text class="lg-wechat-t">{{busy ? '登录中…' : '手机号快捷登录'}}</text>
        </button>
        <button wx:else class="lg-wechat {{busy ? 'off' : ''}}" bindtap="ensureAgreed">
          <text class="lg-wechat-t">手机号快捷登录</text>
        </button>
        <view class="lg-switch" bindtap="switchPhone"><text>手机号验证码登录</text><native-icon name="arrow" tone="green" size="14"></native-icon></view>
        <view class="lg-consent">
          <view class="lg-cbox {{agreed ? 'on' : ''}}" bindtap="toggleAgree"><native-icon wx:if="{{agreed}}" name="check" tone="brand" size="12"></native-icon></view>
          <text class="lg-agree">我已阅读并同意<text class="lg-link" bindtap="openAgreement">《用户协议》</text>与<text class="lg-link" bindtap="openPrivacy">《隐私政策》</text></text>
        </view>
      </view>
    </block>

    <block wx:elif="{{stage === 'phone'}}">
      <view class="lg-form">
        <text class="lg-kicker">AI 军师</text><text class="lg-h serif">手机号登录</text>
        <text class="lg-sub">仅在你主动选择此方式时收集手机号；未注册将自动创建账号</text>
        <view class="lg-field"><text class="lg-pre">+86</text><input class="lg-input" type="number" maxlength="11" value="{{phone}}" placeholder="请输入手机号" placeholder-class="lg-ph" bindinput="inputPhone" /></view>
        <view class="lg-field"><input class="lg-input" type="number" maxlength="6" value="{{code}}" placeholder="验证码" placeholder-class="lg-ph" bindinput="inputCode" /><text class="lg-code {{sent > 0 || codeSending ? 'off' : ''}}" bindtap="sendCode">{{sent > 0 ? sent + 's' : (codeSending ? '发送中…' : '获取验证码')}}</text></view>
        <button class="lg-cta {{busy ? 'off' : ''}}" bindtap="submitPhone"><text>{{busy ? '登录中…' : '登录 / 注册'}}</text></button>
      </view>
      <view class="lg-actions">
        <view class="lg-switch" bindtap="switchWechat"><text>返回手机号快捷登录</text></view>
        <view class="lg-consent"><view class="lg-cbox {{agreed ? 'on' : ''}}" bindtap="toggleAgree"><native-icon wx:if="{{agreed}}" name="check" tone="brand" size="12"></native-icon></view><text class="lg-agree">我已阅读并同意<text class="lg-link" bindtap="openAgreement">《用户协议》</text>与<text class="lg-link" bindtap="openPrivacy">《隐私政策》</text></text></view>
      </view>
    </block>

    <block wx:else>
      <view class="lg-form lg-complete">
        <text class="lg-kicker">初 次 入 部</text><text class="lg-h serif">先让军师认得你</text>
        <text class="lg-sub">手机号已在登录时完成绑定；这里补充称呼，头像可选，之后都可以修改。</text>
        <view class="lg-av-wrap">
          <button class="lg-av-btn" open-type="chooseAvatar" bindchooseavatar="chooseAvatar">
            <image wx:if="{{avatarShown}}" class="lg-av" src="{{avatarShown}}" mode="aspectFill"></image>
            <view wx:else class="lg-av lg-av-ph"><native-icon name="user" tone="white" size="27"></native-icon></view>
            <view class="lg-av-cam"><native-icon name="image" tone="brand" size="13"></native-icon></view>
          </button>
          <text class="lg-av-tip">点头像可设置（可选）</text>
        </view>
        <view class="lg-field"><input class="lg-input" type="nickname" maxlength="20" value="{{nickname}}" focus="{{nameFocus}}" placeholder="填写称呼" placeholder-class="lg-ph" bindinput="inputNickname" bindblur="blurNickname" /></view>
        <view class="lg-cta {{busy ? 'off' : ''}}" bindtap="finishComplete"><text>{{busy ? '保存中…' : '完成并开始入局'}}</text></view>
        <text class="lg-skip lg-skip-weak" bindtap="logoutComplete">退出登录</text>
      </view>
    </block>
  </view>
</view>
