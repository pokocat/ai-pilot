<view class="native-page {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view wx:if="{{showBackendEnvironmentBadge}}" class="native-env-badge {{isMock ? 'is-switchable' : ''}}" bindtap="switchMockProfile"><text>{{backendEnvironmentLabel}}</text><text wx:if="{{isMock}}"> · {{mockProfileLabel}}</text></view>
  <scroll-view scroll-y enhanced show-scrollbar="false" class="native-scroll">
    <view class="native-nav-inset"></view>
    <view class="pad pouch">
      <!-- 锦囊主体已内联进今日页尾，这页是它的档案柜，所以返回落回今日。 -->
      <view class="pouch-back" bindtap="back"><native-icon name="back" tone="neutral" size="18"></native-icon><text>返回今日</text></view>
      <tab-header title="锦囊" kicker="做过的都在这" glyph="计"></tab-header>

      <!-- 游客态：锦囊装的是你自己的成品，游客本来只能看到一排空架子。
           与图籍同一口径（个人私产页要登录）；主线仍留给游客——问策本地开场、战局有游客引导。 -->
      <block wx:if="{{!authed}}">
        <view class="pouch-guest card">
          <text class="pg-t serif">锦囊要登录后才看得见</text>
          <text class="pg-d">方案、海报、成片都是军师替你出的成品，属于你的账号私产。登录后这里会按时间列出你做过的每一件，随时翻出来分享或照着再来一件。</text>
          <view class="pg-go" bindtap="askLogin"><native-icon name="user" tone="white" size="16"></native-icon><text>登录后打开锦囊</text></view>
        </view>
      </block>

      <block wx:else>
      <view wx:if="{{loadFailed}}" class="pch-retry card" bindtap="retry">
        <text class="pch-retry-t">有作品没读出来，网络不畅或服务端在忙</text>
        <text class="pch-retry-go">重试</text>
      </view>

      <!-- 检索：搜索 + 带计数的类型筛选。都在端上本地过滤，不重新取数。
           搜索框样式与问策页 council-search 同源（连图标都用它那枚 target）。 -->
      <view class="pch-search">
        <native-icon name="target" tone="neutral" size="14"></native-icon>
        <input class="pch-input" value="{{query}}" placeholder="搜标题、出处 · 翻出做过的东西" bindinput="inputQuery" />
        <view wx:if="{{query}}" class="pch-clear" bindtap="clearQuery"><native-icon name="close" tone="neutral" size="12"></native-icon></view>
      </view>
      <view class="pch-seg">
        <view wx:for="{{tabs}}" wx:key="key" class="pch-seg-item {{typeIndex===index?'on':''}}" data-index="{{index}}" bindtap="selectType">{{item.text}}</view>
      </view>

      <!-- 取数中：给一排骨架卡。三条通道里 /video/works 是服务端到 aidrama 的同步代理
           （上游预算 15–60s），首次进来就是这一态——不能是一屏纯白。 -->
      <block wx:if="{{loading && !groups.length}}">
        <view class="pch-wall">
          <view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="pch-work card pch-sk">
            <view class="pch-w-thumb"></view>
            <view class="pch-sk-line"></view>
            <view class="pch-sk-line short"></view>
          </view>
        </view>
      </block>

      <block wx:else>
        <block wx:for="{{groups}}" wx:key="key" wx:for-item="group" wx:for-index="gidx">
          <text class="pch-glabel">{{group.label}}</text>
          <view class="pch-wall">
            <view wx:for="{{group.items}}" wx:key="key" class="pch-work card" data-group="{{gidx}}" data-item="{{index}}" bindtap="openWork">
              <view class="pch-w-thumb">
                <image class="pch-w-img" src="{{item.thumb}}" mode="aspectFill" lazy-load data-group="{{gidx}}" data-item="{{index}}" binderror="onThumbError"></image>
                <text class="pch-w-tag {{item.typeClass}}">{{item.typeLabel}}</text>
              </view>
              <text class="pch-w-t">{{item.title}}</text>
              <view class="pch-w-foot">
                <text class="pch-w-from">{{item.from}} · {{item.time}}</text>
                <view class="pch-w-verb"><text>{{item.verb}}</text><native-icon name="arrow" tone="accent" color-key="{{colorKey}}" size="11"></native-icon></view>
              </view>
            </view>
          </view>
        </block>

        <view wx:if="{{hiddenCount}}" class="pch-more card" bindtap="expand">
          <native-icon name="clock" tone="neutral" size="16"></native-icon>
          <text class="pch-more-t">更早的 {{hiddenCount}} 件 · 按时间往下翻</text>
          <native-icon name="chevron" tone="neutral" size="14"></native-icon>
        </view>

        <!-- 空态分两种：筛出来的空 ≠ 一件都没有。读失败时两种都不出（上面已有重试条）。 -->
        <view wx:if="{{empty && filtered && !loadFailed}}" class="pouch-empty card">
          <text class="pe-t serif">没有对上的作品</text>
          <text class="pe-d">换个词，或者把筛选清掉再看一遍。</text>
          <view class="pe-go" bindtap="resetFilters"><text>清掉筛选</text><native-icon name="arrow" tone="green" size="14"></native-icon></view>
        </view>
        <view wx:elif="{{empty && !filtered && !loadFailed}}" class="pouch-empty card">
          <text class="pe-t serif">还没有作品</text>
          <text class="pe-d">今日页最下面那段就是锦囊：挑一门手艺开工，方案、海报、成片做出第一件，就归到这里。</text>
          <view class="pe-go" bindtap="goExecution"><text>去今日的锦囊段开工</text><native-icon name="arrow" tone="green" size="14"></native-icon></view>
        </view>
      </block>

      </block>
    </view>
  </scroll-view>
  <login-sheet open="{{showLogin}}" reason="purchase" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
</view>
