<view class="native-page {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view wx:if="{{isMock}}" class="native-mock-badge" bindtap="switchMockProfile"><text>MOCK · {{mockProfileLabel}}</text></view>
  <scroll-view scroll-y enhanced show-scrollbar="false" class="native-scroll">
    <view class="native-nav-inset"></view>
    <view class="pad pouch">
      <tab-header title="锦囊" kicker="军师替你出的妙计" glyph="计"></tab-header>

      <!-- ① 最近做的：跨来源混排（方案/海报/成片），按时间倒序最多 10 张。整卡即复出动词。 -->
      <block wx:if="{{recent.length}}">
        <text class="section-label">最 近 做 的</text>
        <scroll-view scroll-x enhanced show-scrollbar="false" class="pch-flow"><view class="pch-track">
          <view wx:for="{{recent}}" wx:key="key" class="pch-work card" data-index="{{index}}" bindtap="openWork">
            <text class="pch-w-tag {{item.typeClass}}">{{item.typeLabel}}</text>
            <text class="pch-w-t">{{item.title}}</text>
            <text class="pch-w-from">出自 · {{item.from}}</text>
            <view class="pch-w-verb"><text>{{item.verb}}</text><native-icon name="arrow" tone="accent" color-key="{{colorKey}}" size="12"></native-icon></view>
          </view>
        </view></scroll-view>
      </block>
      <!-- 空态（游客或全无作品）：不催登录，只把人指回战局领军令。 -->
      <view wx:else class="pouch-empty card">
        <text class="pe-t serif">还没有作品</text>
        <text class="pe-d">去战局领今日军令，能代笔的军师会给你配兵器。方案、海报、成片做出第二次，就归到这里。</text>
        <view class="pe-go" bindtap="goBattle"><text>去战局领今日军令</text><native-icon name="arrow" tone="green" size="14"></native-icon></view>
      </view>

      <!-- ② 手艺：一门手艺一格。固定子应用三格 + 创意 agents 动态格（上新自动多一格）。 -->
      <text class="section-label">手 艺</text>
      <view class="agrid pch-grid">
        <view wx:for="{{crafts}}" wx:key="key" class="acard card pch-craft {{item.locked?'pch-off':''}}" data-index="{{index}}" bindtap="openCraft">
          <view class="ai pch-ic {{item.iconClass}}"><text class="pch-glyph serif">{{item.glyph}}</text></view>
          <text class="ah">{{item.name}}</text>
          <text class="ap">{{item.roleLine}}</text>
          <text class="ameta pch-meta">{{item.metaLine}}</text>
        </view>
      </view>

      <view class="tabbar-space"></view>
    </view>
  </scroll-view>
  <login-sheet open="{{showLogin}}" reason="save" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
  <coach-marks></coach-marks>
</view>
