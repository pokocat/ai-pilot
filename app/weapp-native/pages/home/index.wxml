<view class="native-page {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view wx:if="{{isMock}}" class="native-mock-badge" bindtap="switchMockProfile"><text>MOCK · {{mockProfileLabel}}</text></view>
  <scroll-view scroll-y enhanced show-scrollbar="false" class="native-scroll">
    <view class="native-nav-inset"></view>
    <view class="pad home execution">
      <tab-header title="战局" kicker="看判断 · 做今日的事" glyph="势"></tab-header>
      <view class="say-strip"><text class="say-k">今日献策 · {{sayingDate}}</text><text class="say-line serif">{{saying}}</text></view>

      <block wx:if="{{!authed}}">
        <view class="battle-empty"><text class="battle-empty-title serif">还没有战局判断</text><text class="battle-empty-desc">先和军师说说眼下最难拿主意的事，第一份判断会写在这里。</text><button bindtap="ask">去问策</button></view>
      </block>
      <block wx:else>
        <view wx:if="{{loadFailed}}" class="pch-retry card" bindtap="retry">
          <text class="pch-retry-t">判断没读出来，网络不畅或服务端在忙</text>
          <text class="pch-retry-go">重试</text>
        </view>
        <view wx:if="{{onboardingKnown&&!onboarded}}" class="guest-notice card">
          <view class="guest-notice-icon"><native-icon name="user" tone="accent" color-key="{{colorKey}}" size="17"></native-icon></view>
          <view class="guest-notice-body"><text class="guest-notice-title serif">你的战局还没有建档</text><text class="guest-notice-desc">建档是自愿的；完成三问后，军师会把第一份判断写到这里。</text></view>
          <view class="guest-notice-action" bindtap="goOnboarding"><text>开始建档</text></view>
        </view>

        <!-- ① 判断区收成一张牌：主要矛盾 + 案卷来源 + 两个动作。证据链/待补/KPI 收进「判断依据」抽屉。 -->
        <view class="battle-hero" bindtap="toggleHero"><text class="bh-kicker">军 师 判 断 · 主 要 矛 盾</text><text class="bh-title serif {{heroExpanded?'expanded':''}}">{{summary}}</text><text class="bh-source">{{dossierTitle ? '当前案卷 · '+dossierTitle+' · 随变而调' : '还没有案卷 · 和军师聊一次，方案定了就成卷'}}</text><view class="bh-foot"><view class="bh-ask solid" catchtap="ask"><text>问军师</text></view><view class="bh-ask" catchtap="openEvidence"><text>判断依据{{cited.length?' · 已引 '+cited.length+' 类':''}}</text></view></view></view>

        <!-- ② 三势压成一行：只给结论和强度，点开是三势合参抽屉。 -->
        <view wx:if="{{forces.length}}" class="force-grid bf-compact" bindtap="openForces"><view wx:for="{{forces}}" wx:key="kind" class="force card"><text class="force-tag">{{item.name}} · {{item.levelLabel}}</text><text class="force-concl serif">{{item.conclusion}}</text><view class="force-bar"><view class="force-fill {{item.kind}}" style="width:{{item.strength}}%"></view></view></view></view>
        <view wx:elif="{{!loading}}" class="force-empty card" bindtap="ask"><text class="fe-t serif">三势还没断</text><text class="fe-d">跟我聊透目标、现状和卡点，天势、市势、人势自然就清楚了。</text><view class="fe-go"><text>去对话</text><native-icon name="arrow" tone="green" size="14"></native-icon></view></view>

        <view wx:if="{{risks.length}}" class="nono-card card"><text class="section-label danger">现 在 不 能 做</text><view wx:for="{{risks}}" wx:key="*this" class="nono-row"><native-icon name="alert" tone="neutral" size="15"></native-icon><text class="nono">{{item}}</text></view><text class="nono-src">来自你定下的《{{dossierTitle}}》</text></view>

        <!-- ③ 军令区：兵器挂在军令上——AI 应用的主分发位。 -->
        <view class="ohead"><text class="ohead-t serif">{{segment===0?'今日军令':'本周'}}</text><text class="ohead-m {{committing?'busy':''}}" bindtap="commitBattle">{{committing?'排兵布阵中…':(orders.length?('完成 '+orderDone+' / '+orders.length+' · 让军师重排'):'让军师来拆')}}</text></view>
        <view class="exec-seg"><view wx:for="{{segments}}" wx:key="*this" class="seg-item {{segment===index?'on':''}}" data-index="{{index}}" bindtap="selectSegment">{{item}}</view></view>

        <block wx:if="{{segment===0}}">
        <view wx:if="{{!orders.length && !loading}}" class="orders-empty card" bindtap="makeCommand"><text class="oe-t serif">还没有军令</text><text class="oe-d">先让总军师把当前判断拆成可执行动作。</text><view class="oe-go"><text>去对话</text><native-icon name="arrow" tone="accent" color-key="{{colorKey}}" size="14"></native-icon></view></view>
        <view wx:for="{{displayOrders}}" wx:key="id" class="task card {{item.done?'done':''}}" data-id="{{item.id}}" data-text="{{item.text}}" bindtap="openOrder" bindlongpress="removeOrder">
          <view class="task-b">
            <text class="task-t serif {{item.done?'struck':''}}">{{item.text}}</text>
            <text class="task-meta-info">{{item.done?(item.resultNote?'回填：'+item.resultNote:'已办 · 长按删除'):('来自 '+(item.from||'案卷')+' · 优先级 '+item.no)}}</text>
            <view wx:if="{{item.weapon}}" class="task-weapon" data-id="{{item.weapon.id}}" catchtap="openPrescription"><native-icon name="bolt" tone="accent" color-key="{{colorKey}}" size="13"></native-icon><text class="tw-line">军师配了兵器 · <text class="tw-b">{{item.weapon.playbook}}</text></text><view class="tw-go"><text>带我做</text><native-icon name="arrow" tone="accent" color-key="{{colorKey}}" size="12"></native-icon></view></view>
            <view wx:if="{{fillingOrderId===item.id}}" class="task-fill" catchtap="stop"><text class="tf-k">数 据 回 填 · 做完了多少？</text><view class="tf-row"><input class="tf-input native-result-input" value="{{fillingOrderText}}" maxlength="200" placeholder="如：发 8 条 / 见 3 个客户 / 回款 2 万" bindinput="inputOrderResult" bindconfirm="saveOrderResult"/><view class="tf-btn {{savingOrderResult?'busy':''}}" bindtap="saveOrderResult"><text>{{savingOrderResult?'保存中…':'回填'}}</text></view></view></view>
          </view>
          <view class="task-check" data-id="{{item.id}}" catchtap="toggleOrder"><native-icon wx:if="{{item.done}}" name="check" tone="white" size="15"></native-icon></view>
        </view>
        <view wx:for="{{leftoverWeapons}}" wx:key="id" class="rx-item card" data-id="{{item.id}}" bindtap="openPrescription"><view class="rx-main"><text class="rx-for">为「{{item.problem}}」</text><text class="rx-play">{{item.playbook}}</text></view><view class="rx-cta"><native-icon name="bolt" tone="accent" color-key="{{colorKey}}" size="13"></native-icon><text>军师配了兵器</text><native-icon name="arrow" tone="accent" color-key="{{colorKey}}" size="12"></native-icon></view></view>
        <!-- 手动加令走 showModal 输入：这条 input 原本嵌在长滚动页里，点一下键盘顶起页面、
             焦点跟着滚走（用户反馈「页面跳走了」）。弹层输入两端行为一致，也少一个输入态。 -->
        <view wx:if="{{orders.length}}" class="order-add-row" bindtap="addOrderByModal"><native-icon name="plus" tone="accent" color-key="{{colorKey}}" size="15"></native-icon><text>手动加一条今天的军令</text></view>
        </block>

        <!-- 周计划 = 打卡机制：七日连续条在上（断没断一眼看见），按天记录在下。 -->
        <block wx:else>
          <view class="week-card card">
            <view class="wk-head"><text class="wk-k">连 续 七 日</text><text class="wk-sum">{{streak?('连续复盘 '+streak+' 天 · '):''}}本周完成 {{weekDone}} / {{weekTotal}}</text></view>
            <view class="wk-strip">
              <view wx:for="{{weekStrip}}" wx:key="date" class="wk-cell {{item.isToday?'today':''}}">
                <text class="wk-wd">{{item.weekday}}</text>
                <view class="wk-dot wk-{{item.state}}"></view>
                <text class="wk-num">{{item.dayNum}}</text>
              </view>
            </view>
            <text class="wk-note">实心=当天军令全办完，半实=办了一部分，空心=有令未动，虚线=当天没出令。</text>
          </view>
          <view wx:if="{{weekGroups.length}}" class="week-list card">
            <view wx:for="{{weekGroups}}" wx:key="date" class="week-group">
              <view class="wg-head"><text class="wg-date serif">{{item.label}}</text><text class="wg-done">{{item.doneText}}</text></view>
              <view wx:for="{{item.orders}}" wx:for-item="order" wx:key="id" class="wg-row"><view class="wg-state {{order.done?'ok':''}}"><native-icon wx:if="{{order.done}}" name="check" tone="accent" color-key="{{colorKey}}" size="14"></native-icon></view><text class="wg-text {{order.done?'done':''}}">{{order.text}}</text></view>
            </view>
          </view>
          <view wx:else class="orders-empty card" bindtap="makeCommand"><text class="oe-t serif">近七天还没有军令记录</text><text class="oe-d">连续打卡从第一条军令开始——让军师把判断拆成今天能做的事。</text><view class="oe-go"><text>去对话</text><native-icon name="arrow" tone="accent" color-key="{{colorKey}}" size="14"></native-icon></view></view>
        </block>

        <!-- ④ 回填与复盘只出现一次：做完、填数、复盘，次序即页面次序。 -->
        <view wx:if="{{segment===0}}" class="data-fill"><view class="df-head"><text class="df-t serif">今日数据回填</text><text class="df-s {{backfill?'ok':''}}">{{backfill?'今日已回填':'线索 / 咨询 / 成交'}}</text></view><view class="df-row"><view class="df-cell"><text class="df-label">线索</text><input class="df-input" type="number" value="{{backfill.leads||''}}" data-field="leads" bindinput="inputBackfill" /></view><view class="df-cell"><text class="df-label">咨询</text><input class="df-input" type="number" value="{{backfill.consults||''}}" data-field="consults" bindinput="inputBackfill" /></view><view class="df-cell"><text class="df-label">成交</text><input class="df-input" type="number" value="{{backfill.deals||''}}" data-field="deals" bindinput="inputBackfill" /></view></view><view class="df-save" bindtap="saveBackfill">{{savingBackfill?'保存中…':'保存今日数据'}}</view></view>

        <view class="review-entry card" bindtap="openReview"><view class="re-b"><text class="re-t serif">{{streak?('今晚复盘 · 连续 '+streak+' 天'):'今晚复盘'}}</text><text class="re-s">军令 + 数据都在，复盘决定明日军令</text></view><native-icon name="arrow" tone="green" size="16"></native-icon></view>
      </block>
      <view class="tabbar-space"></view>
    </view>
  </scroll-view>
  <view class="native-bottom-fade"></view>

  <!-- 三势合参抽屉（原样保留，刷新判断收进抽屉） -->
  <view wx:if="{{forcesOpen}}" class="force-sheet-mask" bindtap="closeForces" catchtouchmove="stop">
    <view class="force-sheet fs-pad" catchtap="stop">
      <view class="force-sheet-grip"></view>
      <text class="fs-kicker">三 势 合 参</text>
      <text class="fs-title serif">三势全解：先拆三势，再做合参</text>
      <text class="fs-quote">三势不是三个孤立的数。天势看能不能借风，市势看怎么打出差异，人势看能不能放大。</text>
      <scroll-view scroll-y class="fs-body">
        <view class="forces-breakdown"><view wx:for="{{forceDetails}}" wx:key="kind" class="force-read {{item.kind}}"><text class="fr-label">{{item.label}}</text><text class="fr-title serif">{{item.title}}</text><text class="fr-body">{{item.body}}</text><text class="fr-tactic {{item.tacticTone}}">{{item.tactic}}</text><view wx:if="{{item.kind==='sky'&&fortuneOn}}" class="fr-chart"><text wx:if="{{chart}}" class="frc-line">{{chart.monthLine}} · 全年拐点月 {{chart.turning}}</text><text wx:else class="frc-empty" bindtap="openCalendar">生辰未录 · 录入后天势可参命盘</text></view></view></view>
        <view wx:if="{{forceSynthesis}}" class="force-synthesis"><text class="fsy-title serif">{{forceSynthesis.title}}</text><text class="fsy-body">{{forceSynthesis.body}}</text></view>
      </scroll-view>
      <view class="sheet-foot"><text class="sheet-side" bindtap="refreshForces">{{refreshing?'刷新中…':'刷新判断'}}</text><view class="fs-close" bindtap="closeForces"><text>收起</text></view></view>
    </view>
  </view>

  <!-- 判断依据抽屉：证据链 / 待补问题 / 案卷信号 / 经营数据，不再平铺主页面 -->
  <view wx:if="{{evidenceOpen}}" class="force-sheet-mask" bindtap="closeEvidence" catchtouchmove="stop">
    <view class="force-sheet fs-pad" catchtap="stop">
      <view class="force-sheet-grip"></view>
      <text class="fs-kicker">判 断 依 据</text>
      <text class="fs-title serif">这份判断是怎么来的</text>
      <scroll-view scroll-y class="fs-body">
        <view class="metric-grid sheet-metrics"><view wx:for="{{metrics}}" wx:key="label" class="metric card" data-index="{{index}}" bindtap="tapMetric"><text class="metric-v serif {{item.tone}}">{{item.value}}</text><text class="metric-l">{{item.label}}</text></view></view>
        <view wx:if="{{cited.length}}" class="ev-group"><text class="ev-gl">已引用证据</text><view class="ev-chips"><view wx:for="{{cited}}" wx:key="label" class="ev-chip" data-index="{{index}}" bindtap="tapEvidence"><text>{{item.label}} {{item.count}}</text></view></view></view>
        <view wx:if="{{questions.length}}" class="ev-group"><text class="ev-gl">当前最该补</text><view wx:for="{{questions}}" wx:key="*this" class="linkmod" data-text="{{item}}" bindtap="askQuestion"><text class="linkmod-name serif">{{item}}</text><text class="linkmod-mini">去补</text></view></view>
        <view wx:if="{{kpi}}" class="ev-group"><text class="ev-gl">经营数据 · 近 {{kpi.days}} 天回填</text><view class="kpi-row"><view wx:for="{{kpi.rows}}" wx:key="label" class="kpi-cell"><text class="kpi-v serif">{{item.value}}</text><text class="kpi-l">{{item.label}}</text></view></view></view>
        <view wx:if="{{!cited.length&&!questions.length&&!kpi}}" class="ev-group"><text class="ev-gl">还没有可引用的依据 · 和军师多聊、多回填，判断会越来越有根</text></view>
      </scroll-view>
      <view class="sheet-foot"><view class="fs-close" bindtap="closeEvidence"><text>收起</text></view></view>
    </view>
  </view>

  <!-- 复盘抽屉：三势检查 / 决策验证 / 本周经营数据 / 目标对照，最后进入复盘对话 -->
  <view wx:if="{{reviewOpen}}" class="force-sheet-mask" bindtap="closeReview" catchtouchmove="stop">
    <view class="force-sheet fs-pad" catchtap="stop">
      <view class="force-sheet-grip"></view>
      <text class="fs-kicker">今 日 复 盘</text>
      <text class="fs-title serif">军令和数据都在，先自检再复盘</text>
      <scroll-view scroll-y class="fs-body">
        <view wx:if="{{battleForces.length}}" class="force-check card"><view class="fc-head"><text class="fc-k">三势检查</text><text class="fc-t">今天的动作是否还在主线上？</text></view><view wx:for="{{battleForces}}" wx:key="kind" class="fc-row"><view class="fc-b"><text class="fc-l">{{item.label}} · {{item.conclusion}}</text><text class="fc-d">打法：{{item.tactic}}</text></view><view class="fc-ops"><view class="fc-op {{item.verdict==='on'?'on':''}}" data-kind="{{item.kind}}" data-verdict="on" bindtap="chooseForce">符合</view><view class="fc-op {{item.verdict==='off'?'off':''}}" data-kind="{{item.kind}}" data-verdict="off" bindtap="chooseForce">偏了</view></view></view><text class="fc-note">选过的势会写进复盘开场；没选的军师不替你表态。</text></view>
        <view wx:if="{{pendingDecision}}" class="decision-verify card"><view class="dv-head"><text class="dv-k">决策验证 · 待验证</text><text class="dv-seq">决策 #{{pendingDecision.seq}}</text></view><text class="dv-t">{{pendingDecision.decision}}</text><text wx:if="{{pendingDecision.verifyStandard}}" class="dv-d">验证标准：{{pendingDecision.verifyStandard}}</text><view class="dv-ops"><view class="dv-op main {{verifying?'busy':''}}" data-outcome="correct" bindtap="verifyDecision">判断正确</view><view class="dv-op {{verifying?'busy':''}}" data-outcome="revise" bindtap="verifyDecision">需修正</view></view><view class="dv-more" bindtap="openLedger"><text>看完整战略账本</text><native-icon name="arrow" tone="neutral" size="13"></native-icon></view></view>
        <view wx:if="{{bizItems.length}}" class="data-fill biz-fill"><view class="df-head"><text class="df-t serif">本周经营数据</text><text wx:if="{{bizSaved && !bizEditing}}" class="bm-edit" bindtap="startBizEdit">改</text><text wx:else class="df-s {{bizSaved?'ok':''}}">{{bizItems.length}} 项</text></view><view wx:if="{{bizSaved && !bizEditing}}" class="bm-row"><view wx:for="{{bizItems}}" wx:key="key" class="bm-cell ro"><text class="df-label">{{item.name}}</text><text class="bm-val">{{item.value||'—'}}<text class="bm-unit">{{item.unit}}</text></text></view></view><block wx:else><view class="bm-row"><view wx:for="{{bizItems}}" wx:key="key" class="bm-cell"><text class="df-label">{{item.name}}（{{item.unit}}）</text><input class="df-input" type="digit" value="{{item.value}}" placeholder="__" data-key="{{item.key}}" bindinput="inputBiz" /></view></view><view class="df-save" bindtap="saveBiz">{{savingBiz?'保存中…':'保存本周数据'}}</view></block></view>
        <view class="goal-head"><text class="goal-head-t serif">目标对照</text><text class="goal-head-more" bindtap="makeGoalPlan">让军师拆解</text></view><view class="goal-ladder"><view wx:for="{{goalRows}}" wx:key="field" class="gl-cell card" data-field="{{item.field}}" bindtap="openGoalEdit"><text class="gl-k">{{item.label}}</text><text class="gl-v {{item.empty?'empty':''}}">{{item.value||'补目标'}}</text></view></view>
        <view class="remind-row sheet-remind" bindtap="openReminders"><text class="remind-time">{{reminders.length?reminders[0].time:'提醒'}}</text><text class="remind-text">{{reminders.length?(reminders[0].title||'复盘提醒'):'设置复盘提醒节奏'}}</text><native-icon name="arrow" tone="neutral" size="13"></native-icon></view>
        <view class="rc-btn" bindtap="reviewToday"><native-icon name="doc" tone="white" size="15"></native-icon><text>开始复盘</text></view>
        <view class="rc-btn ghost" bindtap="openDaily"><native-icon name="doc" tone="accent" color-key="{{colorKey}}" size="15"></native-icon><text>查看每日战报</text></view>
      </scroll-view>
      <view class="sheet-foot"><view class="fs-close" bindtap="closeReview"><text>收起</text></view></view>
    </view>
  </view>

  <view wx:if="{{goalEdit}}" class="goal-editor"><view class="ge-head"><view class="ge-copy"><text class="gs-title serif">{{goalEdit.label}}目标</text><text class="gs-hint">一句话目标 + 关键指标，复盘时按这条对照。</text></view><text class="ge-close" bindtap="closeGoalEdit">取消</text></view><input class="gs-input native-goal-input" value="{{goalDraft}}" maxlength="200" placeholder="如：营收翻倍，复购率 30%" focus="true" always-embed="true" adjust-position="true" cursor-spacing="20" bindinput="inputGoal" bindconfirm="saveGoal"/><view class="ge-save {{savingGoal?'busy':''}}" bindtap="saveGoal"><text>{{savingGoal?'保存中…':'保存目标'}}</text></view></view>

  <login-sheet open="{{showLogin}}" reason="execute" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
  <coach-marks></coach-marks>
</view>
