<view class="native-page {{themeClass}}" style="--native-nav-inset:{{navInset}}px;--native-nav-top:{{navTop}}px;--native-nav-row-height:{{navRowHeight}}px;--native-nav-right:{{navRightInset}}px">
  <view wx:if="{{isMock}}" class="native-mock-badge"><text>MOCK · 本地数据</text></view>
  <scroll-view scroll-y enhanced show-scrollbar="false" class="native-scroll"><view class="native-nav-inset"></view><view class="pad execution">
    <tab-header title="军令" kicker="做今天的事" glyph="令"></tab-header>

    <view wx:if="{{prescriptions.length}}" class="rx-strip">
      <view wx:for="{{prescriptions}}" wx:key="id" class="rx-item" data-id="{{item.id}}" bindtap="openPrescription">
        <view class="rx-main"><text class="rx-for">为「{{item.problem}}」</text><text class="rx-play">{{item.playbook}}</text></view>
        <view class="rx-cta"><native-icon name="bolt" tone="accent" color-key="{{colorKey}}" size="13"></native-icon><text>军师配了工具</text><native-icon name="arrow" tone="accent" color-key="{{colorKey}}" size="12"></native-icon></view>
      </view>
    </view>

    <scroll-view scroll-x enhanced show-scrollbar="false" class="exec-deck"><view class="exec-track">
      <view class="deck-card battle-card"><text class="deck-k">今日战役 · {{dateText}}</text><text class="deck-title serif">{{dossierTitle||'围绕主要矛盾，今天只推进最关键的一步'}}</text><text class="deck-desc">{{hasDossier?'源自已定方案 · 由'+dossierSource+'给出 · 打卡记录，复盘决定明日军令。':'先把案卷补齐，再让军师拆出今天的主令。'}}</text><view class="deck-progress"><view class="deck-fill" style="width:{{orderPercent}}%"></view></view><text class="deck-foot">{{orders.length?'完成度 '+orderPercent+'% · 今晚复盘':'军令还没出 · 今晚复盘'}}</text></view>
      <view class="xiance-card"><text class="xiance-k">军 师 献 策</text><view class="xiance-steps"><view wx:for="{{deckOrders}}" wx:key="id" class="xiance-step"><text class="xiance-no">{{index+1}}</text><text class="xiance-text">{{item.text}}</text></view><view wx:if="{{!orders.length}}" class="xiance-step"><text class="xiance-no">1</text><text class="xiance-text">先形成一条今日可验证的军令</text></view></view><text class="xiance-source">来自当前案卷与军师判断</text></view>
      <view class="deck-card"><text class="deck-k green">今日主令</text><text class="deck-title serif">{{mainOrderTitle}}</text><text class="deck-desc">{{mainOrderDesc}}</text><view class="deck-btn" bindtap="deckAction">{{mainOrderButton}}</view></view>
      <view class="deck-card" bindtap="openReminders"><text class="deck-k green">提醒节奏</text><text class="deck-title serif">{{reminders.length?(reminders[0].time+' '+(reminders[0].title||'复盘')):'今晚复盘'}}</text><text class="deck-desc">回填线索、咨询、成交，必要时刷新明日军令。</text><text class="deck-foot muted">{{streak?'连续复盘 '+streak+' 天 · 别断':'点开管理提醒'}}</text></view>
    </view></scroll-view>

    <view class="exec-stats"><view class="exec-stat card"><text class="stat-n serif">{{orders.length?pendingOrders.length:'—'}}</text><text class="stat-l">待执行军令</text></view><view class="exec-stat card" bindtap="openLedger"><text class="stat-n warn serif">{{pendingDecisions}}</text><text class="stat-l">待验证判断</text></view><view class="exec-stat card" bindtap="openReminders"><text class="stat-n serif">{{streak}}</text><text class="stat-l">连续复盘</text></view></view>
    <view class="advisor-card card" bindtap="ask"><view class="ac-b"><text class="ac-t serif">总军师督战</text><text class="ac-d">军令卡住了，带着现场情况回来问</text></view><view class="ac-go"><text>去对话</text><native-icon name="arrow" tone="green" size="14"></native-icon></view></view>
    <view class="today-focus" bindtap="focusAction"><view class="tf-b"><text class="tf-t serif">今日最重要</text><text class="tf-d">{{pendingOrders.length?pendingOrders[0].text:(orders.length?'今日军令已归档，准备复盘':'先定下一条能被结果验证的军令')}}</text></view><text class="tf-em">{{pendingOrders.length?'优先级 1':(orders.length?'去复盘':'现在做')}}</text></view>

    <view class="goal-head"><text class="goal-head-t serif">目标阶梯</text><text class="goal-head-more" bindtap="makeGoalPlan">让军师拆解</text></view><view class="goal-ladder"><view wx:for="{{goalRows}}" wx:key="field" class="gl-cell card" data-field="{{item.field}}" bindtap="openGoalEdit"><text class="gl-k">{{item.label}}</text><text class="gl-v {{item.empty?'empty':''}}">{{item.value||'补目标'}}</text></view></view>
    <view wx:if="{{goalEdit}}" class="goal-editor"><view class="ge-head"><view class="ge-copy"><text class="gs-title serif">{{goalEdit.label}}目标</text><text class="gs-hint">一句话目标 + 关键指标，复盘时按这条对照。</text></view><text class="ge-close" bindtap="closeGoalEdit">取消</text></view><input class="gs-input native-goal-input" value="{{goalDraft}}" maxlength="200" placeholder="如：营收翻倍，复购率 30%" focus="true" always-embed="true" adjust-position="true" cursor-spacing="20" bindinput="inputGoal" bindconfirm="saveGoal"/><view class="ge-save {{savingGoal?'busy':''}}" bindtap="saveGoal"><text>{{savingGoal?'保存中…':'保存目标'}}</text></view></view>

    <view class="exec-seg"><view wx:for="{{segments}}" wx:key="*this" class="seg-item {{segment===index?'on':''}}" data-index="{{index}}" bindtap="selectSegment">{{item}}</view></view>

    <block wx:if="{{segment===0}}">
      <view wx:if="{{!orders.length}}" class="orders-empty card" bindtap="makeCommand"><text class="oe-t serif">还没有军令</text><text class="oe-d">先让总军师把当前判断拆成可执行动作。</text><view class="oe-go"><text>去对话</text><native-icon name="arrow" tone="accent" color-key="{{colorKey}}" size="14"></native-icon></view></view>
      <view wx:for="{{visibleOrders}}" wx:key="id" class="task card {{item.done?'done':''}}" data-id="{{item.id}}" data-text="{{item.text}}" bindtap="openOrder" bindlongpress="removeOrder"><view class="task-b"><view class="task-meta-row"><text class="task-pill">{{item.tag||'今日军令'}}</text><text wx:if="{{item.done}}" class="task-stamp">已办</text></view><text class="task-t serif {{item.done?'struck':''}}">{{item.text}}</text><text class="task-meta-info">{{item.from||'军师'}} · {{item.dueAt||'今日'}}</text><view class="task-meta-row"><text class="task-pill sub">来自 {{item.from||'军师'}}</text><text class="task-pill sub">长按删除</text></view><view wx:if="{{fillingOrderId===item.id}}" class="task-fill" catchtap="stop"><text class="tf-k">数 据 回 填 · 做完了多少？</text><view class="tf-row"><input class="tf-input native-result-input" value="{{fillingOrderText}}" maxlength="200" placeholder="如：发 8 条 / 见 3 个客户 / 回款 2 万" bindinput="inputOrderResult" bindconfirm="saveOrderResult"/><view class="tf-btn {{savingOrderResult?'busy':''}}" bindtap="saveOrderResult"><text>{{savingOrderResult?'保存中…':'回填'}}</text></view></view></view></view><view class="task-check" data-id="{{item.id}}" catchtap="toggleOrder"><native-icon wx:if="{{item.done}}" name="check" tone="white" size="15"></native-icon></view></view>
      <view wx:if="{{archivedOrders.length}}" class="done-archive card"><view class="da-head" bindtap="toggleDoneArchive"><view class="da-b"><text class="da-k">已归档</text><text class="da-t serif">{{archivedOrders.length}} 条完成项已收起</text><text class="da-d">复盘、周计划与战报皆据此追溯。</text></view><text class="da-action">{{showDoneArchive?'收起':'查看'}}</text></view><view wx:if="{{showDoneArchive}}" class="da-list"><view wx:for="{{archivedOrders}}" wx:key="id" class="archived-task" data-id="{{item.id}}" data-text="{{item.text}}" bindtap="openOrder" bindlongpress="removeOrder"><view class="task-b"><view class="task-meta-row"><text class="task-pill sub">来自 {{item.from||'军师'}}</text><text class="task-pill sub">{{item.resultNote?'回填 '+item.resultNote:'长按删除'}}</text></view><text class="archive-task-text serif">{{item.text}}</text></view><view class="archive-check" data-id="{{item.id}}" catchtap="toggleOrder"><native-icon name="check" tone="white" size="13"></native-icon></view></view></view></view>
      <view class="order-add"><input class="oa-input" placeholder="手动加一条今天的军令" bindinput="inputOrder" /><view class="oa-btn" bindtap="addInlineOrder">加入</view></view>
      <view class="data-fill"><view class="df-head"><text class="df-t serif">线索 / 咨询 / 成交</text><text class="df-s {{backfill?'ok':''}}">{{backfill?'今日已回填':'今天的数据'}}</text></view><view class="df-row"><view class="df-cell"><text class="df-label">线索</text><input class="df-input" type="number" value="{{backfill.leads||''}}" data-field="leads" bindinput="inputBackfill" /></view><view class="df-cell"><text class="df-label">咨询</text><input class="df-input" type="number" value="{{backfill.consults||''}}" data-field="consults" bindinput="inputBackfill" /></view><view class="df-cell"><text class="df-label">成交</text><input class="df-input" type="number" value="{{backfill.deals||''}}" data-field="deals" bindinput="inputBackfill" /></view></view><view class="df-save" bindtap="saveBackfill">{{savingBackfill?'保存中…':'保存今日数据'}}</view></view>
      <view class="review-before card"><text class="rb-k">复 盘 前 检 查</text><view class="rb-line"><text class="rb-state {{orders.length&&orderDone<orders.length?'warn':''}}">{{orderProgressText}}</text><text class="rb-text">今日军令完成情况</text></view><view class="rb-line"><text class="rb-state {{backfill?'':'warn'}}">{{backfill?'已回填':'待补'}}</text><text class="rb-text">经营数据</text></view></view>
    </block>
    <block wx:elif="{{segment===1}}"><view class="week-list card"><view wx:for="{{weekGroups}}" wx:key="date" class="week-group"><text class="wg-date serif">{{item.label}}</text><view wx:for="{{item.orders}}" wx:for-item="order" wx:key="id" class="wg-row"><view class="wg-state {{order.done?'ok':''}}"><native-icon wx:if="{{order.done}}" name="check" tone="accent" color-key="{{colorKey}}" size="14"></native-icon></view><text class="wg-text {{order.done?'done':''}}">{{order.text}}</text></view></view><view wx:if="{{!weekGroups.length}}" class="week-group"><text class="wg-date">近 7 天</text><text class="wg-text">还没有军令记录。</text></view></view></block>
    <block wx:else>
      <view wx:if="{{battleForces.length}}" class="force-check card"><view class="fc-head"><text class="fc-k">三势检查 · 每日复盘</text><text class="fc-t">今天的动作是否还在主线上？</text></view><view wx:for="{{battleForces}}" wx:key="kind" class="fc-row"><view class="fc-b"><text class="fc-l">{{item.label}} · {{item.conclusion}}</text><text class="fc-d">打法：{{item.tactic}}</text></view><view class="fc-ops"><view class="fc-op {{item.verdict==='on'?'on':''}}" data-kind="{{item.kind}}" data-verdict="on" bindtap="chooseForce">符合</view><view class="fc-op {{item.verdict==='off'?'off':''}}" data-kind="{{item.kind}}" data-verdict="off" bindtap="chooseForce">偏了</view></view></view><text class="fc-note">选过的势会写进复盘开场；没选的军师不替你表态。</text></view>
      <view wx:if="{{pendingDecision}}" class="decision-verify card"><view class="dv-head"><text class="dv-k">决策验证 · 待验证</text><text class="dv-seq">决策 #{{pendingDecision.seq}}</text></view><text class="dv-t">{{pendingDecision.decision}}</text><text wx:if="{{pendingDecision.verifyStandard}}" class="dv-d">验证标准：{{pendingDecision.verifyStandard}}</text><view class="dv-ops"><view class="dv-op main {{verifying?'busy':''}}" data-outcome="correct" bindtap="verifyDecision">判断正确</view><view class="dv-op {{verifying?'busy':''}}" data-outcome="revise" bindtap="verifyDecision">需修正</view></view><view class="dv-more" bindtap="openLedger"><text>看完整战略账本</text><native-icon name="arrow" tone="neutral" size="13"></native-icon></view></view>
      <view wx:if="{{bizItems.length}}" class="data-fill biz-fill"><view class="df-head"><text class="df-t serif">本周经营数据</text><text wx:if="{{bizSaved && !bizEditing}}" class="bm-edit" bindtap="startBizEdit">改</text><text wx:else class="df-s {{bizSaved?'ok':''}}">{{bizItems.length}} 项</text></view><view wx:if="{{bizSaved && !bizEditing}}" class="bm-row"><view wx:for="{{bizItems}}" wx:key="key" class="bm-cell ro"><text class="df-label">{{item.name}}</text><text class="bm-val">{{item.value||'—'}}<text class="bm-unit">{{item.unit}}</text></text></view></view><block wx:else><view class="bm-row"><view wx:for="{{bizItems}}" wx:key="key" class="bm-cell"><text class="df-label">{{item.name}}（{{item.unit}}）</text><input class="df-input" type="digit" value="{{item.value}}" placeholder="__" data-key="{{item.key}}" bindinput="inputBiz" /></view></view><view class="df-save" bindtap="saveBiz">{{savingBiz?'保存中…':'保存本周数据'}}</view></block><text class="payoff">军师复盘时与行业基准对照，差值由系统计算</text></view>
      <view class="review-card card"><text class="rc-k">今日复盘</text><text class="rc-t">军师会带着真实军令和经营数据，复盘什么有效、什么要调整。</text><view class="rc-btn" bindtap="reviewToday"><native-icon name="doc" tone="white" size="15"></native-icon><text>开始复盘</text></view><view class="rc-btn ghost" bindtap="openDaily"><native-icon name="doc" tone="accent" color-key="{{colorKey}}" size="15"></native-icon><text>查看每日战报</text></view></view><view class="remind card"><view class="remind-head"><text class="remind-k serif">提醒节奏</text><view class="remind-soon" bindtap="openReminders"><text>管理</text><native-icon name="arrow" tone="green" size="13"></native-icon></view></view><view wx:for="{{reminders}}" wx:key="key" class="remind-row"><text class="remind-time">{{item.time}}</text><text class="remind-text">{{item.title||item.desc}}</text></view><view wx:if="{{!reminders.length}}" class="remind-row"><text class="remind-time">尚未设置</text><text class="remind-text">军令形成后再选择复盘节奏。</text></view></view>
    </block>

    <view class="sec-head"><text class="sec-title">军师代笔 · 内容出品</text><text class="sec-more">把军令变成内容资产</text></view>
    <view class="agrid">
      <view wx:for="{{creativeAgents}}" wx:key="key" class="acard card {{item.locked?'locked':''}}" data-key="{{item.key}}" bindtap="tapCreative">
        <text wx:if="{{item.badgeText}}" class="gift {{item.locked?'locked-badge':'owned'}}">{{item.badgeText}}</text>
        <view class="ai"><native-icon name="{{item.icon}}" tone="accent" color-key="{{colorKey}}" size="18"></native-icon></view>
        <text class="ah">{{item.name}}</text><text class="ap">{{item.role}}</text>
        <view wx:if="{{item.locked}}" class="ameta lock"><native-icon name="diamond" tone="accent" color-key="{{colorKey}}" size="12"></native-icon><text>{{item.costText}} 启用</text><native-icon name="arrow" tone="accent" color-key="{{colorKey}}" size="11"></native-icon></view>
        <view wx:elif="{{item.metered}}" class="ameta"><native-icon name="diamond" tone="accent" color-key="{{colorKey}}" size="12"></native-icon><text>{{item.costText}}/次 · {{item.deliverableKey}}</text></view>
        <text wx:elif="{{item.deliverableKey}}" class="ameta">擅长 · {{item.deliverableKey}}</text>
      </view>
    </view>
    <view class="works-row card" bindtap="openGallery"><view class="wr-ic"><native-icon name="image" tone="accent" color-key="{{colorKey}}" size="16"></native-icon></view><view class="wr-b"><text class="wr-t">我的作品库</text><text class="wr-s">出过的每一版海报都在这里回看、保存与分享</text></view><native-icon name="arrow" tone="neutral" size="15"></native-icon></view>
    <view class="tabbar-space"></view>
  </view></scroll-view>
  <login-sheet open="{{showLogin}}" reason="execute" bindclose="closeLogin" bindloggedin="loggedIn"></login-sheet>
  <agent-unlock agent="{{unlockAgent}}" source="studio" bindclose="closeUnlock" bindunlocked="agentUnlocked"></agent-unlock>
  <coach-marks></coach-marks>
</view>
