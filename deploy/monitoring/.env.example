# 军师监控栈环境变量（cp .env.example .env 后填写；.env 已 gitignore）

# Grafana 管理员密码（首登用户名 admin）
GRAFANA_ADMIN_PASSWORD=

# 经 Nginx 子路径暴露时（deploy/nginx.conf.example 的 /grafana/ 段）：
#   GRAFANA_ROOT_URL=https://你的域名/grafana/
#   GRAFANA_SUB_PATH=true
# 只在本机看（ssh -L 3000:127.0.0.1:3000）则保持默认。
GRAFANA_ROOT_URL=http://localhost:3000/
GRAFANA_SUB_PATH=false

# PG 只读监控账号（建法见 docs/MONITORING.md §3：junshi_ro，pg_monitor + 业务表 SELECT）
# postgres_exporter 用 DSN；Grafana 业务看板用密码（datasources.yml $__env 引用）。
PG_EXPORTER_DSN=postgresql://junshi_ro:改成密码@127.0.0.1:5432/junshi?sslmode=disable
GRAFANA_PG_PASSWORD=改成密码
