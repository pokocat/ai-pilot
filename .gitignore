# 依赖
node_modules/
**/node_modules/

# 构建产物
dist/
**/dist/
**/dist-native/
**/dist-h5/
**/dist-pc/
lib/
# 上面那条裸 `lib/` 是给构建产物的，但它按 gitignore 语义匹配**任意层级**的 lib 目录，
# 于是把 shadcn 约定的源码目录 admin/src/lib/（cn() 与 Radix 浮层挂载点）一起吞了：
# 2026-09-02 那次 `git add -A` 静默漏掉这两个源文件，本地磁盘上有所以构建全绿，
# 而 deploy-prod.sh 打的是 `git archive HEAD`，远端 admin 构建会因缺模块直接失败
# ——且它排在「服务端已重启」之后，留下半套上线。故显式放行这一处源码目录。
!admin/src/lib/
.temp/
.swc/
app/.taro-cache/

# 本地工具/评审产物
app/.impeccable/
*.tgz
*.zip
weapp-preview*.json
weapp-preview*.png
weapp-auto-preview*.json
weapp-auto-preview*.png
loadtest/results/
# 压测专用密钥与由它签发的 JWT（prepare.sh 生成，0600，用后即弃）。绝不入库。
loadtest/.env
loadtest/tokens.json

# IDE 云连接 / 技能下载 / 对话草稿
.cc-connect/
flova_skill_downloads/

# Claude Code 本地产物（worktree；settings.local.json 已由 *.local 覆盖；.claude/skills 仍入库）
.claude/worktrees/

# 微信开发者工具私有/误生成配置
/project.config.json
/project.private.config.json
app/project.private.config.json

# 根目录无依赖时 npm install 生成的空 lock
/package-lock.json

# 环境变量（含密钥，不入库；见各自 .env.example）
.env
server/.env
admin/.env
# 例外：server/.env.test 是测试库连接串（无真实密钥），纳入版本管理，保证 npm test 固定连 junshi_test。
!server/.env.test
# 本地 mock 微信支付服务器持久化的密钥（npm run pay:mock 生成，仅本机联调用）
server/.paymock/
*.local

# 日志
*.log
npm-debug.log*

# 测试覆盖率
coverage/

# 编辑器/系统
.DS_Store
.idea/
.vscode/
*.tsbuildinfo
.env
.preview/

# 密钥/凭证（如微信小程序上传私钥 private.*.key）——禁止入库
*.key

loadtest
ui-review/

# 快出片分包的 e2e 截图（本地验收产物，不入库）
app/dist-native-e2e-shots/

# 部署全量日志（本地留痕，远端只记 .deploy-history 一行结论）
.deploy-logs/

# 闸门 A 的测量夹具产物，由 scripts/gen-gate-a-media.mjs 重新生成
gate-a-media/
